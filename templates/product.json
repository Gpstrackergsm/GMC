{
  "sections": {
    "main-product": {
      "type": "main-product",
      "settings": {
        "gallery_layout": "thumbnail_slider",
        "media_position": "left",
        "thumbnail_position": "beside_main",
        "hide_variants": false,
        "enable_video_looping": false,
        "show_quantity_selector": true,
        "show_sku": true,
        "show_vendor": true,
        "show_share_buttons": true,
        "show_badges": true,
        "enable_sticky_info": true,
        "enable_image_zoom": true,
        "padding_top": 36,
        "padding_bottom": 12
      },
      "blocks": {
        "title": {
          "type": "title",
          "settings": {}
        },
        "badge": {
          "type": "badges",
          "settings": {
            "show_sale_badge": true,
            "show_sold_out_badge": true
          }
        },
        "rating": {
          "type": "rating",
          "settings": {}
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector",
          "settings": {}
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true
          }
        },
        "sku": {
          "type": "sku",
          "settings": {}
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share this product"
          }
        },
        "description": {
          "type": "description",
          "settings": {}
        },
        "collapsible-tab-1": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping & Returns",
            "icon": "truck",
            "content": "<p>We offer free standard shipping on all orders over $50. Orders are processed within 1–2 business days. Delivery takes 3–7 business days. Easy 30-day returns — no questions asked.</p>"
          }
        },
        "collapsible-tab-2": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Product Care",
            "icon": "leaf",
            "content": "<p>Please refer to the product label for specific care instructions. Store in a cool, dry place away from direct sunlight.</p>"
          }
        }
      },
      "block_order": [
        "title","badge","rating","price","variant_picker",
        "quantity_selector","buy_buttons","sku","share",
        "description","collapsible-tab-1","collapsible-tab-2"
      ]
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You May Also Like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "columns_mobile": 2,
        "enable_quick_add": true,
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": true,
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "recently-viewed": {
      "type": "recently-viewed",
      "settings": {
        "heading": "Recently Viewed",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "columns_mobile": 2,
        "enable_quick_add": false,
        "show_secondary_image": true,
        "show_vendor": false,
        "padding_top": 0,
        "padding_bottom": 48
      }
    }
  },
  "order": ["main-product","related-products","recently-viewed"]
}
