{%- comment -%}
  Snippet: product-card.liquid
  Accepts:
  - product        {Object}  Required.
  - image_ratio    {String}  'portrait' | 'square' | 'landscape'. Default: 'portrait'.
  - show_vendor    {Boolean} Default: false.
  - show_quick_add {Boolean} Default: true.
  - lazy           {Boolean} Default: true.
{%- endcomment -%}

{%- liquid
  assign image_ratio    = image_ratio    | default: 'portrait'
  assign show_vendor    = show_vendor    | default: false
  assign show_quick_add = show_quick_add | default: true
  assign lazy           = lazy           | default: true

  assign card_image = product.featured_image
  assign current_variant = product.selected_or_first_available_variant

  assign on_sale = false
  if current_variant.compare_at_price > current_variant.price
    assign on_sale = true
  endif

  assign sold_out = true
  if product.available
    assign sold_out = false
  endif

  case image_ratio
    when 'square'
      assign ratio_class = 'aspect-square'
    when 'landscape'
      assign ratio_class = 'aspect-landscape'
    else
      assign ratio_class = 'aspect-portrait'
  endcase
-%}

<article class="product-card{% if sold_out %} product-card--sold-out{% endif %}" data-product-id="{{ product.id }}">
  <div class="product-card__media-wrapper">
    <a
      href="{{ product.url }}"
      class="product-card__media-link"
      aria-label="{{ product.title | escape }}"
      tabindex="-1"
    >
      <div class="product-card__media {{ ratio_class }}">
        {%- if card_image -%}
          {%- assign card_alt = card_image.alt | default: product.title | escape -%}
          {%- render 'image-srcset',
            image: card_image,
            widths: '375,550,750,1000',
            sizes: '(min-width: 1200px) 300px, (min-width: 768px) 33vw, 50vw',
            class: 'product-card__image',
            alt: card_alt,
            lazy: lazy
          -%}
          {%- if product.images[1] != blank and product.images[1] != card_image -%}
            {%- assign hover_alt = product.images[1].alt | default: product.title | escape -%}
            {%- render 'image-srcset',
              image: product.images[1],
              widths: '375,550,750,1000',
              sizes: '(min-width: 1200px) 300px, (min-width: 768px) 33vw, 50vw',
              class: 'product-card__image product-card__image--hover',
              alt: hover_alt,
              lazy: true
            -%}
          {%- endif -%}
        {%- else -%}
          <div class="product-card__image-placeholder" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="48" height="48"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          </div>
        {%- endif -%}
      </div>
    </a>

    <div class="product-card__badges" aria-hidden="true">
      {%- if sold_out -%}
        <span class="badge badge-sold-out">Sold Out</span>
      {%- elsif product.tags contains 'new' or product.tags contains 'New' -%}
        <span class="badge badge-new">New</span>
      {%- endif -%}
    </div>

    {%- if show_quick_add and sold_out == false -%}
      <div class="product-card__quick-add">
        {%- if product.variants.size > 1 -%}
          <a href="{{ product.url }}" class="btn btn-primary product-card__quick-add-btn" aria-label="View options for {{ product.title | escape }}">View Options</a>
        {%- else -%}
          <form action="/cart/add" method="post" class="product-card__atc-form">
            <input type="hidden" name="id" value="{{ current_variant.id }}">
            <input type="hidden" name="quantity" value="1">
            {%- if product.price >= 30000 -%}
              <input type="hidden" name="selling_plan" value="692131725608">
            {%- endif -%}
            <button type="submit" name="add" class="btn btn-primary product-card__quick-add-btn" aria-label="Add {{ product.title | escape }} to cart" data-product-title="{{ product.title | escape }}">
              <span class="btn__text">{% if product.price >= 30000 %}Reserve 50% Deposit ({{ product.price | divided_by: 2 | money }}){% else %}Add to Cart{% endif %}</span>
              <span class="btn__loading" aria-hidden="true"><span class="spinner"></span></span>
            </button>
          </form>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="product-card__info">
    {%- if show_vendor and product.vendor != blank -%}
      {%- assign clean_card_vendor = product.vendor | replace: '&amp;amp;', '&' | replace: '&amp;', '&' -%}
      <p class="product-card__vendor">
        <a href="{{ clean_card_vendor | url_for_vendor }}" class="product-card__vendor-link">{{ clean_card_vendor }}</a>
      </p>
    {%- endif -%}

    {%- assign clean_card_title = product.title | replace: '&amp;amp;', '&' | replace: '&amp;', '&' | replace: '&quot;', '"' | replace: '&#39;', "'" -%}
    <h3 class="product-card__title">
      <a href="{{ product.url }}" class="product-card__title-link">{{ clean_card_title }}</a>
    </h3>

    <div class="product-card__price">
      {%- if product.price >= 30000 -%}
        <div style="display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap;">
          <span style="font-size: 1.25rem; font-weight: 900; color: #16a34a;">{{ product.price | divided_by: 2 | money }}</span>
          <span style="font-size: 0.72rem; font-weight: 800; color: #15803D; background: #DCFCE7; padding: 2px 6px; border-radius: 4px;">50% DEPOSIT</span>
        </div>
        <div style="font-size: 0.8rem; color: #64748B; margin-top: 2px;">
          Total: {{ product.price | money }}
        </div>
      {%- else -%}
        {%- render 'price', product: product -%}
      {%- endif -%}
      <div style="margin-top: 5px; font-size: 0.78rem; color: #166534; font-weight: 700; display: flex; align-items: center; gap: 4px;">
        <span>🚚 Free Residential Liftgate Delivery</span>
      </div>
    </div>
  </div>
</article>
