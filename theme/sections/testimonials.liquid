<section class="testimonials-section section-padding" style="padding: 64px 0; background-color: #ffffff;">
  <div class="container">
    <div class="section-header text-center" style="margin-bottom: 3rem; text-align: center;">
      <span style="display: inline-block; font-size: 0.85rem; font-weight: 700; color: var(--color-primary, #2D6A4F); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.5rem;">
        Verified Customer Feedback
      </span>
      <h2 class="section-heading" style="font-family: var(--font-heading-family, serif); font-size: clamp(2rem, 3.5vw, 2.75rem); color: var(--color-text, #1A1A1A); margin-bottom: 0.75rem;">
        {{ section.settings.heading | default: 'Trusted by Over 10,000+ Customers' }}
      </h2>
      <p class="section-subheading" style="color: #666; font-size: 1.05rem; max-width: 680px; margin: 0 auto; line-height: 1.6;">
        {{ section.settings.subheading | default: 'Real reviews from verified buyers across our 10 departments.' }}
      </p>
    </div>

    <div class="testimonials-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.75rem;">
      {%- for block in section.blocks -%}
        <div class="testimonial-card" {{ block.shopify_attributes }} style="background: #FAFAF7; border: 1px solid #E8E8E0; border-radius: 14px; padding: 1.75rem; display: flex; flex-direction: column; justify-content: space-between; transition: transform 0.25s, box-shadow 0.25s;">
          <div>
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem;">
              <div style="color: #D4A853; font-size: 1rem; letter-spacing: 2px;">
                ★★★★★
              </div>
              <span style="display: inline-flex; align-items: center; gap: 4px; font-size: 0.75rem; font-weight: 700; color: #2D6A4F; background: #E8F5EE; padding: 3px 8px; border-radius: 9999px;">
                <svg width="12" height="12" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                Verified Buyer
              </span>
            </div>
            <p style="font-size: 0.95rem; line-height: 1.6; color: #333; margin-bottom: 1.25rem; font-style: italic;">
              "{{ block.settings.quote }}"
            </p>
          </div>
          <div style="display: flex; align-items: center; gap: 12px; border-top: 1px solid #E8E8E0; padding-top: 1rem;">
            <div style="width: 40px; height: 40px; border-radius: 50%; background: #2D6A4F; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.9rem;">
              {{ block.settings.author | slice: 0, 1 }}
            </div>
            <div>
              <strong style="display: block; font-size: 0.9rem; color: #1A1A1A;">{{ block.settings.author }}</strong>
              <span style="font-size: 0.8rem; color: #777;">{{ block.settings.location }} • Purchased {{ block.settings.product_name }}</span>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .testimonial-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 24px rgba(0,0,0,0.06);
    border-color: #2D6A4F;
  }
</style>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "section-testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trusted by Over 10,000+ Happy Customers"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real feedback from verified purchasers across our 10 curated departments."
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "author",
          "label": "Customer Name",
          "default": "Marcus S."
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "Austin, TX"
        },
        {
          "type": "text",
          "id": "product_name",
          "label": "Product Purchased",
          "default": "Anker Soundcore Space Q45"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review Text",
          "default": "Super fast delivery and the product is 100% genuine with authentic serial numbers. Great customer support when I needed tracking updates!"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "author": "Marcus S.",
            "location": "Austin, TX",
            "product_name": "Anker Soundcore Space Q45",
            "quote": "Super fast delivery and the product is 100% genuine with authentic serial numbers. Great customer support when I needed tracking updates!"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "author": "Elena R.",
            "location": "Seattle, WA",
            "product_name": "Ninja Foodi 8.5-qt Air Fryer",
            "quote": "Leafanoo made the entire buying process seamless. Arrived in 3 days, perfectly packaged, and exactly as described in the specs."
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "author": "David L.",
            "location": "Chicago, IL",
            "product_name": "Logitech MX Master 3S",
            "quote": "I was looking for a verified seller with fast US fulfillment. Leafanoo exceeded expectations. Will definitely shop here again."
          }
        }
      ]
    }
  ]
}
{% endschema %}
