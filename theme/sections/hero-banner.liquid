{%- liquid
  assign text_align = section.settings.text_alignment | default: 'left'
-%}

<section class="section-{{ section.id }}-hero page-width" style="padding-top: 24px; padding-bottom: 24px;">
  <div class="laitm-ghero-wrap">
    <div class="laitm-ghero-grid">
      <!-- Left Copy Column -->
      <div class="laitm-ghero-copy">
        <span class="laitm-ghero-eyebrow">
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2v20M2 12h20"></path>
          </svg>
          {{ section.settings.badge_text | default: 'Garden Essentials' }}
        </span>

        <h1 class="laitm-ghero-h1">
          {{ section.settings.heading | default: 'Shade built for <span>slow afternoons</span>' }}
        </h1>

        <p class="laitm-ghero-sub">
          {{ section.settings.subheading | default: "Pergolas and gazebos for the corner of the yard you'll actually use — sturdy frames, easy assembly, and a look that gets better with every season." }}
        </p>

        <div class="laitm-ghero-actions">
          <a class="laitm-ghero-cta" href="{{ section.settings.button_link | default: '/collections/gazebo-pergolas' }}">
            {{ section.settings.button_label | default: 'Shop Garden Essentials' }}
            <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2.4" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
          <a class="laitm-ghero-cta-secondary" href="{{ section.settings.secondary_button_link | default: '/collections/all' }}">
            {{ section.settings.secondary_button_label | default: 'View all the products' }}
          </a>
        </div>

        <div class="laitm-ghero-stats">
          <div>
            <span class="laitm-ghero-stat-num">{{ section.settings.stat_1_num | default: '35+' }}</span>
            <span class="laitm-ghero-stat-label">{{ section.settings.stat_1_label | default: 'Garden picks' }}</span>
          </div>
          <div>
            <span class="laitm-ghero-stat-num">{{ section.settings.stat_2_num | default: '2–4h' }}</span>
            <span class="laitm-ghero-stat-label">{{ section.settings.stat_2_label | default: 'Avg. assembly' }}</span>
          </div>
          <div>
            <span class="laitm-ghero-stat-num">{{ section.settings.stat_3_num | default: 'Free' }}</span>
            <span class="laitm-ghero-stat-label">{{ section.settings.stat_3_label | default: 'US shipping' }}</span>
          </div>
        </div>
      </div>

      <!-- Right Scene / Photo Frame Column -->
      <div class="laitm-ghero-scene">
        <div class="laitm-ghero-photo-frame">
          <img
            src="{{ section.settings.hero_image_url | default: 'https://laitm.com/wp-content/uploads/2026/07/promoa-scaled.jpg' }}"
            alt="Pergola in a backyard garden setting"
            loading="eager"
            fetchpriority="high"
          >
        </div>
        <div class="laitm-ghero-tag">
          <span class="laitm-ghero-tag-dot"></span>
          <span>Pergolas & Gazebos</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .laitm-ghero-wrap {
    --laitm-green: #16a34a;
    --laitm-green-dark: #0f7a37;
    --laitm-green-tint: #e7f6ec;
    --laitm-parchment: #faf6ee;
    --laitm-ink: #1c1a16;
    --laitm-ink-soft: #57534e;
    --laitm-line: rgba(28,26,22,.1);
    position: relative;
    width: 100%;
    background: var(--laitm-parchment);
    border-radius: 20px;
    overflow: hidden;
    box-sizing: border-box;
    font-family: "Lexend Deca", -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: var(--laitm-ink);
    border: 1px solid rgba(28,26,22,.06);
  }
  .laitm-ghero-wrap *, .laitm-ghero-wrap *::before, .laitm-ghero-wrap *::after {
    box-sizing: border-box;
  }
  .laitm-ghero-grid {
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    align-items: stretch;
    min-height: 480px;
  }
  .laitm-ghero-copy {
    position: relative;
    padding: 64px 56px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 22px;
    z-index: 2;
  }
  .laitm-ghero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--laitm-green-dark);
    background: var(--laitm-green-tint);
    border: 1px solid rgba(22,163,74,.25);
    padding: 7px 16px 7px 14px;
    border-radius: 999px;
  }
  .laitm-ghero-eyebrow svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }
  .laitm-ghero-h1 {
    font-family: "Lexend Deca", -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-weight: 700;
    font-size: clamp(32px, 3.8vw, 48px);
    line-height: 1.15;
    letter-spacing: -.02em;
    margin: 0;
    color: var(--laitm-ink);
  }
  .laitm-ghero-h1 span {
    color: var(--laitm-green-dark);
  }
  .laitm-ghero-sub {
    font-size: 16px;
    font-weight: 400;
    line-height: 1.65;
    color: var(--laitm-ink-soft);
    max-width: 48ch;
    margin: 0;
  }
  .laitm-ghero-actions {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 6px;
    flex-wrap: wrap;
  }
  .laitm-ghero-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--laitm-green);
    color: #fff;
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    padding: 15px 28px;
    border-radius: 10px;
    transition: background .2s ease, transform .2s ease;
    box-shadow: 0 6px 16px rgba(22,163,74,.28);
  }
  .laitm-ghero-cta:hover {
    background: var(--laitm-green-dark);
    transform: translateY(-1px);
    color: #fff;
  }
  .laitm-ghero-cta svg {
    width: 17px;
    height: 17px;
    transition: transform .2s ease;
  }
  .laitm-ghero-cta:hover svg {
    transform: translateX(3px);
  }
  .laitm-ghero-cta-secondary {
    font-size: 15px;
    font-weight: 600;
    color: var(--laitm-ink);
    text-decoration: none;
    border-bottom: 2px solid var(--laitm-ink);
    padding-bottom: 2px;
    transition: color 0.2s, border-color 0.2s;
  }
  .laitm-ghero-cta-secondary:hover {
    color: var(--laitm-green-dark);
    border-color: var(--laitm-green-dark);
  }
  .laitm-ghero-stats {
    display: flex;
    gap: 32px;
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--laitm-line);
  }
  .laitm-ghero-stat-num {
    font-family: "Lexend Deca", sans-serif;
    font-size: 22px;
    font-weight: 700;
    color: var(--laitm-green-dark);
    display: block;
    line-height: 1.2;
  }
  .laitm-ghero-stat-label {
    font-size: 13px;
    color: var(--laitm-ink-soft);
    font-weight: 500;
    margin-top: 2px;
    display: block;
  }

  .laitm-ghero-scene {
    position: relative;
    min-height: 380px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .laitm-ghero-photo-frame {
    position: absolute;
    left: 8%;
    right: 8%;
    bottom: 9%;
    top: 9%;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 20px 45px rgba(28,26,22,.18);
    border: 6px solid #fff;
  }
  .laitm-ghero-photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .laitm-ghero-tag {
    position: absolute;
    left: 28px;
    bottom: 28px;
    background: #fff;
    color: var(--laitm-ink);
    font-size: 13px;
    font-weight: 600;
    padding: 10px 18px;
    border-radius: 10px;
    box-shadow: 0 8px 20px rgba(28,26,22,.14);
    display: flex;
    align-items: center;
    gap: 8px;
    z-index: 3;
  }
  .laitm-ghero-tag-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--laitm-green);
    flex-shrink: 0;
  }

  @media (max-width: 991px) {
    .laitm-ghero-grid {
      grid-template-columns: 1fr;
      min-height: unset;
    }
    .laitm-ghero-copy {
      padding: 48px 32px 32px;
    }
    .laitm-ghero-scene {
      min-height: 360px;
      margin: 0 24px 32px;
    }
    .laitm-ghero-photo-frame {
      left: 0;
      right: 0;
      top: 0;
      bottom: 0;
    }
  }
  @media (max-width: 480px) {
    .laitm-ghero-copy {
      padding: 36px 20px 24px;
      gap: 16px;
    }
    .laitm-ghero-actions {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }
    .laitm-ghero-cta {
      width: 100%;
      justify-content: center;
    }
    .laitm-ghero-stats {
      gap: 20px;
    }
    .laitm-ghero-scene {
      min-height: 280px;
      margin: 0 16px 24px;
    }
  }
</style>

{% schema %}
{
  "name": "Laitm Hero Banner",
  "tag": "section",
  "class": "section-hero-banner",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Eyebrow Badge",
      "default": "Garden Essentials"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (use <span> for green text)",
      "default": "Shade built for <span>slow afternoons</span>"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Pergolas and gazebos for the corner of the yard you'll actually use — sturdy frames, easy assembly, and a look that gets better with every season."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary Button Label",
      "default": "Shop Garden Essentials"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary Button Link",
      "default": "/collections/gazebo-pergolas"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary Button Label",
      "default": "View all the products"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary Button Link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "stat_1_num",
      "label": "Stat 1 Number",
      "default": "35+"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "Stat 1 Label",
      "default": "Garden picks"
    },
    {
      "type": "text",
      "id": "stat_2_num",
      "label": "Stat 2 Number",
      "default": "2–4h"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Stat 2 Label",
      "default": "Avg. assembly"
    },
    {
      "type": "text",
      "id": "stat_3_num",
      "label": "Stat 3 Number",
      "default": "Free"
    },
    {
      "type": "text",
      "id": "stat_3_label",
      "label": "Stat 3 Label",
      "default": "US shipping"
    },
    {
      "type": "text",
      "id": "hero_image_url",
      "label": "Hero Image URL",
      "default": "https://laitm.com/wp-content/uploads/2026/07/promoa-scaled.jpg"
    }
  ],
  "presets": [
    {
      "name": "Laitm Hero Banner"
    }
  ]
}
{% endschema %}
