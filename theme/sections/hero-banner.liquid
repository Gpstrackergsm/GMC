{%- liquid
  assign text_align = section.settings.text_alignment | default: 'left'
  assign hero_cta = section.settings.button_link | default: '/collections/all?filter.p.product_type=Garden+Essentials'
-%}

<section class="section-{{ section.id }}-hero" style="background-color: #faf6ee; padding: 20px 0 24px;">
  <div class="page-width">
    <div class="laitm-ghero-wrap">
      <div class="laitm-ghero-grid">
        <!-- Left Copy Column -->
        <div class="laitm-ghero-copy">
          <span class="laitm-ghero-eyebrow">
            <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true" width="13" height="13">
              <path d="M12 5v14M5 12h14"></path>
            </svg>
            {{ section.settings.badge_text | default: 'GARDEN ESSENTIALS' }}
          </span>

          <h1 class="laitm-ghero-h1">
            Shade built for <span>slow afternoons</span>
          </h1>

          <p class="laitm-ghero-sub">
            {{ section.settings.subheading | default: "Pergolas and gazebos for the corner of the yard you'll actually use — sturdy frames, easy assembly, and a look that gets better with every season." }}
          </p>

          <div class="laitm-ghero-actions">
            <a class="laitm-ghero-cta" href="{{ hero_cta }}">
              {{ section.settings.button_label | default: 'Shop Garden Essentials' }}
              <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2.4" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6"></path>
              </svg>
            </a>
            <a class="laitm-ghero-cta-secondary" href="{{ section.settings.secondary_button_link | default: '/collections/all' }}">
              {{ section.settings.secondary_button_label | default: 'View all the products' }}
            </a>
          </div>

          <div class="laitm-ghero-stats">
            <div>
              <span class="laitm-ghero-stat-num">{{ section.settings.stat_1_num | default: '35+' }}</span>
              <span class="laitm-ghero-stat-label">{{ section.settings.stat_1_label | default: 'Garden picks' }}</span>
            </div>
            <div>
              <span class="laitm-ghero-stat-num">{{ section.settings.stat_2_num | default: '2–4h' }}</span>
              <span class="laitm-ghero-stat-label">{{ section.settings.stat_2_label | default: 'Avg. assembly' }}</span>
            </div>
            <div>
              <span class="laitm-ghero-stat-num">{{ section.settings.stat_3_num | default: 'Free' }}</span>
              <span class="laitm-ghero-stat-label">{{ section.settings.stat_3_label | default: 'US shipping' }}</span>
            </div>
          </div>
        </div>

        <!-- Right Scene / Photo Frame Column -->
        <div class="laitm-ghero-scene">
          <div class="laitm-ghero-photo-frame">
            <img
              src="{{ section.settings.hero_image_url | default: 'https://laitm.com/wp-content/uploads/2026/07/promoa-scaled.jpg' }}"
              alt="Pergola in a backyard garden setting"
              loading="eager"
              fetchpriority="high"
            >
          </div>
          <div class="laitm-ghero-tag">
            <span class="laitm-ghero-tag-dot"></span>
            <span>In stock — ships this week</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .laitm-ghero-wrap {
    --laitm-green: #16a34a;
    --laitm-green-dark: #0f7a37;
    --laitm-green-tint: #e7f6ec;
    --laitm-parchment: #faf6ee;
    --laitm-ink: #1c1a16;
    --laitm-ink-soft: #57534e;
    --laitm-line: rgba(28,26,22,.1);
    position: relative;
    width: 100%;
    background: var(--laitm-parchment);
    border-radius: 20px;
    overflow: hidden;
    box-sizing: border-box;
    font-family: "Lexend Deca", -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: var(--laitm-ink);
    border: 1px solid rgba(28,26,22,.08);
    box-shadow: 0 4px 20px rgba(0,0,0,0.03);
  }
  .laitm-ghero-wrap *, .laitm-ghero-wrap *::before, .laitm-ghero-wrap *::after {
    box-sizing: border-box;
  }
  .laitm-ghero-grid {
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    align-items: stretch;
    min-height: 480px;
  }
  .laitm-ghero-copy {
    position: relative;
    padding: 56px 52px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 20px;
    z-index: 2;
  }
  .laitm-ghero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    width: fit-content;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--laitm-green-dark);
    background: var(--laitm-green-tint);
    border: 1px solid rgba(22,163,74,.25);
    padding: 6px 14px;
    border-radius: 999px;
  }
  .laitm-ghero-eyebrow svg {
    color: var(--laitm-green-dark);
    flex-shrink: 0;
  }
  .laitm-ghero-h1 {
    font-family: "Lexend Deca", -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-weight: 700;
    font-size: clamp(30px, 3.6vw, 46px);
    line-height: 1.15;
    letter-spacing: -.02em;
    margin: 0;
    color: var(--laitm-ink);
  }
  .laitm-ghero-h1 span {
    color: var(--laitm-green);
  }
  .laitm-ghero-sub {
    font-size: 15.5px;
    font-weight: 400;
    line-height: 1.65;
    color: var(--laitm-ink-soft);
    max-width: 48ch;
    margin: 0;
  }
  .laitm-ghero-actions {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 4px;
    flex-wrap: wrap;
  }
  .laitm-ghero-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--laitm-green);
    color: #fff;
    font-weight: 700;
    font-size: 14.5px;
    text-decoration: none;
    padding: 14px 26px;
    border-radius: 10px;
    transition: background .2s ease, transform .2s ease;
    box-shadow: 0 4px 14px rgba(22,163,74,.25);
  }
  .laitm-ghero-cta:hover {
    background: var(--laitm-green-dark);
    transform: translateY(-1px);
    color: #fff;
  }
  .laitm-ghero-cta svg {
    width: 16px;
    height: 16px;
    transition: transform .2s ease;
  }
  .laitm-ghero-cta:hover svg {
    transform: translateX(3px);
  }
  .laitm-ghero-cta-secondary {
    font-size: 14.5px;
    font-weight: 600;
    color: var(--laitm-ink);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1.5px;
    transition: color 0.2s;
  }
  .laitm-ghero-cta-secondary:hover {
    color: var(--laitm-green);
  }
  .laitm-ghero-stats {
    display: flex;
    gap: 32px;
    margin-top: 16px;
    padding-top: 20px;
    border-top: 1px solid var(--laitm-line);
  }
  .laitm-ghero-stat-num {
    font-family: "Lexend Deca", sans-serif;
    font-size: 22px;
    font-weight: 700;
    color: var(--laitm-green-dark);
    display: block;
    line-height: 1.2;
  }
  .laitm-ghero-stat-label {
    font-size: 12.5px;
    color: var(--laitm-ink-soft);
    font-weight: 500;
    margin-top: 2px;
    display: block;
  }

  .laitm-ghero-scene {
    position: relative;
    min-height: 380px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(155deg, var(--laitm-green-tint) 0%, var(--laitm-parchment) 60%);
    overflow: hidden;
  }
  .laitm-ghero-photo-frame {
    position: absolute;
    left: 8%;
    right: 8%;
    bottom: 9%;
    top: 9%;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 20px 45px rgba(28,26,22,.16);
    border: 6px solid #fff;
  }
  .laitm-ghero-photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .laitm-ghero-tag {
    position: absolute;
    left: 24px;
    bottom: 24px;
    background: #fff;
    color: var(--laitm-ink);
    font-size: 12.5px;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: 999px;
    box-shadow: 0 8px 20px rgba(28,26,22,.12);
    display: flex;
    align-items: center;
    gap: 8px;
    z-index: 3;
  }
  .laitm-ghero-tag-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--laitm-green);
    flex-shrink: 0;
  }

  @media (max-width: 991px) {
    .laitm-ghero-grid {
      grid-template-columns: 1fr;
      min-height: unset;
    }
    .laitm-ghero-copy {
      padding: 40px 28px 28px;
    }
    .laitm-ghero-scene {
      min-height: 340px;
      margin: 0 20px 24px;
      border-radius: 14px;
    }
    .laitm-ghero-photo-frame {
      left: 0;
      right: 0;
      top: 0;
      bottom: 0;
    }
  }
  @media (max-width: 480px) {
    .laitm-ghero-copy {
      padding: 32px 18px 20px;
      gap: 16px;
    }
    .laitm-ghero-actions {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
    .laitm-ghero-cta {
      width: 100%;
      justify-content: center;
    }
    .laitm-ghero-stats {
      gap: 18px;
    }
    .laitm-ghero-scene {
      min-height: 260px;
      margin: 0 14px 20px;
    }
  }
</style>

{% schema %}
{
  "name": "Laitm Hero Banner",
  "tag": "section",
  "class": "section-hero-banner",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Eyebrow Badge",
      "default": "GARDEN ESSENTIALS"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Pergolas and gazebos for the corner of the yard you'll actually use — sturdy frames, easy assembly, and a look that gets better with every season."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary Button Label",
      "default": "Shop Garden Essentials"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary Button Label",
      "default": "View all the products"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "text",
      "id": "stat_1_num",
      "label": "Stat 1 Number",
      "default": "35+"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "Stat 1 Label",
      "default": "Garden picks"
    },
    {
      "type": "text",
      "id": "stat_2_num",
      "label": "Stat 2 Number",
      "default": "2–4h"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Stat 2 Label",
      "default": "Avg. assembly"
    },
    {
      "type": "text",
      "id": "stat_3_num",
      "label": "Stat 3 Number",
      "default": "Free"
    },
    {
      "type": "text",
      "id": "stat_3_label",
      "label": "Stat 3 Label",
      "default": "US shipping"
    },
    {
      "type": "text",
      "id": "hero_image_url",
      "label": "Hero Image URL",
      "default": "https://laitm.com/wp-content/uploads/2026/07/promoa-scaled.jpg"
    }
  ],
  "presets": [
    {
      "name": "Laitm Hero Banner"
    }
  ]
}
{% endschema %}
