{%- liquid
  assign text_align = section.settings.text_alignment | default: 'left'
  assign hero_cta = section.settings.button_link | default: '/collections/types?q=Garden+Essentials'
-%}

<section class="section-{{ section.id }}-hero" style="background-color: #FFFFFF; padding: 24px 0 28px;">
  <div class="page-width">
    <div class="deere-hero-wrap">
      <div class="deere-hero-grid">
        <!-- Left Copy Column -->
        <div class="deere-hero-copy">
          <span class="deere-hero-eyebrow">
            <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true" width="13" height="13">
              <path d="M12 5v14M5 12h14"></path>
            </svg>
            {{ section.settings.badge_text | default: 'NOTHING RUNS LIKE A DEERE.™' }}
          </span>

          <h1 class="deere-hero-h1">
            {{ section.settings.heading | default: 'Engineered for Real Acreage. <span>Riding Mowers & Zero-Turns.</span>' }}
          </h1>

          <p class="deere-hero-sub">
            {{ section.settings.subheading | default: "Heavy-duty riding lawn tractors and precision zero-turn mowers from John Deere. Factory-sealed with complimentary hydraulic liftgate residential delivery directly to your driveway." }}
          </p>

          <!-- Liftgate Freight Hero Pill -->
          <div style="display: inline-flex; align-items: center; gap: 8px; background: #EEF7EC; border: 1.5px solid #367C2B; border-radius: 9999px; padding: 6px 16px; margin-bottom: 0.5rem; width: fit-content;">
            <span style="font-size: 1.05rem;">🚚</span>
            <span style="font-size: 0.85rem; font-weight: 800; color: #275e20; letter-spacing: 0.02em;">Free Residential Hydraulic Liftgate Delivery On All Mowers</span>
          </div>

          <div class="deere-hero-actions">
            <a class="deere-hero-cta" href="{{ hero_cta }}">
              {{ section.settings.button_label | default: 'Shop John Deere Series' }}
              <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2.6" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6"></path>
              </svg>
            </a>
            <a class="deere-hero-cta-secondary" href="{{ section.settings.secondary_button_link | default: '/collections/all' }}">
              {{ section.settings.secondary_button_label | default: 'Explore All Mowers' }}
            </a>
          </div>

          <div class="deere-hero-stats">
            <div>
              <span class="deere-hero-stat-num">{{ section.settings.stat_1_num | default: '76+' }}</span>
              <span class="deere-hero-stat-label">{{ section.settings.stat_1_label | default: 'Mower Models' }}</span>
            </div>
            <div>
              <span class="deere-hero-stat-num">{{ section.settings.stat_2_num | default: '100%' }}</span>
              <span class="deere-hero-stat-label">{{ section.settings.stat_2_label | default: 'Factory Sealed' }}</span>
            </div>
            <div>
              <span class="deere-hero-stat-num">{{ section.settings.stat_3_num | default: 'Free' }}</span>
              <span class="deere-hero-stat-label">{{ section.settings.stat_3_label | default: 'Liftgate Delivery' }}</span>
            </div>
          </div>
        </div>

        <!-- Right Scene / Photo Frame Column -->
        <div class="deere-hero-scene">
          <div class="deere-hero-photo-frame">
            <img
              src="{{ section.settings.hero_image_url | default: 'https://cdn.shopify.com/s/files/1/1008/3418/1416/files/ltm-product-89-image-1.png?v=1790417124' }}"
              alt="John Deere Riding Lawn Mower on manicured turf"
              loading="eager"
              fetchpriority="high"
            >
          </div>
          <div class="deere-hero-tag">
            <span class="deere-hero-tag-dot"></span>
            <span>Factory Sealed — Ships This Week</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .deere-hero-wrap {
    --deere-green: #367C2B;
    --deere-green-dark: #275e20;
    --deere-green-tint: #EEF7EC;
    --deere-yellow: #FFDE00;
    --deere-yellow-hover: #E6C800;
    --deere-ink: #111111;
    --deere-ink-soft: #4A4A4A;
    --deere-line: #E2E2E2;
    position: relative;
    width: 100%;
    background: #F7F7F7;
    border-radius: 12px;
    overflow: hidden;
    box-sizing: border-box;
    font-family: "Inter", -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: var(--deere-ink);
    border: 1px solid var(--deere-line);
    box-shadow: 0 4px 18px rgba(0,0,0,0.04);
  }
  .deere-hero-wrap *, .deere-hero-wrap *::before, .deere-hero-wrap *::after {
    box-sizing: border-box;
  }
  .deere-hero-grid {
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    align-items: stretch;
    min-height: 480px;
  }
  .deere-hero-copy {
    position: relative;
    padding: 52px 48px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 18px;
    z-index: 2;
  }
  .deere-hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    width: fit-content;
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--deere-green-dark);
    background: var(--deere-green-tint);
    border: 1.5px solid rgba(54,124,43,.3);
    padding: 6px 14px;
    border-radius: 999px;
  }
  .deere-hero-eyebrow svg {
    color: var(--deere-green-dark);
    flex-shrink: 0;
  }
  .deere-hero-h1 {
    font-family: "Inter", -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-weight: 900;
    font-size: clamp(28px, 3.6vw, 44px);
    line-height: 1.15;
    letter-spacing: -.025em;
    margin: 0;
    color: var(--deere-ink);
  }
  .deere-hero-h1 span {
    color: var(--deere-green);
  }
  .deere-hero-sub {
    font-family: "Open Sans", sans-serif;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.65;
    color: var(--deere-ink-soft);
    max-width: 48ch;
    margin: 0;
  }
  .deere-hero-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 4px;
    flex-wrap: wrap;
  }
  .deere-hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--deere-yellow);
    color: #111111;
    font-weight: 800;
    font-size: 14.5px;
    text-decoration: none;
    padding: 14px 26px;
    border-radius: 6px;
    transition: background .2s ease, transform .2s ease, box-shadow .2s ease;
    box-shadow: 0 4px 14px rgba(255,222,0,.4);
    letter-spacing: 0.02em;
  }
  .deere-hero-cta:hover {
    background: var(--deere-yellow-hover);
    transform: translateY(-1px);
    color: #000000;
    box-shadow: 0 6px 18px rgba(255,222,0,.5);
  }
  .deere-hero-cta svg {
    width: 16px;
    height: 16px;
    transition: transform .2s ease;
  }
  .deere-hero-cta:hover svg {
    transform: translateX(3px);
  }
  .deere-hero-cta-secondary {
    display: inline-flex;
    align-items: center;
    font-size: 14px;
    font-weight: 700;
    color: var(--deere-green);
    background: #FFFFFF;
    border: 2px solid var(--deere-green);
    padding: 12px 22px;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.2s;
  }
  .deere-hero-cta-secondary:hover {
    background: var(--deere-green);
    color: #FFFFFF;
  }
  .deere-hero-stats {
    display: flex;
    gap: 32px;
    margin-top: 12px;
    padding-top: 18px;
    border-top: 1px solid var(--deere-line);
  }
  .deere-hero-stat-num {
    font-family: "Inter", sans-serif;
    font-size: 22px;
    font-weight: 800;
    color: var(--deere-green);
    display: block;
    line-height: 1.2;
  }
  .deere-hero-stat-label {
    font-size: 12px;
    color: var(--deere-ink-soft);
    font-weight: 600;
    margin-top: 2px;
    display: block;
  }

  .deere-hero-scene {
    position: relative;
    min-height: 380px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(155deg, var(--deere-green-tint) 0%, #FFFFFF 65%);
    overflow: hidden;
  }
  .deere-hero-photo-frame {
    position: absolute;
    left: 8%;
    right: 8%;
    bottom: 9%;
    top: 9%;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 16px 40px rgba(0,0,0,.12);
    border: 5px solid #FFFFFF;
    background: #FFFFFF;
  }
  .deere-hero-photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 10px;
  }
  .deere-hero-tag {
    position: absolute;
    bottom: 22px;
    right: 22px;
    background: rgba(255,255,255,.94);
    backdrop-filter: blur(8px);
    border: 1px solid var(--deere-line);
    border-radius: 999px;
    padding: 6px 14px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
    color: var(--deere-ink);
    box-shadow: 0 4px 14px rgba(0,0,0,.08);
    z-index: 3;
  }
  .deere-hero-tag-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--deere-green);
    box-shadow: 0 0 0 3px rgba(54,124,43,.25);
  }

  @media (max-width: 990px) {
    .deere-hero-grid {
      grid-template-columns: 1fr;
    }
    .deere-hero-copy {
      padding: 36px 24px;
    }
    .deere-hero-scene {
      min-height: 320px;
    }
  }
  .laitm-ghero-photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .laitm-ghero-tag {
    position: absolute;
    left: 24px;
    bottom: 24px;
    background: #fff;
    color: var(--laitm-ink);
    font-size: 12.5px;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: 999px;
    box-shadow: 0 8px 20px rgba(28,26,22,.12);
    display: flex;
    align-items: center;
    gap: 8px;
    z-index: 3;
  }
  .laitm-ghero-tag-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--laitm-green);
    flex-shrink: 0;
  }

  @media (max-width: 991px) {
    .laitm-ghero-grid {
      grid-template-columns: 1fr;
      min-height: unset;
    }
    .laitm-ghero-copy {
      padding: 40px 28px 28px;
    }
    .laitm-ghero-scene {
      min-height: 340px;
      margin: 0 20px 24px;
      border-radius: 14px;
    }
    .laitm-ghero-photo-frame {
      left: 0;
      right: 0;
      top: 0;
      bottom: 0;
    }
  }
  @media (max-width: 480px) {
    .laitm-ghero-copy {
      padding: 32px 18px 20px;
      gap: 16px;
    }
    .laitm-ghero-actions {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
    .laitm-ghero-cta {
      width: 100%;
      justify-content: center;
    }
    .laitm-ghero-stats {
      gap: 18px;
    }
    .laitm-ghero-scene {
      min-height: 260px;
      margin: 0 14px 20px;
    }
  }
</style>

{% schema %}
{
  "name": "Laitm Hero Banner",
  "tag": "section",
  "class": "section-hero-banner",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Eyebrow Badge",
      "default": "COMMERCIAL & RESIDENTIAL TURF EQUIPMENT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for Real Acreage. <span>Riding Mowers & Zero-Turns.</span>"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Heavy-duty riding lawn tractors and precision zero-turn mowers from John Deere, Cub Cadet, Husqvarna, and top American turf brands. Factory-sealed with complimentary hydraulic liftgate residential delivery."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary Button Label",
      "default": "Shop John Deere Series"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary Button Label",
      "default": "View all the products"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "text",
      "id": "stat_1_num",
      "label": "Stat 1 Number",
      "default": "35+"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "Stat 1 Label",
      "default": "Garden picks"
    },
    {
      "type": "text",
      "id": "stat_2_num",
      "label": "Stat 2 Number",
      "default": "2–4h"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Stat 2 Label",
      "default": "Avg. assembly"
    },
    {
      "type": "text",
      "id": "stat_3_num",
      "label": "Stat 3 Number",
      "default": "Free"
    },
    {
      "type": "text",
      "id": "stat_3_label",
      "label": "Stat 3 Label",
      "default": "US shipping"
    },
    {
      "type": "text",
      "id": "hero_image_url",
      "label": "Hero Image URL",
      "default": "https://laitm.com/wp-content/uploads/2026/07/promoa-scaled.jpg"
    }
  ],
  "presets": [
    {
      "name": "Laitm Hero Banner"
    }
  ]
}
{% endschema %}
