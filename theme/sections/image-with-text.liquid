<div class="image-with-text section-padding" style="padding: {{ section.settings.padding_top | default: 48 }}px 0 {{ section.settings.padding_bottom | default: 48 }}px 0;">
  <div class="container">
    <div class="image-with-text__grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 3rem; align-items: center; {% if section.settings.layout == 'image_second' %}direction: rtl;{% endif %}">
      
      <div class="image-with-text__media" style="direction: ltr;">
        {%- if section.settings.image != blank -%}
          <div style="border-radius: 12px; overflow: hidden; box-shadow: 0 8px 30px rgba(0,0,0,0.06);">
            <img
              src="{{ section.settings.image | image_url: width: 800 }}"
              alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
              loading="lazy"
              width="800"
              height="{{ 800 | divided_by: section.settings.image.aspect_ratio | round }}"
              style="width: 100%; height: auto; display: block; object-fit: cover;"
            >
          </div>
        {%- else -%}
          <div style="background: #E8EFEA; border-radius: 12px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; color: var(--color-primary, #2D6A4F); font-weight: 500;">
            Curated Quality & Standards
          </div>
        {%- endif -%}
      </div>

      <div class="image-with-text__content" style="direction: ltr;">
        {%- if section.settings.caption != blank -%}
          <span class="caption" style="text-transform: uppercase; font-size: 0.8rem; letter-spacing: 1.5px; font-weight: 600; color: var(--color-primary, #2D6A4F); margin-bottom: 0.75rem; display: block;">
            {{ section.settings.caption }}
          </span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="heading" style="font-family: var(--font-heading-family, serif); font-size: 2.25rem; line-height: 1.25; margin-bottom: 1.25rem; color: var(--color-text, #1A1A1A);">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="rte" style="font-size: 1.05rem; line-height: 1.7; color: #4A4A4A; margin-bottom: 2rem;">
            {{ section.settings.text }}
          </div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="btn btn--primary" style="display: inline-block; padding: 0.9rem 2rem; background: var(--color-primary, #2D6A4F); color: #ffffff; text-decoration: none; border-radius: 6px; font-weight: 600;">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image with Text",
  "tag": "section",
  "class": "section-image-with-text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image Desktop Placement",
      "options": [
        { "value": "image_first", "label": "Image First (Left)" },
        { "value": "image_second", "label": "Image Second (Right)" }
      ],
      "default": "image_first"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption Tag",
      "default": "Our Sourcing Promise"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Thoughtful Products for Everyday Living"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>At Leafanoo, every item in our catalog is rigorously reviewed for durable manufacturing, verifiable specifications, and genuine consumer utility. We partner directly with vetted suppliers to ensure clear pricing and consistent fulfillment.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Learn More About Our Standards"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Image with Text"
    }
  ]
}
{% endschema %}
