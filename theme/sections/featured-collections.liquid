{%- if section.settings.heading != blank or section.settings.description != blank or section.blocks.size > 0 -%}
<section class="featured-collections section-{{ section.id }}" aria-labelledby="fc-heading-{{ section.id }}">
  <div class="featured-collections__inner page-width">

    {%- if section.settings.heading != blank or section.settings.description != blank -%}
      <div class="featured-collections__header">
        {%- if section.settings.heading != blank -%}
          <h2 id="fc-heading-{{ section.id }}" class="featured-collections__heading">
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="featured-collections__description">{{ section.settings.description | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul
        class="featured-collections__grid"
        role="list"
        style="
          --cols-desktop: {{ section.settings.columns_desktop }};
          --cols-mobile: {{ section.settings.columns_mobile }};
        "
      >
        {%- for block in section.blocks -%}
          {%- if block.type == 'collection' -%}
            {%- assign col = block.settings.collection -%}
            {%- assign card_img = block.settings.custom_image | default: col.featured_image -%}
            {%- assign card_label = block.settings.label | default: col.title -%}
            <li class="featured-collections__item" {{ block.shopify_attributes }}>
              <a
                href="{{ col.url | default: '#' }}"
                class="collection-card"
                aria-label="{{ card_label | escape }}{% if col.all_products_count > 0 %} — {{ col.all_products_count }} products{% endif %}"
              >
                <div class="collection-card__media">
                  {%- if card_img != blank -%}
                    <img
                      src="{{ card_img | image_url: width: 600 }}"
                      srcset="
                        {{ card_img | image_url: width: 400 }} 400w,
                        {{ card_img | image_url: width: 600 }} 600w,
                        {{ card_img | image_url: width: 800 }} 800w
                      "
                      sizes="(max-width: 749px) calc({{ 100 | divided_by: section.settings.columns_mobile }}vw - 24px), calc({{ 100 | divided_by: section.settings.columns_desktop }}vw - 24px)"
                      alt="{{ card_img.alt | escape | default: card_label | escape }}"
                      width="600"
                      height="600"
                      loading="lazy"
                      class="collection-card__img"
                    >
                  {%- else -%}
                    <div class="collection-card__placeholder" aria-hidden="true">
                      {{ 'collection-1' | placeholder_svg_tag: 'collection-card__placeholder-svg' }}
                    </div>
                  {%- endif -%}
                  <div class="collection-card__overlay" aria-hidden="true"></div>
                </div>
                <div class="collection-card__info">
                  <h3 class="collection-card__title">{{ card_label | escape }}</h3>
                  {%- if col.all_products_count > 0 -%}
                    <p class="collection-card__count">{{ col.all_products_count }} products</p>
                  {%- endif -%}
                  <span class="collection-card__cta" aria-hidden="true">Shop Now &rarr;</span>
                </div>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

  </div>
</section>

<style>
  .section-{{ section.id }} {
    padding: 64px 0;
  }
  .featured-collections__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
  }
  .featured-collections__header {
    text-align: center;
    margin-bottom: 40px;
  }
  .featured-collections__heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 12px;
  }
  .featured-collections__description {
    font-family: 'Inter', sans-serif;
    font-size: 1.0625rem;
    color: #555;
    margin: 0 auto;
    max-width: 560px;
    line-height: 1.6;
  }
  .featured-collections__grid {
    display: grid;
    grid-template-columns: repeat(var(--cols-desktop, 3), 1fr);
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Collection card */
  .collection-card {
    display: block;
    text-decoration: none;
    border-radius: 12px;
    overflow: hidden;
    position: relative;
    background-color: #e8f5e9;
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }
  .collection-card:hover,
  .collection-card:focus-visible {
    box-shadow: 0 12px 40px rgba(0,0,0,0.12);
    transform: translateY(-2px);
    outline: none;
  }
  .collection-card:focus-visible { outline: 3px solid #2D6A4F; outline-offset: 3px; }
  .collection-card__media {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }
  .collection-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .collection-card:hover .collection-card__img { transform: scale(1.04); }
  .collection-card__placeholder {
    width: 100%;
    height: 100%;
    background-color: #d8f3dc;
  }
  .collection-card__placeholder-svg { width: 100%; height: 100%; }
  .collection-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.45) 0%, transparent 55%);
  }
  .collection-card__info {
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .collection-card__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.125rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0;
    line-height: 1.3;
  }
  .collection-card__count {
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem;
    color: #666;
    margin: 0;
  }
  .collection-card__cta {
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    color: #2D6A4F;
    margin-top: 4px;
    display: inline-block;
    transition: color 0.2s;
  }
  .collection-card:hover .collection-card__cta { color: #1b4332; }

  @media (max-width: 749px) {
    .section-{{ section.id }} { padding: 40px 0; }
    .featured-collections__inner { padding: 0 16px; }
    .featured-collections__grid { grid-template-columns: repeat(var(--cols-mobile, 2), 1fr); gap: 16px; }
  }
</style>
{%- endif -%}

{% schema %}
{
  "name": "Featured Collections",
  "tag": "section",
  "class": "section-featured-collections",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "min": 1,
      "max": 2,
      "step": 1,
      "default": 2
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom image (overrides collection image)"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Custom label (overrides collection title)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Collections",
      "settings": {
        "heading": "Shop by Category",
        "columns_desktop": 3,
        "columns_mobile": 2
      },
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
