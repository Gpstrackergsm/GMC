{%- liquid
  assign section_heading = section.settings.heading | default: 'Shop Our Top Categories'
  assign section_caption = section.settings.caption | default: 'Curated Catalog'
-%}

<section class="laitm-cats-section page-width" style="padding: 64px 0;">
  <div class="laitm-cats-header">
    <span class="laitm-cats-caption">{{ section_caption }}</span>
    <h2 class="laitm-cats-title">{{ section_heading }}</h2>
    {%- if section.settings.description != blank -%}
      <p class="laitm-cats-sub">{{ section.settings.description | escape }}</p>
    {%- endif -%}
  </div>

  <div class="laitm-cats-grid">
    {%- for block in section.blocks -%}
      {%- assign col = block.settings.collection -%}
      {%- assign label = block.settings.label | default: col.title | default: 'Category' -%}
      {%- assign cat_img_url = block.settings.image_url -%}
      {%- assign card_href = col.url | default: '/collections/all' -%}

      <a href="{{ card_href }}" class="laitm-cat-card" {{ block.shopify_attributes }}>
        <div class="laitm-cat-card__media">
          {%- if block.settings.custom_image != blank -%}
            <img
              src="{{ block.settings.custom_image | image_url: width: 600 }}"
              alt="{{ label | escape }}"
              loading="lazy"
              class="laitm-cat-card__img"
            >
          {%- elsif cat_img_url != blank -%}
            <img
              src="{{ cat_img_url }}"
              alt="{{ label | escape }}"
              loading="lazy"
              class="laitm-cat-card__img"
            >
          {%- elsif col != blank and col.featured_image != blank -%}
            <img
              src="{{ col.featured_image | image_url: width: 600 }}"
              alt="{{ label | escape }}"
              loading="lazy"
              class="laitm-cat-card__img"
            >
          {%- else -%}
            <div class="laitm-cat-card__placeholder">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </div>
          {%- endif -%}
        </div>
        <div class="laitm-cat-card__info">
          <span class="laitm-cat-card__label">{{ label }}</span>
          <span class="laitm-cat-card__arrow">
            <svg width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 10h10M10 5l5 5-5 5"/></svg>
          </span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

<style>
  .laitm-cats-header {
    text-align: center;
    margin-bottom: 40px;
  }
  .laitm-cats-caption {
    display: inline-block;
    font-family: "Lexend Deca", -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 12px;
    font-weight: 700;
    color: #16a34a;
    text-transform: uppercase;
    letter-spacing: .12em;
    margin-bottom: 12px;
  }
  .laitm-cats-title {
    font-family: "Lexend Deca", -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 800;
    color: #1c1a16;
    margin: 0 0 12px;
    line-height: 1.2;
  }
  .laitm-cats-sub {
    font-size: 1rem;
    color: #57534e;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }
  .laitm-cats-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
  }
  .laitm-cat-card {
    display: flex;
    flex-direction: column;
    border-radius: 14px;
    overflow: hidden;
    background: #fff;
    border: 1px solid rgba(28,26,22,.08);
    text-decoration: none;
    color: inherit;
    transition: transform 0.22s cubic-bezier(.16,1,.3,1), box-shadow 0.22s cubic-bezier(.16,1,.3,1), border-color 0.2s;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  }
  .laitm-cat-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(0,0,0,0.08);
    border-color: #16a34a;
  }
  .laitm-cat-card__media {
    aspect-ratio: 1;
    overflow: hidden;
    background: #f4f4f0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .laitm-cat-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
    display: block;
  }
  .laitm-cat-card:hover .laitm-cat-card__img {
    transform: scale(1.06);
  }
  .laitm-cat-card__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    min-height: 140px;
    color: #16a34a;
    background: #e7f6ec;
  }
  .laitm-cat-card__info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px;
    gap: 8px;
  }
  .laitm-cat-card__label {
    font-family: "Lexend Deca", -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 13.5px;
    font-weight: 700;
    color: #1c1a16;
    line-height: 1.3;
    flex: 1;
  }
  .laitm-cat-card__arrow {
    color: #16a34a;
    flex-shrink: 0;
    opacity: 0;
    transition: opacity 0.2s, transform 0.2s;
    transform: translateX(-4px);
  }
  .laitm-cat-card:hover .laitm-cat-card__arrow {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 1100px) {
    .laitm-cats-grid { grid-template-columns: repeat(4, 1fr); }
  }
  @media (max-width: 768px) {
    .laitm-cats-grid { grid-template-columns: repeat(3, 1fr); gap: 12px; }
  }
  @media (max-width: 480px) {
    .laitm-cats-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
  }
</style>

{% schema %}
