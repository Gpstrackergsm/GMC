<section class="featured-collections section-{{ section.id }}" style="padding: 48px 0;">
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.description != blank -%}
      <div class="section-header text-center" style="margin-bottom: 2.5rem; text-align: center;">
        {%- if section.settings.heading != blank -%}
          <h2 class="section-heading" style="font-family: var(--font-heading-family, serif); font-size: 2.25rem; color: var(--color-text, #1A1A1A); margin-bottom: 0.5rem;">
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="section-subheading" style="color: #666; font-size: 1rem; max-width: 600px; margin: 0 auto;">
            {{ section.settings.description | escape }}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="collection-grid" style="display: grid; grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr); gap: 1.5rem;">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign col = block.settings.collection -%}
          {%- assign fallback_title = 'Department ' | append: forloop.index -%}
          {%- case forloop.index -%}
            {%- when 1 -%}{%- assign fallback_title = 'Home & Kitchen' -%}
            {%- when 2 -%}{%- assign fallback_title = 'Home Organization' -%}
            {%- when 3 -%}{%- assign fallback_title = 'Pet Accessories' -%}
            {%- when 4 -%}{%- assign fallback_title = 'Garden & Outdoor' -%}
            {%- when 5 -%}{%- assign fallback_title = 'Travel Essentials' -%}
            {%- when 6 -%}{%- assign fallback_title = 'Personal Care' -%}
            {%- when 7 -%}{%- assign fallback_title = 'Office & Workspace' -%}
            {%- when 8 -%}{%- assign fallback_title = 'Hobby & Lifestyle' -%}
          {%- endcase -%}
          {%- assign title = block.settings.label | default: col.title | default: fallback_title -%}
          {%- assign card_img = block.settings.custom_image | default: col.featured_image -%}

          <div class="collection-card" {{ block.shopify_attributes }} style="border-radius: 12px; overflow: hidden; background: #ffffff; border: 1px solid var(--color-border, #E8E8E0); box-shadow: 0 2px 8px rgba(0,0,0,0.04); transition: transform 0.2s ease, box-shadow 0.2s ease;">
            <a href="{% if col != blank %}{{ col.url }}{% else %}/collections/all{% endif %}" style="text-decoration: none; color: inherit; display: block;">
              <div class="collection-card__media" style="aspect-ratio: 4/3; background: #E8F0EB; overflow: hidden; display: flex; align-items: center; justify-content: center; position: relative;">
                {%- if card_img != blank -%}
                  <img
                    src="{{ card_img | image_url: width: 600 }}"
                    alt="{{ title | escape }}"
                    loading="lazy"
                    style="width: 100%; height: 100%; object-fit: cover;"
                  >
                {%- else -%}
                  <div style="font-family: var(--font-heading-family, serif); font-size: 1.2rem; font-weight: 600; color: var(--color-primary, #2D6A4F); text-align: center; padding: 1rem;">
                    {{ title }}
                  </div>
                {%- endif -%}
              </div>
              <div class="collection-card__info" style="padding: 1.25rem 1rem; text-align: center;">
                <h3 style="font-family: var(--font-heading-family, serif); font-size: 1.15rem; font-weight: 700; margin-bottom: 0.25rem; color: var(--color-text, #1A1A1A);">
                  {{ title }}
                </h3>
                <span style="font-size: 0.85rem; font-weight: 600; color: var(--color-primary, #2D6A4F);">
                  Shop Department &rarr;
                </span>
              </div>
            </a>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- assign default_depts = "Home & Kitchen,Home Organization,Pet Accessories,Garden & Outdoor" | split: "," -%}
        {%- for dept in default_depts -%}
          <div class="collection-card" style="border-radius: 12px; overflow: hidden; background: #ffffff; border: 1px solid var(--color-border, #E8E8E0);">
            <a href="/collections/all" style="text-decoration: none; color: inherit; display: block;">
              <div style="aspect-ratio: 4/3; background: #E8F0EB; display: flex; align-items: center; justify-content: center; color: var(--color-primary, #2D6A4F); font-weight: 600;">
                {{ dept }}
              </div>
              <div style="padding: 1.25rem 1rem; text-align: center;">
                <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.25rem;">{{ dept }}</h3>
                <span style="font-size: 0.85rem; font-weight: 600; color: var(--color-primary, #2D6A4F);">Shop Department &rarr;</span>
              </div>
            </a>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Collections",
  "tag": "section",
  "class": "section-featured-collections",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Department"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Subheading",
      "default": "Explore our curated departments featuring verified, high-utility physical merchandise."
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4,
      "label": "Desktop Columns"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Department",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Custom Label"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Collections",
      "blocks": [
        { "type": "collection", "settings": { "label": "Home & Kitchen" } },
        { "type": "collection", "settings": { "label": "Home Organization" } },
        { "type": "collection", "settings": { "label": "Pet Accessories" } },
        { "type": "collection", "settings": { "label": "Garden & Outdoor" } }
      ]
    }
  ]
}
{% endschema %}
