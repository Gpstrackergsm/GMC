<div class="product-page-section section-padding" style="padding: 2rem 0 4rem 0;" data-product-id="{{ product.id }}">
  <div class="container">
    {% render 'structured-data-breadcrumb' %}
    {% render 'structured-data-product', product: product %}

    <!-- Visual Breadcrumb Navigation -->
    {%- assign breadcrumb_title = product.title | replace: '&amp;amp;', '&' | replace: '&amp;', '&' | replace: '&quot;', '"' | replace: '&#39;', "'" -%}
    <nav aria-label="Breadcrumb" style="font-size: 0.85rem; color: #666; margin-bottom: 1.75rem; display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
      <a href="/" style="color: #666; text-decoration: none; font-weight: 500;">Home</a>
      <span style="color: #bbb;">&rsaquo;</span>
      {%- if product.collections.first -%}
        <a href="{{ product.collections.first.url }}" style="color: #666; text-decoration: none; font-weight: 500;">{{ product.collections.first.title | replace: '&amp;amp;', '&' | replace: '&amp;', '&' }}</a>
        <span style="color: #bbb;">&rsaquo;</span>
      {%- elsif product.type != blank -%}
        <span style="color: #666; font-weight: 500;">{{ product.type | replace: '&amp;amp;', '&' | replace: '&amp;', '&' }}</span>
        <span style="color: #bbb;">&rsaquo;</span>
      {%- endif -%}
      <span style="color: #1A1A1A; font-weight: 600;">{{ breadcrumb_title | truncate: 50 }}</span>
    </nav>

    <div class="product-layout" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 3.5rem; align-items: start; margin-bottom: 3.5rem;">
      
      <!-- Product Media Gallery -->
      <div class="product-gallery" style="position: sticky; top: 90px;">
        <div class="product-gallery__main" id="ProductGalleryMain-{{ section.id }}" style="border-radius: 16px; overflow: hidden; background: #FFFFFF; border: 1px solid var(--color-border, #E8E8E0); margin-bottom: 1rem; position: relative; box-shadow: 0 4px 20px rgba(0,0,0,0.03); cursor: zoom-in;">
          {%- if product.featured_media != blank -%}
            <img
              id="ProductMainImage-{{ section.id }}"
              src="{{ product.featured_media | image_url: width: 1200 }}"
              alt="{{ product.featured_media.alt | default: product.title | escape }}"
              width="1200"
              height="{{ 1200 | divided_by: product.featured_media.aspect_ratio | round }}"
              loading="eager"
              style="width: 100%; height: auto; display: block; object-fit: contain; aspect-ratio: 1; transition: transform 0.3s ease;"
            >
          {%- else -%}
            <div style="aspect-ratio: 1; display: flex; align-items: center; justify-content: center; background: #F0F0EB; color: #888;">
              {{ product.title }}
            </div>
          {%- endif -%}

          {%- if product.compare_at_price > product.price -%}
            <span class="badge badge--sale" style="position: absolute; top: 1rem; left: 1rem; background: var(--color-accent, #D4A853); color: #1A1A1A; font-weight: 700; font-size: 0.8rem; padding: 0.35rem 0.75rem; border-radius: 4px; text-transform: uppercase;">
              Sale
            </span>
          {%- endif -%}

          <!-- Zoom Overlay Icon -->
          <button type="button" id="GalleryZoomBtn-{{ section.id }}" aria-label="Enlarge image" style="position: absolute; bottom: 1rem; right: 1rem; background: rgba(255,255,255,0.92); border: 1px solid #E8E8E0; border-radius: 50%; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; cursor: pointer; box-shadow: 0 2px 8px rgba(0,0,0,0.12); color: #1A1A1A; font-size: 1.1rem;">
            🔍
          </button>
        </div>

        <!-- Thumbnails Slider Container -->
        <div class="product-gallery__thumbnails" id="GalleryThumbnails-{{ section.id }}" style="display: flex; gap: 0.75rem; overflow-x: auto; padding: 4px 2px 8px 2px; scroll-behavior: smooth;">
          {%- if product.media.size > 1 -%}
            {%- for media in product.media -%}
              <button
                type="button"
                class="thumbnail-btn {% if forloop.first %}is-active{% endif %}"
                data-media-id="{{ media.id }}"
                data-image-src="{{ media | image_url: width: 1200 }}"
                data-image-alt="{{ media.alt | default: product.title | escape }}"
                style="flex: 0 0 74px; width: 74px; height: 74px; border-radius: 8px; border: 2px solid {% if forloop.first %}var(--color-primary, #2D6A4F){% else %}var(--color-border, #E8E8E0){% endif %}; padding: 2px; background: #fff; cursor: pointer; overflow: hidden; transition: border-color 0.2s, transform 0.2s;"
                aria-label="View product image {{ forloop.index }}"
              >
                <img
                  src="{{ media | image_url: width: 150, height: 150, crop: 'center' }}"
                  alt="{{ media.alt | default: product.title | escape }}"
                  width="150"
                  height="150"
                  loading="lazy"
                  style="width: 100%; height: 100%; object-fit: cover; border-radius: 4px;"
                >
              </button>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>

      <!-- Product Form & Details -->
      <div class="product-details">
        {%- assign clean_title = product.title | replace: '&amp;amp;', '&' | replace: '&amp;', '&' | replace: '&quot;', '"' | replace: '&#39;', "'" -%}
        {%- assign clean_vendor = product.vendor | replace: '&amp;amp;', '&' | replace: '&amp;', '&' -%}

        {%- if section.settings.show_vendor and clean_vendor != blank -%}
          <div class="product-vendor" style="text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1.5px; color: var(--color-primary, #16a34a); margin-bottom: 0.5rem; font-weight: 700;">
            {{ clean_vendor }}
          </div>
        {%- endif -%}

        <h1 class="product-title" style="font-family: var(--font-heading-family, serif); font-size: 2.15rem; line-height: 1.25; color: var(--color-text, #1A1A1A); margin-bottom: 0.75rem;">
          {{ clean_title }}
        </h1>

        <!-- Star Rating with Smooth Scroll to Reviews -->
        <a href="#product-tab-reviews" onclick="switchProductTab('reviews');" style="display: inline-flex; align-items: center; gap: 6px; margin-bottom: 1rem; font-size: 0.9rem; text-decoration: none; color: inherit;">
          <span style="color: #D4A853; font-size: 1.05rem;">★★★★★</span>
          <span style="font-weight: 700; color: #1A1A1A;">4.9</span>
          <span style="color: #16a34a; text-decoration: underline;">(Verified Purchaser Feedback)</span>
        </a>

        <!-- Stock Availability + Scarcity Urgency Block -->
        <div class="product-meta" style="margin-bottom: 1.25rem; font-size: 0.875rem;">
          <!-- In Stock + Units Left -->
          <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-bottom: 8px;">
            <div style="display: flex; align-items: center; gap: 8px; background: #E8F5EE; padding: 6px 14px; border-radius: 9999px;">
              <span style="width: 8px; height: 8px; background: #27AE60; border-radius: 50%; box-shadow: 0 0 6px #27AE60; animation: pulse-dot 1.5s infinite;"></span>
              <span style="font-weight: 700; color: #1B4332;">In Stock — Ships in 24-48h</span>
            </div>
            <div style="display: flex; align-items: center; gap: 6px; background: #FFF7ED; border: 1px solid #FED7AA; padding: 5px 12px; border-radius: 9999px;">
              <span style="font-size: 0.95rem;">🔥</span>
              <span style="font-weight: 700; color: #C2410C;" id="units-left-badge">Only <span id="units-left-count">{{ product.id | modulo: 4 | plus: 2 }}</span> Left at This Price</span>
            </div>
          </div>
          <!-- Live viewers counter -->
          <div style="display: flex; align-items: center; gap: 6px; font-size: 0.82rem; color: #64748B;">
            <span style="width: 7px; height: 7px; background: #EF4444; border-radius: 50%; display: inline-block; animation: pulse-dot 1.2s infinite;"></span>
            <span id="live-viewers-text"><strong style="color: #1A1A1A;" id="live-viewers-count">{{ product.id | modulo: 14 | plus: 8 }}</strong> people are viewing this right now</span>
          </div>
          {%- if section.settings.show_sku and product.selected_or_first_available_variant.sku != blank -%}
            <span class="product-sku" style="color: #888; font-size: 0.78rem; display: block; margin-top: 4px;">SKU: <strong id="ProductSku-{{ section.id }}">{{ product.selected_or_first_available_variant.sku }}</strong></span>
          {%- endif -%}
        </div>
        <style>
          @keyframes pulse-dot { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.6;transform:scale(1.3)} }
        </style>

        <!-- Price & Savings -->
        <div class="product-price-wrapper" style="margin-bottom: 0.75rem; display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap;">
          {% render 'price', product: product, use_variant: true, price_class: 'price--large' %}
          {%- if product.compare_at_price > product.price -%}
            <span style="background: #FFF1F2; color: #BE123C; border: 1px solid #FECDD3; font-size: 0.85rem; font-weight: 700; padding: 3px 8px; border-radius: 6px;">
              Save {{ product.compare_at_price | minus: product.price | money }} ({{ product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round }}% OFF)
            </span>
          {%- endif -%}
        </div>

        <!-- Buy Now Pay Later / Flexible Financing Badge -->
        <div class="product-bnpl-badge" style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px; padding: 0.65rem 1rem; margin-bottom: 1.25rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; font-size: 0.85rem; color: #334155;">
          <div style="display: flex; align-items: center; gap: 6px;">
            <span style="font-size: 1rem;">💳</span>
            <span>Starting at <strong style="color: #0F172A;">{{ product.selected_or_first_available_variant.price | divided_by: 4 | money }}</strong>/mo with flexible financing</span>
          </div>
          <div style="display: flex; align-items: center; gap: 6px;">
            <span style="background: #5A31F4; color: #FFFFFF; font-weight: 700; font-size: 0.72rem; padding: 2px 7px; border-radius: 4px; letter-spacing: 0.02em;">Shop Pay</span>
            <span style="background: #000000; color: #FFFFFF; font-weight: 700; font-size: 0.72rem; padding: 2px 7px; border-radius: 4px;">affirm</span>
            <span style="background: #FFB3C7; color: #000000; font-weight: 700; font-size: 0.72rem; padding: 2px 7px; border-radius: 4px;">Klarna.</span>
          </div>
        </div>

        <!-- Live Delivery Estimator -->
        <div class="delivery-estimator" style="background: #FAFAF7; border: 1px dashed #16a34a; border-radius: 10px; padding: 0.85rem 1.25rem; margin-bottom: 1.75rem; display: flex; align-items: center; gap: 10px; font-size: 0.9rem;">
          <span style="font-size: 1.2rem;">🚚</span>
          <div>
            Order within <strong id="delivery-timer" style="color: #16a34a;">4 hrs 20 mins</strong> to receive by <strong id="estimated-delivery-date" style="color: #1A1A1A;"></strong> with <strong>Free US Shipping</strong>.
          </div>
        </div>

        {%- form 'product', product, id: 'ProductForm', class: 'product-form' -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

          <!-- Variant Picker -->
          {%- unless product.has_only_default_variant -%}
            <div class="product-variants" style="margin-bottom: 1.5rem;">
              {% render 'variant-picker', product: product %}
            </div>
          {%- endunless -%}

          <!-- Flash Sale Countdown Timer -->
          <div id="countdown-bar" style="background: linear-gradient(135deg, #7F1D1D, #DC2626); border-radius: 10px; padding: 10px 16px; margin-bottom: 14px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
            <div style="display: flex; align-items: center; gap: 8px; color: #fff; font-size: 0.88rem; font-weight: 700;">
              <span style="font-size: 1.1rem;">⚡</span>
              <span>FLASH PRICE — Ends in:</span>
            </div>
            <div style="display: flex; gap: 6px; align-items: center;">
              <div style="background: rgba(255,255,255,0.15); border-radius: 6px; padding: 4px 8px; text-align: center; min-width: 42px;">
                <div style="font-size: 1.2rem; font-weight: 900; color: #fff; line-height: 1;" id="ctdown-h">02</div>
                <div style="font-size: 0.6rem; color: rgba(255,255,255,0.75); text-transform: uppercase;">hrs</div>
              </div>
              <span style="color: #fff; font-weight: 900; font-size: 1.2rem;">:</span>
              <div style="background: rgba(255,255,255,0.15); border-radius: 6px; padding: 4px 8px; text-align: center; min-width: 42px;">
                <div style="font-size: 1.2rem; font-weight: 900; color: #fff; line-height: 1;" id="ctdown-m">47</div>
                <div style="font-size: 0.6rem; color: rgba(255,255,255,0.75); text-transform: uppercase;">min</div>
              </div>
              <span style="color: #fff; font-weight: 900; font-size: 1.2rem;">:</span>
              <div style="background: rgba(255,255,255,0.15); border-radius: 6px; padding: 4px 8px; text-align: center; min-width: 42px;">
                <div style="font-size: 1.2rem; font-weight: 900; color: #fff; line-height: 1;" id="ctdown-s">30</div>
                <div style="font-size: 0.6rem; color: rgba(255,255,255,0.75); text-transform: uppercase;">sec</div>
              </div>
            </div>
          </div>

          <!-- Quantity, Add to Cart & Buy Now Buttons -->
          <div class="product-atc-group" style="display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1rem;">
            <div style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
              {%- if section.settings.show_quantity_selector -%}
                <div class="product-quantity">
                  {% render 'quantity-input', product: product %}
                </div>
              {%- endif -%}

              <button
                type="submit"
                name="add"
                class="btn btn--primary btn--atc"
                {% unless product.available %}disabled{% endunless %}
                style="flex: 1 1 200px; padding: 1.2rem 2rem; background: var(--color-primary, #16a34a); color: #FFFFFF; font-size: 1.1rem; font-weight: 800; border: none; border-radius: 10px; cursor: {% if product.available %}pointer{% else %}not-allowed{% endif %}; box-shadow: 0 6px 20px rgba(22,163,74,0.4); transition: transform 0.15s, box-shadow 0.15s; letter-spacing: 0.02em;"
                onmouseover="this.style.transform='scale(1.02)';this.style.boxShadow='0 8px 25px rgba(22,163,74,0.5)'"
                onmouseout="this.style.transform='scale(1)';this.style.boxShadow='0 6px 20px rgba(22,163,74,0.4)'"
              >
                <span class="atc-text">
                  {%- if product.available -%}
                    🛒 Add to Cart — Free Shipping
                  {%- else -%}
                    Sold Out
                  {%- endif -%}
                </span>
              </button>
            </div>

            {%- if product.available -%}
              <!-- Direct 1-Click Buy Now Button -->
              <button
                type="button"
                id="DirectBuyNowBtn"
                data-buy-now="true"
                class="btn btn--buy-now"
                onclick="buyNowDirectly()"
                style="width: 100%; padding: 1.15rem 2rem; background: #111827; color: #FFFFFF; font-size: 1.1rem; font-weight: 800; border: none; border-radius: 10px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; box-shadow: 0 6px 20px rgba(0,0,0,0.22); transition: all 0.15s; letter-spacing: 0.02em;"
                onmouseover="this.style.transform='scale(1.02)'"
                onmouseout="this.style.transform='scale(1)'"
              >
                <span>⚡ Buy It Now — Instant Secure Checkout</span>
              </button>

              <!-- Reassurance under buttons -->
              <div style="display: flex; align-items: center; justify-content: center; gap: 16px; flex-wrap: wrap; font-size: 0.78rem; color: #64748B; padding: 6px 0 2px;">
                <span>🔒 256-bit SSL Secure</span>
                <span>📦 Free US Shipping</span>
                <span>↩️ 30-Day Returns</span>
                <span>✅ Genuine Product</span>
              </div>

              {%- if section.settings.show_dynamic_checkout -%}
                <div class="dynamic-checkout-wrapper" style="width: 100%;">
                  {{ form | payment_button }}
                </div>
              {%- endif -%}
            {%- endif -%}
          </div>
        {%- endform -%}

        <!-- Accepted Payment Methods Bar -->
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; padding: 0.85rem 1.25rem; background: #FAFAF7; border: 1px solid #E8E8E0; border-radius: 8px; margin-bottom: 1.75rem; font-size: 0.8rem; color: #555;">
          <div style="display: flex; align-items: center; gap: 6px; font-weight: 600;">
            <span>🔒 Guaranteed Secure Checkout:</span>
          </div>
          <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
            <svg style="height: 20px; width: auto;" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="4" fill="#0A2540"/><path d="M15.4 16.5h-2.3l1.4-9h2.3l-1.4 9zm7.3-8.8c-.5-.2-1.2-.4-2.1-.4-2.3 0-4 1.2-4 3 0 1.3 1.2 2 2.1 2.4.9.4 1.2.7 1.2 1.1 0 .6-.7.9-1.4.9-.9 0-1.4-.1-2.2-.5l-.3-.1-.3 2c.6.3 1.6.5 2.6.5 2.5 0 4.1-1.2 4.1-3.1 0-1-.6-1.8-2-2.5-.8-.4-1.3-.7-1.3-1.1 0-.4.4-.8 1.3-.8.7 0 1.3.1 1.7.3l.2.1.4-1.9zm5.5 3.7c.2-.5 1-2.7 1-2.7h.1c0 .1-.2.8-.3 1.3l-.9 4.3h-2.1l3.3-8.8h2.4l1.5 8.8h-2.3l-.3-1.4h-2.4l-.4 1.4zm-14.7-3.7l-2.2 6.1-.2-1.2c-.4-1.4-1.7-2.9-3.2-3.6l2 7.7h2.4l3.6-9h-2.4z" fill="#fff"/></svg>
            <svg style="height: 20px; width: auto;" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="4" fill="#EB001B"/><circle cx="15" cy="12" r="7" fill="#EB001B"/><circle cx="23" cy="12" r="7" fill="#F79E1B"/><path d="M19 6.8a6.9 6.9 0 010 10.4 6.9 6.9 0 000-10.4z" fill="#FF5F00"/></svg>
            <svg style="height: 20px; width: auto;" viewBox="0 0 38 24" fill="none"><rect width="38" height="24" rx="4" fill="#0079C1"/><path d="M13 17h2.2l1.3-8.5h-2.2L13 17zm7.5-8.5c-.8 0-1.4.4-1.8 1l-.1-.8h-2.1L15 17h2.3l.5-3.3c.4.4.9.6 1.5.6 1.8 0 3.3-1.4 3.3-3.3 0-1.6-1-2.5-2.1-2.5zm-.5 4.3c-.7 0-1.1-.5-1.1-1.2 0-.9.6-1.5 1.3-1.5.6 0 1 .4 1 1.1 0 .9-.5 1.6-1.2 1.6z" fill="#fff"/></svg>
            <span style="font-size: 0.75rem; font-weight: 700; color: #111827; background: #E5E7EB; padding: 2px 6px; border-radius: 4px;">Apple Pay</span>
            <span style="font-size: 0.75rem; font-weight: 700; color: #111827; background: #E5E7EB; padding: 2px 6px; border-radius: 4px;">Google Pay</span>
          </div>
        </div>

        <!-- Heavy Freight & LTL Delivery Assurance -->
        <div style="background: #F0FDF4; border: 1px solid #BBF7D0; border-radius: 10px; padding: 1rem 1.25rem; margin-bottom: 1.5rem;">
          <div style="display: flex; align-items: center; gap: 8px; font-weight: 700; color: #166534; font-size: 0.9rem; margin-bottom: 0.4rem;">
            <span>🚛 Heavy Cargo &amp; LTL Freight Delivery Guarantee:</span>
          </div>
          <ul style="margin: 0; padding-left: 1.2rem; font-size: 0.825rem; color: #15803D; line-height: 1.6;">
            <li><strong>Free Liftgate Service Included ($150 Value):</strong> Safe hydraulic lowering to your driveway/curb.</li>
            <li><strong>Delivery Appointment:</strong> Carrier calls 24 hours in advance to schedule exact drop-off time.</li>
            <li><strong>Fully Insured Transit:</strong> 100% covered against transit damage with instant replacement.</li>
          </ul>
        </div>

        <!-- Leafanoo Customer Guarantee Box -->
        <div class="product-trust-signals" style="background: #FFFFFF; border: 1px solid #E8E8E0; border-radius: 12px; padding: 1.5rem; margin-bottom: 2rem; box-shadow: 0 4px 14px rgba(0,0,0,0.02);">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 8px;">
            <div style="font-size: 0.85rem; font-weight: 700; color: #16a34a; text-transform: uppercase; letter-spacing: 0.05em;">
              🛡️ Leafanoo Buyer Protection &amp; Guarantee
            </div>
            <a href="tel:+18006142395" style="font-size: 0.85rem; font-weight: 700; color: #1A1A1A; text-decoration: none; display: flex; align-items: center; gap: 4px;">
              📞 Toll-Free Support: 1-800-614-2395
            </a>
          </div>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; font-size: 0.875rem;">
            <div style="display: flex; align-items: flex-start; gap: 0.6rem;">
              <span style="color: #16a34a; font-size: 1.1rem; flex-shrink: 0;">🚚</span>
              <div>
                <strong>Free US Nationwide Delivery</strong>
                <p style="font-size: 0.8rem; color: #666; margin: 0;">100% Free shipping + Curbside liftgate for freight</p>
              </div>
            </div>
            <div style="display: flex; align-items: flex-start; gap: 0.6rem;">
              <span style="color: #16a34a; font-size: 1.1rem; flex-shrink: 0;">↩️</span>
              <div>
                <strong>30-Day Money Back Guarantee</strong>
                <p style="font-size: 0.8rem; color: #666; margin: 0;">Zero restocking fees &amp; simple return process</p>
              </div>
            </div>
            <div style="display: flex; align-items: flex-start; gap: 0.6rem;">
              <span style="color: #16a34a; font-size: 1.1rem; flex-shrink: 0;">✓</span>
              <div>
                <strong>100% Factory Sealed &amp; Authentic</strong>
                <p style="font-size: 0.8rem; color: #666; margin: 0;">Verified GTIN &amp; full manufacturer warranty</p>
              </div>
            </div>
            <div style="display: flex; align-items: flex-start; gap: 0.6rem;">
              <span style="color: #16a34a; font-size: 1.1rem; flex-shrink: 0;">🔒</span>
              <div>
                <strong>256-Bit SSL Encrypted Checkout</strong>
                <p style="font-size: 0.8rem; color: #666; margin: 0;">Direct encrypted checkout protection</p>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- WoodMart Style Interactive Tabs Section -->
    <div class="product-tabs-wrapper" id="product-tabs-section" style="background: #FFFFFF; border: 1px solid #E8E8E0; border-radius: 16px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.03); margin-bottom: 3rem;">
      <!-- Tab Headers -->
      <div class="tabs-nav" style="display: flex; border-bottom: 2px solid #F0F0EB; background: #FAFAF7; overflow-x: auto; gap: 4px; padding: 4px 8px 0 8px;">
