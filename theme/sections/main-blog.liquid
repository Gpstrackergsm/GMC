<div class="blog-section section-padding" style="padding: 2.5rem 0 4rem 0;">
  <div class="container">
    {% render 'structured-data-breadcrumb' %}

    <div class="blog-header text-center" style="margin-bottom: 3rem; text-align: center;">
      <h1 class="blog-title" style="font-family: var(--font-heading-family, serif); font-size: 2.5rem; margin-bottom: 0.75rem;">
        {{ blog.title }}
      </h1>
      <p style="color: #666; font-size: 1.05rem;">Guides, product breakdowns, and everyday utility insights.</p>
    </div>

    {%- paginate blog.articles by 12 -%}
      <div class="articles-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 2rem;">
        {%- for article in blog.articles -%}
          <article class="article-card" style="background: #ffffff; border: 1px solid var(--color-border, #E8E8E0); border-radius: 10px; overflow: hidden; display: flex; flex-direction: column;">
            {%- if article.image -%}
              <div class="article-card__image" style="aspect-ratio: 16/9; overflow: hidden;">
                <a href="{{ article.url }}">
                  <img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.image.alt | default: article.title | escape }}" loading="lazy" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease;">
                </a>
              </div>
            {%- endif -%}

            <div class="article-card__content" style="padding: 1.5rem; flex: 1; display: flex; flex-direction: column;">
              <div class="article-meta" style="font-size: 0.8rem; color: #888; text-transform: uppercase; margin-bottom: 0.5rem;">
                {{ article.published_at | time_tag: format: 'date' }}
              </div>

              <h2 class="article-title" style="font-size: 1.25rem; font-weight: 700; line-height: 1.4; margin-bottom: 0.75rem;">
                <a href="{{ article.url }}" style="color: var(--color-text, #1A1A1A); text-decoration: none;">
                  {{ article.title }}
                </a>
              </h2>

              <div class="article-excerpt" style="font-size: 0.95rem; color: #666; line-height: 1.6; margin-bottom: 1.5rem; flex: 1;">
                {%- if article.excerpt.size > 0 -%}
                  {{ article.excerpt | strip_html | truncate: 120 }}
                {%- else -%}
                  {{ article.content | strip_html | truncate: 120 }}
                {%- endif -%}
              </div>

              <a href="{{ article.url }}" style="color: var(--color-primary, #2D6A4F); font-weight: 600; text-decoration: none; font-size: 0.9rem;">
                Read Article &rarr;
              </a>
            </div>
          </article>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <div class="pagination-wrapper" style="margin-top: 3.5rem; text-align: center;">
          {% render 'pagination', paginate: paginate %}
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Blog Articles Grid",
  "tag": "section",
  "class": "section-main-blog",
  "settings": []
}
{% endschema %}
