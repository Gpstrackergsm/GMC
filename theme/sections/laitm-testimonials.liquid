{%- liquid
  assign eyebrow = section.settings.eyebrow | default: '🇨🇦 VERIFIED CANADIAN PROPERTY OWNERS'
  assign heading = section.settings.heading | default: 'What Canadian Equipment Owners Say'
  assign sub = section.settings.subtext | default: 'Real feedback from acreage, estate, and property owners across all Canadian provinces.'
-%}

<section class="laitm-testi-section page-width" style="padding: 72px 0 64px;">
  <div class="laitm-testi-wrap">
    <div class="laitm-testi-head">
      <div style="display: inline-flex; align-items: center; gap: 8px; background: #EEF7EC; border: 1px solid #367C2B; padding: 6px 16px; border-radius: 9999px; margin-bottom: 12px;">
        <span style="font-size: 0.95rem;">🇨🇦</span>
        <span style="font-size: 0.8rem; font-weight: 800; color: #1E3F20; letter-spacing: 0.08em; text-transform: uppercase;">{{ eyebrow }}</span>
      </div>
      <h2 class="laitm-testi-title">{{ heading }}</h2>
      <p class="laitm-testi-sub">{{ sub }}</p>

      <!-- Canadian Trust Pillars Aggregate Banner -->
      <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 18px;">
        <span style="display: inline-flex; align-items: center; gap: 6px; background: #F8FAFC; border: 1px solid #E2E8F0; padding: 6px 14px; border-radius: 6px; font-size: 0.82rem; font-weight: 700; color: #1E293B;">
          ⭐️ <strong>4.9 / 5.0</strong> (680+ Canadian Buyers)
        </span>
        <span style="display: inline-flex; align-items: center; gap: 6px; background: #F8FAFC; border: 1px solid #E2E8F0; padding: 6px 14px; border-radius: 6px; font-size: 0.82rem; font-weight: 700; color: #1E293B;">
          🇨🇦 <strong>All Invoiced in CAD ($)</strong>
        </span>
        <span style="display: inline-flex; align-items: center; gap: 6px; background: #F8FAFC; border: 1px solid #E2E8F0; padding: 6px 14px; border-radius: 6px; font-size: 0.82rem; font-weight: 700; color: #166534;">
          🚚 <strong>Free Residential Liftgate Delivery</strong>
        </span>
        <span style="display: inline-flex; align-items: center; gap: 6px; background: #F8FAFC; border: 1px solid #E2E8F0; padding: 6px 14px; border-radius: 6px; font-size: 0.82rem; font-weight: 700; color: #1E293B;">
          🛡️ <strong>Zero Duty or Brokerage Fees</strong>
        </span>
      </div>
    </div>

    <div class="laitm-testi-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'testimonial' -%}
          {%- assign rating = block.settings.rating | default: 5 -%}
          <div class="laitm-testi-card" {{ block.shopify_attributes }}>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
              <div class="laitm-testi-stars" aria-label="{{ rating }} out of 5 stars">
                {%- for i in (1..5) -%}
                  <svg fill="{% if i <= rating %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24" width="18" height="18"><path d="M12 2l2.9 6.26L21 9.27l-4.5 4.39L17.8 21 12 17.77 6.2 21l1.3-7.34L3 9.27l6.1-1.01z"/></svg>
                {%- endfor -%}
              </div>
              <span style="display: inline-flex; align-items: center; gap: 4px; background: #E8F5EE; color: #166534; font-size: 0.72rem; font-weight: 800; padding: 3px 8px; border-radius: 9999px;">
                ✓ Verified Canadian Owner
              </span>
            </div>
            <p class="laitm-testi-quote">"{{ block.settings.quote }}"</p>
            <div class="laitm-testi-footer">
              <div style="display: flex; align-items: center; justify-content: space-between;">
                <span class="laitm-testi-name">{{ block.settings.author }}</span>
                <span style="font-size: 0.78rem; color: #166534; font-weight: 700;">🇨🇦 Canada Verified</span>
              </div>
              <span class="laitm-testi-meta">Direct Driveway Liftgate Delivery • Charged in CAD ($)</span>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <!-- Conversion Funnel Action Box -->
    <div style="background: linear-gradient(135deg, #1E3F20 0%, #0F2811 100%); border-radius: 12px; padding: clamp(1.5rem, 4vw, 2.25rem); border: 2px solid #FFDE00; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px; box-shadow: 0 12px 32px rgba(30,63,32,0.25); margin-bottom: 24px;">
      <div>
        <div style="display: inline-flex; align-items: center; gap: 8px; background: rgba(255,222,0,0.15); border: 1px solid #FFDE00; padding: 4px 12px; border-radius: 9999px; font-size: 0.75rem; font-weight: 800; color: #FFDE00; text-transform: uppercase; margin-bottom: 8px;">
          🇨🇦 Early Canadian Black Friday Doorbuster
        </div>
        <h3 style="font-size: clamp(1.25rem, 2.5vw, 1.6rem); font-weight: 800; color: #ffffff; margin: 0 0 6px;">
          Ready to Cut Your Mowing Time in Half?
        </h3>
        <p style="color: rgba(255,255,255,0.88); font-size: 0.95rem; margin: 0; max-width: 620px; line-height: 1.55;">
          Join 680+ Canadian property owners enjoying pristine lawns. Save up to 60% on heavy-duty riding tractors and zero-turns with complimentary residential hydraulic liftgate delivery directly to your driveway.
        </p>
      </div>
      <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
        <a href="/collections/all" style="background: #FFDE00; color: #111111; font-weight: 900; padding: 14px 28px; border-radius: 6px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 4px 16px rgba(255,222,0,0.4); text-transform: uppercase; font-size: 0.95rem; border: 2px solid #E6C800;">
          Shop Black Friday Canada Deals (CAD $) &rarr;
        </a>
        <a href="/policies/contact-information" style="background: rgba(255,255,255,0.12); color: #ffffff; font-weight: 700; padding: 14px 22px; border-radius: 6px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; border: 1px solid rgba(255,255,255,0.25); font-size: 0.92rem;">
          💬 24/7 Live Support
        </a>
      </div>
    </div>

    <div class="laitm-testi-strip" aria-hidden="true">
      <span>🇨🇦 Verified Canadian Acreage Owners</span>
      <span>·</span>
      <span>100% CAD Billing Transparency</span>
      <span>·</span>
      <span>Zero Customs or Brokerage Fees</span>
      <span>·</span>
      <span>Free Residential Hydraulic Liftgate Delivery</span>
    </div>
  </div>
</section>

<style>
  .laitm-testi-wrap {
    font-family: "Inter", -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
  .laitm-testi-head {
    text-align: center;
    margin-bottom: 36px;
  }
  .laitm-testi-title {
    font-size: clamp(1.6rem, 2.8vw, 2.3rem);
    font-weight: 800;
    color: #111111;
    margin: 0 0 10px;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .laitm-testi-sub {
    font-family: "Open Sans", sans-serif;
    font-size: 15px;
    color: #555555;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }
  .laitm-testi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin-bottom: 32px;
  }
  .laitm-testi-card {
    background: #ffffff;
    border: 1px solid #E2E2E2;
    border-radius: 10px;
    padding: 26px 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .laitm-testi-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    border-color: #367C2B;
  }
  .laitm-testi-stars {
    display: flex;
    gap: 2px;
    color: #FFDE00;
  }
  .laitm-testi-quote {
    font-size: 14.5px;
    color: #1c1a16;
    line-height: 1.65;
    margin: 0;
    flex: 1;
  }
  .laitm-testi-footer {
    display: flex;
    flex-direction: column;
    gap: 3px;
    border-top: 1px solid rgba(28,26,22,.08);
    padding-top: 14px;
  }
  .laitm-testi-name {
    font-weight: 800;
    font-size: 14px;
    color: #111111;
  }
  .laitm-testi-meta {
    font-size: 11.5px;
    color: #64748B;
  }
  .laitm-testi-strip {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    font-size: 13px;
    color: #1E3F20;
    font-weight: 600;
    background: #F0FDF4;
    border: 1px solid #BBF7D0;
    border-radius: 8px;
    padding: 14px 24px;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .laitm-testi-grid { grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "section-laitm-testimonials",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "🇨🇦 VERIFIED CANADIAN PROPERTY OWNERS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Canadian Equipment Owners Say"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Real feedback from acreage, estate, and property owners across all Canadian provinces."
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Canadian Testimonials Funnel",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
