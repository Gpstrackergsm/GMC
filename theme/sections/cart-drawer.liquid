<div id="CartDrawer" class="cart-drawer" role="dialog" aria-modal="true" aria-label="Shopping Cart" style="display: none; position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 1000;">
  <!-- Backdrop -->
  <div class="cart-drawer__backdrop" style="position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: rgba(0,0,0,0.5); backdrop-filter: blur(2px);"></div>

  <!-- Drawer Body -->
  <div class="cart-drawer__container" style="position: absolute; top: 0; right: 0; bottom: 0; width: 100%; max-width: 440px; background: #FFFFFF; display: flex; flex-direction: column; box-shadow: -4px 0 25px rgba(0,0,0,0.15); transform: translateX(100%); transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);">
    
    <!-- Drawer Header -->
    <div class="cart-drawer__header" style="display: flex; justify-content: space-between; align-items: center; padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--color-border, #E8E8E0);">
      <h2 style="font-size: 1.25rem; font-weight: 700; margin: 0; display: flex; align-items: center; gap: 0.5rem;">
        Your Cart (<span class="cart-drawer-count">{{ cart.item_count }}</span>)
      </h2>
      <button type="button" class="cart-drawer-close" aria-label="Close cart drawer" style="background: none; border: none; cursor: pointer; padding: 0.5rem; color: #555;">
        {% render 'icon-close' %}
      </button>
    </div>

    <!-- Free Shipping Bar -->
    <div class="cart-drawer__shipping-bar" style="background: #F0FDF4; padding: 0.85rem 1.25rem; border-bottom: 1px solid #DCFCE7; font-size: 0.85rem; color: #166534;">
      <div id="FreeShippingMessage" style="display: flex; align-items: center; justify-content: center; gap: 8px; font-weight: 700;">
        <span>🚚 Free Curbside Liftgate Delivery Included ($250 Value)</span>
      </div>
      <div style="font-size: 0.75rem; color: #15803D; margin-top: 4px; text-align: center;">
        Carrier schedules drop-off &amp; safely unloads to your driveway. Zero freight surcharges.
      </div>
    </div>

    <!-- Drawer Content / Items -->
    <div class="cart-drawer__content" style="flex: 1; overflow-y: auto; padding: 1.25rem 1.5rem;">
      <div id="CartDrawerItems">
        {%- if cart.item_count > 0 -%}
          {%- for item in cart.items -%}
            {% render 'cart-item', item: item %}
          {%- endfor -%}
        {%- else -%}
          <div class="cart-drawer__empty" style="text-align: center; padding: 3rem 0;">
            <p style="color: #666; margin-bottom: 1.5rem;">Your cart is empty.</p>
            <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary" style="display: inline-block; padding: 0.75rem 1.5rem; background: var(--color-primary, #16a34a); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600;">
              Start Shopping
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>

    <!-- Drawer Footer -->
    <div class="cart-drawer__footer" style="padding: 1.25rem 1.5rem; border-top: 1px solid var(--color-border, #E8E8E0); background: #FAFBF9;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; font-size: 1.15rem; font-weight: 800;">
        <span>Subtotal:</span>
        <span class="cart-drawer-subtotal" style="color: var(--color-primary, #16a34a);">{{ cart.total_price | money_with_currency }}</span>
      </div>

      <!-- 50% Deposit Banner in Cart -->
      <div style="background: #ECFDF5; border: 1.5px solid #10B981; border-radius: 8px; padding: 8px 12px; margin-bottom: 0.85rem; font-size: 0.82rem; color: #065F46; display: flex; flex-direction: column; gap: 4px;">
        <div style="display: flex; align-items: center; justify-content: space-between; font-weight: 800;">
          <span>🛡️ 50% Flexible Deposit Available</span>
          <span style="background: #059669; color: #fff; font-size: 0.68rem; padding: 2px 6px; border-radius: 4px; text-transform: uppercase;">Pay Half Today</span>
        </div>
        <span style="color: #047857; font-size: 0.76rem; line-height: 1.4;">Only 50% is due at checkout. The remaining 50% is billed only when your carrier liftgate tracking is confirmed.</span>
      </div>

      <a href="/checkout" class="btn btn--primary" style="display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; padding: 1.15rem; text-align: center; background: #16a34a; color: #ffffff; text-decoration: none; border-radius: 8px; font-weight: 800; font-size: 1.1rem; box-shadow: 0 4px 16px rgba(22,163,74,0.35); margin-bottom: 0.65rem; transition: all 0.2s;">
        <span>🔒 Proceed to Secure Checkout</span>
      </a>

      <!-- Accepted Cards Strip -->
      <div style="display: flex; flex-direction: column; align-items: center; gap: 4px; margin-bottom: 0.65rem; font-size: 0.74rem; color: #64748B;">
        <span style="color: #15803D; font-weight: 600;">✓ No extra freight or liftgate charges at checkout</span>
        <span>Guaranteed Safe &amp; Secure: Visa, MasterCard, Amex, Apple Pay</span>
      </div>

      <a href="{{ routes.cart_url }}" class="btn btn--secondary" style="display: block; width: 100%; padding: 0.55rem; text-align: center; border: 1px solid var(--color-border, #E8E8E0); background: #fff; color: var(--color-text, #1A1A1A); text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 0.85rem;">
        View Cart Details
      </a>
      <div style="margin-top: 1rem; padding-top: 0.85rem; border-top: 1px dashed #E0E2DE; display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; font-size: 0.75rem; color: #4B5563;">
        <div style="display: flex; align-items: center; gap: 0.35rem;">
          <span style="color: #16a34a; font-size: 0.9rem;">✓</span>
          <span><strong>Free US Delivery</strong></span>
        </div>
        <div style="display: flex; align-items: center; gap: 0.35rem;">
          <span style="color: #16a34a; font-size: 0.9rem;">✓</span>
          <span><strong>30-Day Returns</strong></span>
        </div>
        <div style="display: flex; align-items: center; gap: 0.35rem;">
          <span style="color: #16a34a; font-size: 0.9rem;">🔒</span>
          <span><strong>SSL Encrypted</strong></span>
        </div>
        <div style="display: flex; align-items: center; gap: 0.35rem;">
          <span style="color: #16a34a; font-size: 0.9rem;">📞</span>
          <span><strong>1-800-614-2395</strong></span>
        </div>
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Cart Drawer",
  "tag": "section",
  "class": "section-cart-drawer",
  "settings": []
}
{% endschema %}
