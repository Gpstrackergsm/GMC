<div class="template-404 section-padding text-center" style="padding: 5rem 1rem; text-align: center;">
  <div class="container" style="max-width: 600px; margin: 0 auto;">
    <p style="font-size: 1rem; font-weight: 700; color: var(--color-primary, #2D6A4F); text-transform: uppercase; letter-spacing: 2px; margin-bottom: 0.5rem;">
      Error 404
    </p>
    <h1 style="font-family: var(--font-heading-family, serif); font-size: 2.75rem; margin-bottom: 1rem; color: var(--color-text, #1A1A1A);">
      Page Not Found
    </h1>
    <p style="font-size: 1.05rem; color: #666; margin-bottom: 2rem; line-height: 1.6;">
      The page you are looking for might have been moved, renamed, or is temporarily unavailable.
    </p>

    <div style="margin-bottom: 2.5rem;">
      <form action="{{ routes.search_url }}" method="get" role="search" style="display: flex; gap: 0.5rem; max-width: 450px; margin: 0 auto;">
        <input
          type="search"
          name="q"
          placeholder="Search our catalog..."
          style="flex: 1; padding: 0.75rem 1rem; border: 1px solid var(--color-border, #E8E8E0); border-radius: 6px; font-size: 0.95rem;"
        >
        <button type="submit" class="btn btn--primary" style="padding: 0.75rem 1.25rem; background: var(--color-primary, #2D6A4F); color: #fff; border: none; border-radius: 6px; cursor: pointer;">
          Search
        </button>
      </form>
    </div>

    <a href="{{ routes.root_url }}" class="btn btn--primary" style="display: inline-block; padding: 0.85rem 2rem; background: var(--color-primary, #2D6A4F); color: #ffffff; text-decoration: none; border-radius: 6px; font-weight: 600;">
      Back to Homepage
    </a>
  </div>
</div>

{% schema %}
{
  "name": "404 Page",
  "tag": "section",
  "class": "section-main-404",
  "settings": []
}
{% endschema %}
