<div class="featured-products section-padding" style="padding: {{ section.settings.padding_top | default: 64 }}px 0 {{ section.settings.padding_bottom | default: 64 }}px 0; background-color: #ffffff;">
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.description != blank -%}
      <div class="section-header text-{{ section.settings.text_alignment | default: 'center' }}" style="margin-bottom: 3rem; text-align: {{ section.settings.text_alignment | default: 'center' }};">
        <span style="display: inline-block; font-size: 0.85rem; font-weight: 700; color: var(--color-primary, #2D6A4F); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.5rem;">
          {{ section.settings.caption | default: 'Handpicked For Quality' }}
        </span>
        {%- if section.settings.heading != blank -%}
          <h2 class="section-heading" style="font-family: var(--font-heading-family, serif); font-size: clamp(2rem, 3.5vw, 2.75rem); color: var(--color-text, #1A1A1A); margin-bottom: 0.75rem;">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="section-subheading" style="color: #666; font-size: 1.05rem; max-width: 680px; margin: 0 auto; line-height: 1.6;">
            {{ section.settings.description }}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- assign collection = section.settings.collection -%}
    {%- if collection == blank or collection.products.size == 0 -%}
      {%- assign collection = collections['all'] -%}
      {%- if collection == blank or collection.products.size == 0 -%}
        {%- assign collection = collections.first -%}
      {%- endif -%}
    {%- endif -%}
    {%- assign limit = section.settings.products_to_show | default: 8 -%}

    <div class="product-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.75rem;">
      {%- if collection != blank and collection.products.size > 0 -%}
        {%- for product in collection.products limit: limit -%}
          <div class="product-grid-item">
            {% render 'product-card',
              product: product,
              show_vendor: section.settings.show_vendor,
              show_quick_add: section.settings.show_quick_add,
              image_ratio: section.settings.image_ratio
            %}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- assign fallback_titles = "Anker Soundcore Space Q45 Wireless ANC Headphones,Ninja Foodi 8.5-qt 2-Basket Air Fryer XL,Philips Hue Smart 6ft Lightstrip Plus Base,Theragun Prime Percussive Muscle Therapy Device,Fellow Stagg EKG Pro Electric Pour-Over Kettle,Logitech MX Master 3S Wireless Performance Mouse,PetSafe Smart Feed Wi-Fi Automatic Pet Feeder,Anker 737 Power Bank 24000mAh 140W GaN" | split: "," -%}
        {%- assign fallback_prices = "$149.99,$179.99,$89.99,$299.00,$195.00,$99.99,$149.95,$149.99" | split: "," -%}
        {%- assign fallback_vendors = "Anker Soundcore,Ninja Kitchen,Philips Hue,Therabody,Fellow,Logitech,PetSafe,Anker" | split: "," -%}
        {%- assign fallback_badges = "Best Seller,Trending,Top Rated,Staff Pick,Popular,Must Have,Verified,Hot Deal" | split: "," -%}

        {%- for i in (0..7) -%}
          {%- assign p_title = fallback_titles[i] -%}
          {%- assign p_price = fallback_prices[i] -%}
          {%- assign p_vendor = fallback_vendors[i] -%}
          {%- assign p_badge = fallback_badges[i] -%}
          {%- if forloop.index > limit %}{% break %}{% endif -%}

          <article class="product-card" style="border: 1px solid #E8E8E0; border-radius: 12px; overflow: hidden; background: #ffffff; display: flex; flex-direction: column; transition: transform 0.25s, box-shadow 0.25s;">
            <div class="product-card__media-wrapper" style="position: relative; aspect-ratio: 1; background: #F8F9F7; display: flex; align-items: center; justify-content: center; padding: 1.5rem; overflow: hidden;">
              <span class="badge" style="position: absolute; top: 12px; left: 12px; background: #2D6A4F; color: #fff; font-size: 0.75rem; font-weight: 700; padding: 4px 10px; border-radius: 4px; z-index: 2;">
                {{ p_badge }}
              </span>
              <div style="font-size: 3rem; filter: drop-shadow(0 4px 12px rgba(0,0,0,0.1));">
                {%- case i -%}
                  {%- when 0 -%}🎧
                  {%- when 1 -%}🍳
                  {%- when 2 -%}💡
                  {%- when 3 -%}⚡
                  {%- when 4 -%}☕
                  {%- when 5 -%}🖱️
                  {%- when 6 -%}🐾
                  {%- else -%}🔋
                {%- endcase -%}
              </div>
            </div>
            <div class="product-card__info" style="padding: 1.25rem; display: flex; flex-direction: column; flex: 1; justify-content: space-between;">
              <div>
                <p style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: #777; margin-bottom: 0.25rem; font-weight: 600;">
                  {{ p_vendor }}
                </p>
                <h3 style="font-family: var(--font-body-family, sans-serif); font-size: 0.95rem; font-weight: 600; line-height: 1.4; margin-bottom: 0.5rem; color: #1A1A1A;">
                  {{ p_title }}
                </h3>
                <div style="display: flex; align-items: center; gap: 4px; margin-bottom: 0.75rem; font-size: 0.85rem; color: #D4A853;">
                  <span>★★★★★</span>
                  <span style="color: #888; font-size: 0.8rem;">(140+)</span>
                </div>
              </div>
              <div>
                <div style="font-size: 1.15rem; font-weight: 700; color: #2D6A4F; margin-bottom: 0.75rem;">
                  {{ p_price }}
                </div>
                <a href="/collections/all" class="btn btn--primary" style="width: 100%; justify-content: center; padding: 10px 16px; font-size: 0.875rem; border-radius: 6px;">
                  View Details &rarr;
                </a>
              </div>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_view_all -%}
      <div class="view-all-wrapper" style="text-align: center; margin-top: 3.5rem;">
        <a href="/collections/all" class="btn btn--primary btn--lg" style="display: inline-flex; align-items: center; gap: 8px; padding: 14px 36px; background: #2D6A4F; color: #ffffff; text-decoration: none; border-radius: 8px; font-weight: 600; box-shadow: 0 4px 16px rgba(45,106,79,0.3);">
          {{ section.settings.view_all_label | default: 'Explore All 1,000+ Products' }}
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 10h10M10 5l5 5-5 5"/></svg>
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Featured Products",
  "tag": "section",
  "class": "section-featured-products",
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "label": "Caption Tag",
      "default": "Handpicked For Quality"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trending Essentials"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Subheading",
      "default": "Carefully selected, practical everyday items engineered for durability, utility, and transparent value."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 16,
      "step": 2,
      "default": 8,
      "label": "Products to Show"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Desktop Columns"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Ratio",
      "options": [
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (3:4)" }
      ],
      "default": "square"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show Brand / Vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show Quick Add",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' Button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "'View All' Button Label",
      "default": "Explore All 1,000+ Products"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Featured Products",
      "settings": {
        "heading": "Trending Essentials"
      }
    }
  ]
}
{% endschema %}
