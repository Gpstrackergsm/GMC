<div class="cart-page-section section-padding" style="padding: 2.5rem 0 4rem 0;">
  <div class="container">
    <h1 style="font-family: var(--font-heading-family, serif); font-size: 2.25rem; margin-bottom: 2rem; text-align: center;">
      Your Cart
    </h1>

    {%- if cart.item_count > 0 -%}
      <style>
        @media (max-width: 768px) {
          .cart-page-grid { grid-template-columns: 1fr !important; gap: 1.5rem !important; }
          .cart-item-card { flex-direction: column !important; }
          .cart-item-card img { width: 100% !important; height: 200px !important; object-fit: cover !important; }
          .cart-summary { position: static !important; }
        }
      </style>
      <form action="{{ routes.cart_url }}" method="post" id="cart" class="cart-form">
        <div class="cart-page-grid" style="display: grid; grid-template-columns: 2fr 1fr; gap: 3rem; align-items: start;">

          <!-- Line Items — Mobile-friendly cards (no table) -->
          <div class="cart-items-list">
            {%- for item in cart.items -%}
              <div class="cart-item-card" data-line-item-key="{{ item.key }}"
                style="display: flex; gap: 1rem; padding: 1.25rem 0; border-bottom: 1px solid var(--color-border, #E8E8E0); align-items: flex-start;">

                {%- if item.image -%}
                  <a href="{{ item.url }}" style="flex-shrink: 0;">
                    <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}"
                      width="96" height="96"
                      style="border-radius: 8px; border: 1px solid var(--color-border, #E8E8E0); object-fit: cover; width: 96px; height: 96px;">
                  </a>
                {%- endif -%}

                <div style="flex: 1; min-width: 0;">
                  <a href="{{ item.url }}" style="font-weight: 700; color: #1A1A1A; text-decoration: none; font-size: 1rem; display: block; margin-bottom: 4px; line-height: 1.3;">
                    {{ item.product.title }}
                  </a>

                  <div style="font-size: 0.95rem; color: #367C2B; font-weight: 700; margin: 4px 0;">
                    {{ item.final_price | money }}
                  </div>

                  <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 10px; flex-wrap: wrap; gap: 8px;">
                    <div style="display: inline-flex; align-items: center; border: 1.5px solid #D1D5DB; border-radius: 6px; background: #fff; overflow: hidden; height: 36px;">
                      <button type="button" onclick="cartUpdateQty('{{ item.key }}', {{ item.quantity | minus: 1 }})"
                        style="width: 36px; height: 100%; border: none; background: #F3F4F6; font-size: 1.2rem; font-weight: 800; cursor: pointer;">−</button>
                      <span style="min-width: 40px; text-align: center; font-weight: 700; font-size: 0.95rem;">{{ item.quantity }}</span>
                      <button type="button" onclick="cartUpdateQty('{{ item.key }}', {{ item.quantity | plus: 1 }})"
                        style="width: 36px; height: 100%; border: none; background: #F3F4F6; font-size: 1.2rem; font-weight: 800; cursor: pointer;">+</button>
                    </div>
                    <div style="text-align: right;">
                      <div style="font-size: 0.72rem; color: #9CA3AF; text-transform: uppercase;">Total</div>
                      <div style="font-weight: 800; font-size: 1rem; color: #111827;">{{ item.final_line_price | money }}</div>
                    </div>
                  </div>

                  <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0"
                    style="display: inline-block; margin-top: 8px; font-size: 0.8rem; color: #EF4444; text-decoration: underline;">
                    Remove
                  </a>
                </div>
              </div>
            {%- endfor -%}

            <script>
              function cartUpdateQty(key, qty) {
                fetch('/cart/change.js', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ id: key, quantity: Math.max(0, qty) })
                }).then(() => window.location.reload());
              }
            </script>

            <div style="margin-top: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
              <a href="{{ routes.all_products_collection_url }}" style="color: #367C2B; font-weight: 700; text-decoration: underline; font-size: 0.95rem;">
                &larr; Continue Shopping
              </a>
              <button type="submit" name="update" class="btn" style="background: transparent; border: 1px solid var(--color-border, #E2E2E2); padding: 0.6rem 1.25rem; border-radius: 6px; cursor: pointer; font-size: 0.9rem;">
                Update Cart
              </button>
            </div>
          </div>

          <!-- Order Summary Sidebar -->
          <div class="cart-summary" style="background: #FFFFFF; border: 1px solid var(--color-border, #E2E2E2); border-radius: 8px; padding: 1.75rem;">
            <h2 style="font-size: 1.25rem; margin-bottom: 1.25rem; border-bottom: 1px solid var(--color-border, #E2E2E2); padding-bottom: 0.75rem;">
              Order Summary
            </h2>

            <!-- Order Summary Subtotal -->
            <div style="background: #F7F7F7; border: 1.5px solid #367C2B; border-radius: 6px; padding: 12px 14px; margin-bottom: 1rem;">
              <div style="display: flex; justify-content: space-between; align-items: baseline;">
                <span style="font-size: 0.95rem; font-weight: 800; color: #1E3F20; text-transform: uppercase;">Total:</span>
                <span style="font-size: 1.35rem; font-weight: 900; color: #367C2B;">{{ cart.total_price | money }}</span>
              </div>
            </div>

            <div style="background: #F4F8F4; border: 1px solid #D1E5D0; border-radius: 6px; padding: 0.75rem 1rem; margin-bottom: 1.25rem;">
              <div style="font-size: 0.82rem; font-weight: 700; color: #1E3F20; display: flex; align-items: center; gap: 6px;">
                <span>🚚 Free Liftgate Curbside Delivery</span>
              </div>
              <p style="font-size: 0.75rem; color: #367C2B; margin: 4px 0 0 0; line-height: 1.35;">
                Carrier calls to schedule drop-off &amp; safely unloads to your driveway. Zero hidden shipping fees at checkout.
              </p>
            </div>

            {%- if section.settings.show_cart_note -%}
              <div style="margin-bottom: 1.5rem;">
                <label for="Cart-note" style="display: block; font-size: 0.85rem; font-weight: 500; margin-bottom: 0.5rem;">
                  Order Instructions / Notes:
                </label>
                <textarea
                  name="note"
                  id="Cart-note"
                  rows="3"
                  style="width: 100%; border: 1px solid var(--color-border, #E2E2E2); border-radius: 6px; padding: 0.5rem; font-size: 0.85rem;"
                  placeholder="Special instructions for your order..."
                >{{ cart.note }}</textarea>
              </div>
            {%- endif -%}

            <button
              type="submit"
              name="checkout"
              class="btn btn--primary"
              style="width: 100%; padding: 1.15rem; background: #FFDE00; color: #111111; font-size: 1.05rem; font-weight: 800; border: 2px solid #E6C800; border-radius: 6px; cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 14px rgba(255,222,0,0.45); text-transform: uppercase;"
              onmouseover="this.style.background='#E6C800'"
              onmouseout="this.style.background='#FFDE00'"
            >
              🔒 Proceed to Checkout ({{ cart.total_price | money }}) &rarr;
            </button>

            <div style="margin-top: 1.5rem; text-align: center; font-size: 0.8rem; color: #777;">
              <p>🔒 Guaranteed Safe & Secure Checkout</p>
            </div>
          </div>

        </div>
      </form>
    {%- else -%}
      <div style="text-align: center; padding: 4rem 1rem;">
        <p style="font-size: 1.2rem; color: #666; margin-bottom: 1.5rem;">Your cart is currently empty.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary" style="display: inline-block; padding: 0.85rem 2rem; background: #FFDE00; color: #111111; border: 1px solid #E6C800; text-decoration: none; border-radius: 6px; font-weight: 800; text-transform: uppercase;">
          Start Shopping
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Cart Page",
  "tag": "section",
  "class": "section-main-cart",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_cart_note",
      "label": "Show Cart Note Field",
      "default": true
    }
  ]
}
{% endschema %}
