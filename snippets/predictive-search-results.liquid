{%- comment -%}
  Snippet: predictive-search-results.liquid
  Search suggestions dropdown. Rendered server-side fallback;
  the JS module (predictive-search.js) dynamically re-renders.
  Accepts:
  - predictive_search {Object} The Shopify predictive search result object.
  - search_terms      {String} The current search query.
{%- endcomment -%}

<div
  class="predictive-search-results"
  id="predictive-search-results"
  role="listbox"
  aria-label="Search suggestions"
  tabindex="-1"
>
  {%- if predictive_search.performed -%}

    {%- if predictive_search.resources.products.size > 0 -%}
      <div class="predictive-search__section">
        <h2 class="predictive-search__section-title" id="predictive-search-products-heading">Products</h2>
        <ul
          class="predictive-search__list"
          role="group"
          aria-labelledby="predictive-search-products-heading"
        >
          {%- for product in predictive_search.resources.products -%}
            <li
              class="predictive-search__item predictive-search__item--product"
              role="option"
              aria-selected="false"
            >
              <a href="{{ product.url }}" class="predictive-search__link" tabindex="-1">
                <div class="predictive-search__product-image">
                  {%- if product.featured_image -%}
                    <img
                      src="{{ product.featured_image | image_url: width: 80 }}"
                      alt="{{ product.featured_image.alt | default: product.title | escape }}"
                      width="80"
                      height="80"
                      loading="lazy"
                      decoding="async"
                    >
                  {%- else -%}
                    <div class="predictive-search__image-placeholder" aria-hidden="true">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="24" height="24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                    </div>
                  {%- endif -%}
                </div>
                <div class="predictive-search__product-info">
                  <span class="predictive-search__product-title">{{ product.title | escape }}</span>
                  <span class="predictive-search__product-price">{{ product.price | money }}</span>
                </div>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- if predictive_search.resources.collections.size > 0 -%}
      <div class="predictive-search__section">
        <h2 class="predictive-search__section-title" id="predictive-search-collections-heading">Collections</h2>
        <ul
          class="predictive-search__list"
          role="group"
          aria-labelledby="predictive-search-collections-heading"
        >
          {%- for coll in predictive_search.resources.collections -%}
            <li
              class="predictive-search__item predictive-search__item--collection"
              role="option"
              aria-selected="false"
            >
              <a href="{{ coll.url }}" class="predictive-search__link" tabindex="-1">
                {%- render 'icon-chevron-right' -%}
                <span class="predictive-search__collection-title">{{ coll.title | escape }}</span>
                <span class="predictive-search__collection-count">({{ coll.products_count }} products)</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- if predictive_search.resources.pages.size > 0 -%}
      <div class="predictive-search__section">
        <h2 class="predictive-search__section-title" id="predictive-search-pages-heading">Pages</h2>
        <ul
          class="predictive-search__list"
          role="group"
          aria-labelledby="predictive-search-pages-heading"
        >
          {%- for p in predictive_search.resources.pages -%}
            <li
              class="predictive-search__item predictive-search__item--page"
              role="option"
              aria-selected="false"
            >
              <a href="{{ p.url }}" class="predictive-search__link" tabindex="-1">
                {%- render 'icon-search' -%}
                <span class="predictive-search__page-title">{{ p.title | escape }}</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- if predictive_search.resources.products.size == 0
        and predictive_search.resources.collections.size == 0
        and predictive_search.resources.pages.size == 0 -%}
      <div class="predictive-search__empty">
        <p>No results found for <strong>{{ search_terms | escape }}</strong></p>
      </div>
    {%- endif -%}

    <div class="predictive-search__footer">
      <a href="/search?q={{ search_terms | url_encode }}&type=product" class="predictive-search__view-all btn btn-secondary">
        View all results for &ldquo;{{ search_terms | escape }}&rdquo;
        {%- render 'icon-chevron-right' -%}
      </a>
    </div>

  {%- endif -%}
</div>
