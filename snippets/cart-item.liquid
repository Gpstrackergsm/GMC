{%- comment -%}
  Snippet: cart-item.liquid
  High-Converting Mower Cart Line Item with 50% Deposit Breakdown & Working Stepper
{%- endcomment -%}

<div
  class="cart-item"
  data-cart-item
  data-line="{{ index | default: forloop.index }}"
  data-key="{{ item.key }}"
  style="display: flex; gap: 14px; padding: 16px 0; border-bottom: 1px solid #E8E8E0; align-items: flex-start; position: relative;"
>
  <!-- Product Image -->
  <div style="flex: 0 0 76px; width: 76px; height: 76px; border-radius: 8px; border: 1px solid #E8E8E0; overflow: hidden; background: #FFFFFF; display: flex; align-items: center; justify-content: center;">
    <a href="{{ item.url }}" style="display: block; width: 100%; height: 100%;">
      {%- if item.image -%}
        <img
          src="{{ item.image | image_url: width: 160 }}"
          alt="{{ item.image.alt | default: item.product.title | escape }}"
          width="76"
          height="76"
          loading="lazy"
          style="width: 100%; height: 100%; object-fit: contain; display: block;"
        >
      {%- else -%}
        <div style="width: 100%; height: 100%; background: #F3F4F6; display: flex; align-items: center; justify-content: center; color: #9CA3AF; font-size: 0.75rem;">
          Mower
        </div>
      {%- endif -%}
    </a>
  </div>

  <!-- Item Details -->
  <div style="flex: 1; min-width: 0;">
    <!-- Title & Remove -->
    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; margin-bottom: 4px;">
      <h3 style="font-size: 0.92rem; font-weight: 700; color: #111827; margin: 0; line-height: 1.35;">
        <a href="{{ item.url }}" style="color: inherit; text-decoration: none;">{{ item.product.title | escape }}</a>
      </h3>
      <button
        type="button"
        class="cart-item-remove-btn"
        data-cart-remove
        data-key="{{ item.key }}"
        data-line="{{ index | default: forloop.index }}"
        aria-label="Remove {{ item.product.title | escape }} from cart"
        style="background: none; border: none; color: #9CA3AF; cursor: pointer; padding: 0 4px; font-size: 1.25rem; line-height: 1; transition: color 0.15s; flex-shrink: 0;"
        onmouseover="this.style.color='#EF4444'"
        onmouseout="this.style.color='#9CA3AF'"
      >
        &times;
      </button>
    </div>

    <!-- 50% Flexible Delivery Deposit Box -->
    <div style="background: #ECFDF5; border: 1px solid #10B981; border-radius: 8px; padding: 7px 10px; margin: 8px 0; font-size: 0.8rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 3px;">
        <span style="color: #065F46; font-weight: 800; display: flex; align-items: center; gap: 4px;">
          <span>🛡️ 50% Deposit Option:</span>
        </span>
        <strong style="color: #047857; font-size: 0.9rem;">{{ item.final_line_price | divided_by: 2 | money }} Due Today</strong>
      </div>
      <div style="display: flex; justify-content: space-between; align-items: center; color: #047857; font-size: 0.74rem;">
        <span>Remaining 50% balance on carrier delivery:</span>
        <span style="font-weight: 600;">{{ item.final_line_price | divided_by: 2 | money }}</span>
      </div>
    </div>

    <!-- Quantity Stepper & Full Line Price -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 6px;">
      <!-- Accessible Working Stepper -->
      <div style="display: inline-flex; align-items: center; border: 1.5px solid #D1D5DB; border-radius: 6px; background: #FFFFFF; overflow: hidden; height: 32px;">
        <button
          type="button"
          class="cart-qty-btn cart-qty-minus"
          data-action="decrement"
          data-key="{{ item.key }}"
          data-current-qty="{{ item.quantity }}"
          aria-label="Decrease quantity"
          style="width: 32px; height: 100%; border: none; background: #F3F4F6; color: #1F2937; font-size: 1.15rem; font-weight: 800; cursor: pointer; display: flex; align-items: center; justify-content: center; user-select: none; transition: background 0.15s;"
          onmouseover="this.style.background='#E5E7EB'"
          onmouseout="this.style.background='#F3F4F6'"
        >
          &minus;
        </button>
        <span
          class="cart-qty-value"
          style="min-width: 36px; padding: 0 4px; text-align: center; font-size: 0.9rem; font-weight: 800; color: #111827;"
        >
          {{ item.quantity }}
        </span>
        <button
          type="button"
          class="cart-qty-btn cart-qty-plus"
          data-action="increment"
          data-key="{{ item.key }}"
          data-current-qty="{{ item.quantity }}"
          aria-label="Increase quantity"
          style="width: 32px; height: 100%; border: none; background: #F3F4F6; color: #1F2937; font-size: 1.15rem; font-weight: 800; cursor: pointer; display: flex; align-items: center; justify-content: center; user-select: none; transition: background 0.15s;"
          onmouseover="this.style.background='#E5E7EB'"
          onmouseout="this.style.background='#F3F4F6'"
        >
          &#43;
        </button>
      </div>

      <!-- Total Mower Price -->
      <div style="text-align: right;">
        <span style="font-size: 0.72rem; color: #6B7280; display: block; text-transform: uppercase;">Total Value:</span>
        <strong style="font-size: 0.95rem; color: #111827;">{{ item.final_line_price | money }}</strong>
      </div>
    </div>
  </div>
</div>
