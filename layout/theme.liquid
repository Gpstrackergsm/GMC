<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height, minimum-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="google-site-verification" content="oOM47nNj4tnMVhXk9ZU9rzJ73nnerjvdC2hH2a5WleY" />
  <!-- Google tag (gtag.js) - Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-SZTQVS9EL0"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-SZTQVS9EL0');
  </script>

  <!-- Google tag (gtag.js) - Google Ads -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18473205895"></script>
  <script>
    gtag('config', 'AW-18473205895');
  </script>

  <!-- Event snippet for Purchase (1) conversion page (Fires strictly on Order Confirmation) -->
  {%- if first_time_accessed or request.page_type == 'thank_you' or page_title contains 'Thank you' or page_title contains 'Order' -%}
  <script>
    gtag('event', 'conversion', {
        'send_to': 'AW-18473205895/FnnzCKuG6ocdEIeB2-hE',
        'transaction_id': '{{ checkout.order_id | default: checkout.id | default: "" }}'
    });
  </script>
  {%- endif -%}

  <!-- GA4 & Google Ads Enhanced eCommerce Funnel Tracking -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // 1. View Item (Product Pages)
      {% if template contains 'product' and product %}
        if (typeof gtag === 'function') {
          gtag('event', 'view_item', {
            currency: '{{ cart.currency.iso_code }}',
            value: {{ product.selected_or_first_available_variant.price | divided_by: 100.0 }},
            items: [{
              item_id: '{{ product.selected_or_first_available_variant.sku | default: product.id }}',
              item_name: {{ product.title | json }},
              item_brand: {{ product.vendor | json }},
              item_category: {{ product.type | json }},
              price: {{ product.selected_or_first_available_variant.price | divided_by: 100.0 }},
              quantity: 1
            }]
          });
        }
      {% endif %}

      // 2. Add to Cart (Listener on cart:item-added)
      document.addEventListener('cart:item-added', function(e) {
        if (typeof gtag === 'function' && e.detail) {
          var item = e.detail;
          var itemPrice = (item.price || 0) / 100.0;
          gtag('event', 'add_to_cart', {
            currency: '{{ cart.currency.iso_code }}',
            value: itemPrice * (item.quantity || 1),
            items: [{
              item_id: item.sku || item.id,
              item_name: item.title,
              price: itemPrice,
              quantity: item.quantity || 1
            }]
          });
        }
      });

      // 3. Begin Checkout (Listener on all checkout links and buttons)
      document.addEventListener('click', function(e) {
        var btn = e.target.closest('a[href*="/checkout"], button[name="checkout"], input[name="checkout"], .btn-checkout, #DirectBuyNowBtn');
        if (btn && typeof gtag === 'function') {
          gtag('event', 'begin_checkout', {
            currency: '{{ cart.currency.iso_code }}',
            value: {{ cart.total_price | divided_by: 100.0 }}
          });
        }
      }, true);
    });
  </script>
  <script>
    (function() {
      var p = window.location.pathname.toLowerCase().replace(/\/+$/, '');
      var m = {
        '/policies/refund-policy': '/pages/refund-policy',
        '/policies/shipping-policy': '/pages/shipping-policy',
        '/policies/terms-of-service': '/pages/terms-of-service',
        '/policies/payment-policy': '/pages/payment-policy',
        '/policies/privacy-policy': '/pages/privacy-policy',
        '/policies/contact-information': '/pages/contact-us',
        '/policies/legal-notice': '/pages/terms-of-service',
        '/pages/contact': '/pages/contact-us',
        '/contact': '/pages/contact-us',
        '/contact-us': '/pages/contact-us',
        '/pages/about-us': '/pages/about',
        '/about': '/pages/about',
        '/about-us': '/pages/about',
        '/pages/faq': '/#shopify-section-faq-accordion',
        '/pages/faqs': '/#shopify-section-faq-accordion',
        '/faq': '/#shopify-section-faq-accordion',
        '/faqs': '/#shopify-section-faq-accordion',
        '/shipping': '/pages/shipping-policy',
        '/privacy': '/pages/privacy-policy',
        '/terms': '/pages/terms-of-service',
        '/refund': '/pages/refund-policy',
        '/returns': '/pages/refund-policy',
        '/payment': '/pages/payment-policy',
        '/billing': '/pages/payment-policy'
      };
      if (m[p]) {
        window.location.replace(m[p]);
      }
    })();
  </script>

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- else -%}
    <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon-32x32.png' | asset_url }}">
    <link rel="icon" type="image/png" sizes="180x180" href="{{ 'favicon.png' | asset_url }}">
    <link rel="apple-touch-icon" href="{{ 'favicon.png' | asset_url }}">
  {%- endif -%}

  <!-- Title & meta description handled by meta-tags snippet below -->

  <!-- Canonical & hreflang -->
  <link rel="canonical" href="{{ canonical_url }}">

  <!-- Preconnect hints for performance -->
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
  <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="dns-prefetch" href="https://cdn.shopify.com">

  <!-- Google Fonts: Inter & Open Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Open+Sans:wght@400;500;600;700;800&display=swap">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Open+Sans:wght@400;500;600;700;800&display=swap" media="print" onload="this.media='all'">
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Open+Sans:wght@400;500;600;700;800&display=swap">
  </noscript>

  <!-- Theme stylesheet -->
  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <!-- Shopify required header content (must appear before closing head tag) -->
  {{ content_for_header }}

  <!-- Critical CSS custom properties from theme settings -->
  <style>
    :root {
      --color-primary: {{ settings.color_primary | default: '#367C2B' }};
      --color-primary-dark: #275e20;
      --color-primary-deep: #1E3F20;
      --color-primary-contrast: {{ settings.color_primary_contrast | default: '#FFFFFF' }};
      --color-secondary: {{ settings.color_secondary | default: '#FFDE00' }};
      --color-accent: {{ settings.color_accent | default: '#FFDE00' }};
      --color-accent-hover: #e6c800;
      --color-background: {{ settings.color_background | default: '#FFFFFF' }};
      --color-bg-subtle: #F7F7F7;
      --color-text: {{ settings.color_text | default: '#111111' }};
      --color-text-muted: #555555;
      --color-border: {{ settings.color_border | default: '#E2E2E2' }};
      --color-error: {{ settings.color_error | default: '#D92D20' }};
      --color-success: {{ settings.color_success | default: '#367C2B' }};
      --font-heading: "Inter", -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --font-body: "Open Sans", "Inter", -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --font-heading-family: "Inter", -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --font-body-family: "Open Sans", "Inter", -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --font-size-base: {{ settings.font_size_base | default: 16 }}px;
      --header-height: 0px;
      --announcement-bar-height: 0px;
    }
    {%- if settings.custom_css != blank -%}
      {{ settings.custom_css }}
    {%- endif -%}
  </style>

  <!-- Meta tags snippet (OG, Twitter card, etc.) -->
  {%- render 'meta-tags' -%}

  <!-- Structured data: Organization / WebSite -->
  {%- render 'structured-data-organization' -%}

  <script>
    // Remove no-js class immediately so CSS transitions apply correctly
    document.documentElement.classList.remove('no-js');
    document.documentElement.classList.add('js');

    // Global theme namespace
    window.Deere = window.Deere || {};
    window.Deere.settings = {
      cartType: {{ settings.cart_type | json }},
      enableAnimations: {{ settings.enable_animations | json }},
      moneyFormat: {{ shop.money_format | json }},
      moneyWithCurrencyFormat: {{ shop.money_with_currency_format | json }},
      currency: {{ cart.currency.iso_code | json }},
      locale: {{ request.locale.iso_code | json }},
      shopUrl: {{ shop.url | json }},
      routes: {
        root: '/',
        cartUrl: '/cart',
        cartAddUrl: '/cart/add.js',
        cartChangeUrl: '/cart/change.js',
        cartUpdateUrl: '/cart/update.js',
        cartClearUrl: '/cart/clear.js',
        searchUrl: '/search',
        predictiveSearchUrl: '/search/suggest'
      }
    };
  </script>

  <!-- Google Tag Manager -->
  {%- if settings.gtm_id != blank -%}
    <script>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','{{ settings.gtm_id | escape }}');
    </script>
  {%- endif -%}
</head>

<body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}--{{ template.suffix }}{% endif %} page-{{ page_title | handle }}{% if settings.enable_animations %} animations-enabled{% endif %}">

  <!-- Google Tag Manager (noscript fallback) -->
  {%- if settings.gtm_id != blank -%}
    <!-- GTM noscript: requires JavaScript enabled for full tracking functionality -->
    <noscript>
      <iframe src="https://www.googletagmanager.com/ns.html?id={{ settings.gtm_id | escape }}"
              height="0" width="0" style="display:none;visibility:hidden"
              title="Google Tag Manager"></iframe>
    </noscript>
  {%- endif -%}

  <!-- Skip to main content for accessibility (keyboard users) -->
  <a class="skip-to-content-link" href="#MainContent">
    {{ 'accessibility.skip_to_content' | t }}
  </a>

  <!-- Announcement bar section -->
  {%- section 'announcement-bar' -%}

  <!-- Site header section -->
  {%- section 'header' -%}

  <!-- Main content area — target for skip-link and screen reader navigation -->
  <main id="MainContent" class="main-content" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  <!-- Site footer section -->
  {%- section 'footer' -%}

  <!-- Cart drawer section -->
  {%- section 'cart-drawer' -%}

  <!-- Overlay for cart drawer and navigation -->
  <div id="CartOverlay"
       class="overlay overlay--cart"
       aria-hidden="true"
       data-overlay="cart"></div>

  <div id="NavOverlay"
       class="overlay overlay--nav"
       aria-hidden="true"
       data-overlay="nav"></div>

  <!-- Predictive search modal -->
  <div id="SearchModal"
       class="search-modal"
       role="dialog"
       aria-modal="true"
       aria-label="{{ 'search.placeholder' | t }}"
       aria-hidden="true"
       hidden>
    <div class="search-modal__overlay" id="SearchModalOverlay" data-search-modal-close></div>
    <div class="search-modal__inner">
      <div class="search-modal__header">
        <form action="{{ routes.search_url }}" method="get" class="search-modal__form" role="search">
          <input type="hidden" name="type" value="product,article,page">
          <label for="SearchModalInput" class="visually-hidden">{{ 'search.placeholder' | t }}</label>
          <div class="search-modal__input-wrapper">
            <svg class="search-modal__input-icon" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M9 17A8 8 0 1 0 9 1a8 8 0 0 0 0 16z" stroke="currentColor" stroke-width="1.5"/>
              <path d="m19 19-4.35-4.35" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            <input
              type="search"
              name="q"
              id="SearchModalInput"
              class="search-modal__input"
              placeholder="{{ 'search.placeholder' | t }}"
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
              data-predictive-search-input
            >
          </div>
          <button type="submit" class="search-modal__submit button button--icon" aria-label="{{ 'search.search' | t }}">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M9 17A8 8 0 1 0 9 1a8 8 0 0 0 0 16z" stroke="currentColor" stroke-width="1.5"/>
              <path d="m19 19-4.35-4.35" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </button>
        </form>
        <button
          type="button"
          class="search-modal__close button button--icon"
          aria-label="{{ 'general.close' | t }}"
          data-search-modal-close
        >
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M15 5 5 15M5 5l10 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
      <div class="search-modal__results"
           id="SearchModalResults"
           aria-live="polite"
           aria-atomic="true"
           data-predictive-search-results></div>
    </div>
  </div>

  <!-- Toast notification system -->
  <div id="ToastNotification"
       class="toast-notification"
       role="status"
       aria-live="polite"
       aria-atomic="true"
       aria-hidden="true">
    <div class="toast-notification__content">
      <span class="toast-notification__icon" aria-hidden="true"></span>
      <span class="toast-notification__message" id="ToastMessage"></span>
    </div>
    <button type="button"
            class="toast-notification__close"
            aria-label="{{ 'general.close' | t }}">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M12 4 4 12M4 4l8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <!-- Floating Live Support Widget -->
  <div id="FloatingSupportWidget" style="position: fixed; bottom: 24px; right: 24px; z-index: 9999; font-family: var(--font-body-family, sans-serif);">
    <!-- Support Trigger Button -->
    <button
      type="button"
      id="SupportTriggerBtn"
      onclick="toggleSupportModal()"
      style="display: flex; align-items: center; gap: 8px; background: #367C2B; color: #FFFFFF; border: 2px solid #FFDE00; border-radius: 50px; padding: 12px 22px; font-size: 0.925rem; font-weight: 800; cursor: pointer; box-shadow: 0 4px 20px rgba(54,124,43,0.4); transition: transform 0.2s, background 0.2s;"
      aria-label="Open Live Support"
    >
      <span style="font-size: 1.2rem;">💬</span>
      <span>Equipment Specialist Live</span>
    </button>

    <!-- Support Modal / Popup -->
    <div
      id="SupportModalCard"
      style="display: none; position: absolute; bottom: 65px; right: 0; width: 340px; background: #FFFFFF; border: 1px solid #E2E2E2; border-radius: 8px; box-shadow: 0 10px 30px rgba(0,0,0,0.15); overflow: hidden; animation: supportSlideIn 0.25s ease;"
    >
      <div style="background: #1E3F20; color: #FFFFFF; padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #FFDE00;">
        <div>
          <div style="font-weight: 800; font-size: 1.05rem; letter-spacing: -0.01em;">Deere Turf Equipment Support</div>
          <div style="font-size: 0.78rem; color: #FFDE00; font-weight: 600;">Authorized Commercial Support</div>
        </div>
        <button
          type="button"
          onclick="toggleSupportModal()"
          style="background: transparent; border: none; color: #FFFFFF; font-size: 1.25rem; cursor: pointer; line-height: 1;"
          aria-label="Close"
        >&times;</button>
      </div>

      <div style="padding: 18px 20px; display: flex; flex-direction: column; gap: 14px;">
        <div style="font-size: 0.85rem; color: #4B5563; line-height: 1.5;">
          Have questions about <strong>delivery scheduling</strong>, <strong>liftgate unloading</strong>, or <strong>equipment specs</strong>? We're on call!
        </div>

        <!-- Phone Action -->
        <a
          href="/pages/contact-us"
          style="display: flex; align-items: center; gap: 12px; padding: 12px; background: #F7F7F7; border: 1px solid #E2E2E2; border-radius: 6px; text-decoration: none; color: #111111; transition: background 0.15s;"
        >
          <span style="font-size: 1.3rem;">💬</span>
          <div>
            <div style="font-weight: 800; font-size: 0.9rem;">24/7 Live Support &amp; Chat</div>
            <div style="font-size: 0.8rem; color: #367C2B; font-weight: 700;">Instant Online Help (Available Now)</div>
          </div>
        </a>

        <!-- Email Action -->
        <a
          href="mailto:contact@mowerhaven.com"
          style="display: flex; align-items: center; gap: 12px; padding: 12px; background: #F7F7F7; border: 1px solid #E2E2E2; border-radius: 6px; text-decoration: none; color: #111111; transition: background 0.15s;"
        >
          <span style="font-size: 1.3rem;">✉️</span>
          <div>
            <div style="font-weight: 800; font-size: 0.9rem;">Email Dealer Specialist</div>
            <div style="font-size: 0.8rem; color: #4B5563;">contact@mowerhaven.com</div>
          </div>
        </a>

        <!-- Quick Freight Reassurance -->
        <div style="background: #F4F8F4; border: 1px solid #D1E5D0; border-radius: 6px; padding: 10px 12px; font-size: 0.78rem; color: #1E3F20; line-height: 1.4;">
          🚚 <strong>100% Free US Shipping</strong> with hydraulic liftgate delivery included for all mowers &amp; turf machines.
        </div>
      </div>
    </div>
  </div>

  <script>
    function toggleSupportModal() {
      var modal = document.getElementById('SupportModalCard');
      if (modal) {
        modal.style.display = modal.style.display === 'none' || modal.style.display === '' ? 'block' : 'none';
      }
    }
  </script>

  <!-- Custom JavaScript from theme settings -->
  {%- if settings.custom_js != blank -%}
    <script>{{ settings.custom_js }}</script>
  {%- endif -%}

  <!-- Theme JavaScript (deferred, non-render-blocking) -->
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  <script src="{{ 'cart-drawer.js' | asset_url }}" defer></script>

</body>
</html>
