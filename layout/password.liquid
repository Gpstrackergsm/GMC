<!doctype html>
<html class="no-js full-height" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_primary | default: '#2D6A4F' }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ shop.name }} &ndash; Opening Soon</title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {{ content_for_header }}

    <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}" media="print" onload="this.media='all'">
    <noscript>{{ 'theme.css' | asset_url | stylesheet_tag }}</noscript>

    <style>
      .password-page {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
        text-align: center;
        background-color: var(--color-bg, #FAFAF7);
        color: var(--color-text, #1A1A1A);
      }
      .password-card {
        max-width: 500px;
        width: 100%;
        background: #ffffff;
        border: 1px solid var(--color-border, #E8E8E0);
        border-radius: 12px;
        padding: 2.5rem 2rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
      }
      .password-logo {
        font-family: var(--font-heading-family, 'Playfair Display', serif);
        font-size: 2rem;
        font-weight: 700;
        color: var(--color-primary, #2D6A4F);
        margin-bottom: 1rem;
      }
      .password-heading {
        font-size: 1.5rem;
        margin-bottom: 0.75rem;
      }
      .password-subtext {
        color: #666;
        margin-bottom: 2rem;
        font-size: 0.95rem;
        line-height: 1.5;
      }
      .password-form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }
      .password-input {
        padding: 0.75rem 1rem;
        border: 1px solid var(--color-border, #E8E8E0);
        border-radius: 6px;
        font-size: 1rem;
        width: 100%;
      }
      .password-btn {
        background-color: var(--color-primary, #2D6A4F);
        color: #ffffff;
        border: none;
        border-radius: 6px;
        padding: 0.85rem 1.5rem;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.2s ease;
      }
      .password-btn:hover {
        background-color: var(--color-primary-dark, #1B4332);
      }
      .password-admin-login {
        margin-top: 2rem;
        font-size: 0.875rem;
      }
      .password-admin-login a {
        color: var(--color-primary, #2D6A4F);
        text-decoration: underline;
      }
    </style>
  </head>

  <body class="password-page">
    <div class="password-card">
      <div class="password-logo">
        {%- if settings.logo != blank -%}
          <img src="{{ settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" loading="eager" width="{{ settings.logo_width | default: 140 }}">
        {%- else -%}
          {{ shop.name }}
        {%- endif -%}
      </div>

      <h1 class="password-heading">Our Store is Opening Soon</h1>
      <p class="password-subtext">
        Be the first to know when we launch. Subscribe for exclusive updates, curated arrivals, and opening offers.
      </p>

      {% form 'customer', class: 'password-form' %}
        {%- if form.posted_successfully? -%}
          <p class="form-status form-status--success" tabindex="-1" autofocus style="color: var(--color-success, #27AE60); font-weight: 500;">
            Thank you! You will be notified as soon as we open.
          </p>
        {%- else -%}
          <input type="hidden" name="contact[tags]" value="prospect, password page">
          <input
            type="email"
            name="contact[email]"
            class="password-input"
            placeholder="Enter your email address"
            required
            autocomplete="email"
            aria-label="Enter your email address"
          >
          <button type="submit" class="password-btn">
            Notify Me
          </button>
        {%- endif -%}
      {% endform %}

      <div class="password-admin-login">
        <details>
          <summary style="cursor: pointer; color: #777;">Enter store using password</summary>
          {% form 'storefront_password', class: 'password-form', style: 'margin-top: 1rem;' %}
            {%- if form.errors -%}
              <p style="color: var(--color-error, #C0392B); font-size: 0.85rem;">{{ form.errors | default_errors }}</p>
            {%- endif -%}
            <input
              type="password"
              name="password"
              class="password-input"
              placeholder="Your store password"
              required
            >
            <button type="submit" class="password-btn" style="background: #333;">
              Enter
            </button>
          {% endform %}
        </details>
      </div>

      {{ content_for_layout }}
    </div>
  </body>
</html>
