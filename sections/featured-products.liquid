<div class="featured-products section-padding" style="padding: {{ section.settings.padding_top | default: 64 }}px 0 {{ section.settings.padding_bottom | default: 64 }}px 0; background-color: #ffffff;">
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.description != blank -%}
      <div class="section-header text-{{ section.settings.text_alignment | default: 'center' }}" style="margin-bottom: 3rem; text-align: {{ section.settings.text_alignment | default: 'center' }};">
        <span style="display: inline-block; font-size: 0.85rem; font-weight: 800; color: #367C2B; text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 0.5rem; font-family: 'Inter', sans-serif;">
          {{ section.settings.caption | default: 'AUTHENTIC TURF MACHINERY' }}
        </span>
        {%- if section.settings.heading != blank -%}
          <h2 class="section-heading" style="font-family: 'Inter', sans-serif; font-size: clamp(2rem, 3.5vw, 2.75rem); font-weight: 900; color: #111111; margin-bottom: 0.75rem; letter-spacing: -0.02em;">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="section-subheading" style="font-family: 'Open Sans', sans-serif; color: #555555; font-size: 1.05rem; max-width: 680px; margin: 0 auto; line-height: 1.6;">
            {{ section.settings.description }}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- assign collection = section.settings.collection -%}
    {%- if collection == blank or collection.products.size == 0 -%}
      {%- assign collection = collections['all'] -%}
      {%- if collection == blank or collection.products.size == 0 -%}
        {%- assign collection = collections.first -%}
      {%- endif -%}
    {%- endif -%}
    {%- assign limit = section.settings.products_to_show | default: 8 -%}

    <div class="product-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.75rem;">
      {%- assign shown = 0 -%}
      {%- if collection != blank and collection.products.size > 0 -%}
        {%- for product in collection.products -%}
          {%- if product.featured_image == blank or product.price <= 0 or product.price < 10000 -%}
            {%- continue -%}
          {%- endif -%}
          {%- assign dt = product.type | downcase -%}
          {%- assign dtitle = product.title | downcase -%}
          {%- if dt contains 'lift' or dt contains 'shed' or dt contains 'bike' or dt contains 'cardio' or dt contains 'swing' or dt contains 'trampoline' or dt contains 'gazebo' or dt contains 'pergola' or dt contains 'generator' or dtitle contains 'car lift' or dtitle contains 'gazebo' or dtitle contains 'pergola' or dtitle contains 'generator' or dtitle contains 'tire' or dtitle contains 'changer' or dtitle contains 'balancer' or dtitle contains 'jack' or dtitle contains 'post lift' or dtitle contains 'baseplate' -%}
            {%- continue -%}
          {%- endif -%}
          <div class="product-grid-item">
            {% render 'product-card',
              product: product,
              show_vendor: section.settings.show_vendor,
              show_quick_add: section.settings.show_quick_add,
              image_ratio: section.settings.image_ratio
            %}
          </div>
          {%- assign shown = shown | plus: 1 -%}
          {%- if shown >= limit -%}{%- break -%}{%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      {%- if shown < limit -%}
        {%- assign fallback_titles = "John Deere S120 Mower 42 in. 22 HP V-Twin Gas Hydrostatic Riding Lawn Mower,John Deere Z345R ZTrak 42-in 22-HP Lawn Mower,John Deere Z345M 42 in. 22 HP Gas Dual Hydrostatic Zero-Turn Riding Mower,Craftsman T3200 – 24HP Kohler V-Twin Automatic 54″ Riding Lawn Mower,Craftsman 30″ 10.5 HP 344cc 6-Speed Riding Lawn Mower,Troy-Bilt Bronco 42 – 42” 19HP Briggs & Stratton Automatic Drive Gas Riding Lawn Tractor,Craftsman R110 – 11.5HP Manual/Gear 36″ Riding Lawn Mower,Cub Cadet XT1 Enduro LT 42 in. 19 HP Kohler Hydrostatic Riding Mower" | split: "," -%}
        {%- assign fallback_prices = "$799.00,$699.00,$699.00,$899.00,$699.00,$799.00,$699.00,$799.00" | split: "," -%}
        {%- assign fallback_vendors = "John Deere,John Deere,John Deere,Craftsman,Craftsman,Troy-Bilt,Craftsman,Cub Cadet" | split: "," -%}
        {%- assign fallback_badges = "Best Seller,Trending,Top Rated,Staff Pick,Popular,Must Have,Verified,Hot Deal" | split: "," -%}
        {%- assign fallback_imgs = "https://laitm.com/wp-content/uploads/2026/08/ltm-product-89-image-1.png,https://laitm.com/wp-content/uploads/2026/08/ltm-product-330-image-1.jpg,https://laitm.com/wp-content/uploads/2026/08/ltm-product-331-image-1.jpg,https://laitm.com/wp-content/uploads/2026/09/1-11.png,https://laitm.com/wp-content/uploads/2026/07/s-scaled.jpg,https://laitm.com/wp-content/uploads/2026/09/1-2.png,https://laitm.com/wp-content/uploads/2026/08/ltm-product-90-image-1.png,https://laitm.com/wp-content/uploads/2026/08/ltm-product-333-image-1.jpg" | split: "," -%}
        {%- assign fallback_urls = "/products/john-deere-s120-mower-42-in-22-hp-v-twin-gas-hydrostatic-riding-lawn-mower,/products/john-deere-z345r-ztrak-42-in-22-hp-lawn-mower,/products/john-deere-z345m-42-in-22-hp-gas-dual-hydrostatic-zero-turn-riding-mower,/products/craftsman-t3200-24hp-kohler-v-twin-automatic-54-riding-lawn-mower,/products/craftsman-30-10-5-hp-344cc-6-speed-riding-lawn-mower,/products/troy-bilt-bronco-42-42-19hp-briggs-stratton-automatic-drive-gas-riding-lawn-tractor,/products/craftsman-r110-11-5hp-manual-gear-36-riding-lawn-mower,/products/cub-cadet-ultima-zt1-54-24hp-kohler-zero-turn-mower-54" | split: "," -%}

        {%- for i in (0..7) -%}
          {%- if shown >= limit -%}{%- break -%}{%- endif -%}
          {%- assign p_title = fallback_titles[i] -%}
          {%- assign p_price = fallback_prices[i] -%}
          {%- assign p_vendor = fallback_vendors[i] -%}
          {%- assign p_badge = fallback_badges[i] -%}
          {%- assign p_img = fallback_imgs[i] -%}
          {%- assign p_url = fallback_urls[i] -%}

          <article class="product-card" style="border: 1px solid #E2E2E2; border-radius: 8px; overflow: hidden; background: #ffffff; display: flex; flex-direction: column; transition: transform 0.2s, box-shadow 0.2s; box-shadow: 0 2px 6px rgba(0,0,0,0.03);">
            <div class="product-card__media-wrapper" style="position: relative; aspect-ratio: 1; background: #F7F7F7; display: flex; align-items: center; justify-content: center; overflow: hidden;">
              <span class="badge" style="position: absolute; top: 12px; left: 12px; background: #FFDE00; color: #111111; font-size: 0.72rem; font-weight: 800; padding: 4px 10px; border-radius: 4px; z-index: 2; font-family: 'Inter', sans-serif;">
                {{ p_badge }}
              </span>
              <a href="{{ p_url }}" style="display: block; width: 100%; height: 100%;">
                <img src="{{ p_img }}" alt="{{ p_title }}" style="width: 100%; height: 100%; object-fit: contain; padding: 10px;" loading="lazy">
              </a>
            </div>
            <div class="product-card__info" style="padding: 1.25rem; display: flex; flex-direction: column; flex: 1; justify-content: space-between;">
              <div>
                <p style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: #367C2B; margin-bottom: 0.25rem; font-weight: 700; font-family: 'Inter', sans-serif;">
                  {{ p_vendor }}
                </p>
                <h3 style="font-family: 'Inter', sans-serif; font-size: 0.95rem; font-weight: 700; line-height: 1.4; margin-bottom: 0.5rem; color: #111111;">
                  <a href="{{ p_url }}" style="color: inherit; text-decoration: none;">{{ p_title }}</a>
                </h3>
                <div style="display: flex; align-items: center; gap: 4px; margin-bottom: 0.75rem; font-size: 0.85rem; color: #FFDE00;">
                  <span>★★★★★</span>
                  <span style="color: #666666; font-size: 0.75rem;">(verified)</span>
                </div>
              </div>
              <div>
                <div style="font-size: 1.25rem; font-weight: 900; color: #367C2B; margin-bottom: 0.25rem; font-family: 'Inter', sans-serif;">
                  {{ p_price }}
                </div>
                <div style="font-size: 0.75rem; color: #166534; font-weight: 700; margin-bottom: 0.75rem; display: flex; align-items: center; gap: 4px;">
                  <span>🚚 Free Liftgate Delivery Included</span>
                </div>
                <a href="{{ p_url }}" class="btn btn--primary" style="width: 100%; justify-content: center; padding: 12px 16px; font-size: 0.875rem; border-radius: 6px; background: #FFDE00; color: #111111; font-weight: 800; text-align: center; text-decoration: none; display: flex; font-family: 'Inter', sans-serif; box-shadow: 0 2px 8px rgba(255,222,0,0.35);">
                  Order Now &bull; Free Delivery &rarr;
                </a>
              </div>
            </div>
          </article>
          {%- assign shown = shown | plus: 1 -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_view_all -%}
      <div class="view-all-wrapper" style="text-align: center; margin-top: 3.5rem;">
        <a href="/collections/all" class="btn btn--primary btn--lg" style="display: inline-flex; align-items: center; gap: 8px; padding: 14px 36px; background: #FFDE00; color: #111111; text-decoration: none; border-radius: 6px; font-weight: 800; box-shadow: 0 4px 16px rgba(255,222,0,0.4); font-family: 'Inter', sans-serif;">
          {{ section.settings.view_all_label | default: 'Explore All Mower Equipment' }}
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 10h10M10 5l5 5-5 5"/></svg>
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Featured Products",
  "tag": "section",
  "class": "section-featured-products",
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "label": "Caption Tag",
      "default": "Handpicked For Quality"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trending Essentials"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Subheading",
      "default": "Carefully selected, practical everyday items engineered for durability, utility, and transparent value."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 16,
      "step": 2,
      "default": 8,
      "label": "Products to Show"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Desktop Columns"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Ratio",
      "options": [
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (3:4)" }
      ],
      "default": "square"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show Brand / Vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show Quick Add",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' Button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "'View All' Button Label",
      "default": "Explore All 1,000+ Products"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Featured Products",
      "settings": {
        "heading": "Trending Essentials"
      }
    }
  ]
}
{% endschema %}
