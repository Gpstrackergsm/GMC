<div class="featured-products section-padding" style="padding: {{ section.settings.padding_top | default: 48 }}px 0 {{ section.settings.padding_bottom | default: 48 }}px 0;">
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.description != blank -%}
      <div class="section-header text-{{ section.settings.text_alignment | default: 'center' }}" style="margin-bottom: 2.5rem; text-align: {{ section.settings.text_alignment | default: 'center' }};">
        {%- if section.settings.heading != blank -%}
          <h2 class="section-heading" style="font-family: var(--font-heading-family, serif); font-size: 2rem; color: var(--color-text, #1A1A1A); margin-bottom: 0.5rem;">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="section-subheading" style="color: #666; font-size: 1rem; max-width: 650px; margin: 0 auto;">
            {{ section.settings.description }}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- assign collection = section.settings.collection -%}
    {%- assign limit = section.settings.products_to_show | default: 8 -%}

    <div class="product-grid" style="display: grid; grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr); gap: 1.5rem;">
      {%- if collection != blank and collection.products.size > 0 -%}
        {%- for product in collection.products limit: limit -%}
          <div class="product-grid-item">
            {% render 'product-card',
              product: product,
              show_vendor: section.settings.show_vendor,
              show_quick_add: section.settings.show_quick_add,
              image_ratio: section.settings.image_ratio
            %}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          <div class="product-grid-item" style="border: 1px solid var(--color-border, #E8E8E0); border-radius: 8px; padding: 1rem; text-align: center;">
            <div style="background: #EFEFEA; aspect-ratio: 1; border-radius: 6px; display: flex; align-items: center; justify-content: center; color: #888; margin-bottom: 0.75rem;">
              Featured Product {{ i }}
            </div>
            <h3 style="font-size: 1rem; margin-bottom: 0.5rem;">Sample Product Title</h3>
            <p style="color: var(--color-primary, #2D6A4F); font-weight: 600;">$29.99</p>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_view_all and collection != blank -%}
      <div class="view-all-wrapper" style="text-align: center; margin-top: 2.5rem;">
        <a href="{{ collection.url }}" class="btn btn--primary" style="display: inline-block; padding: 0.85rem 2rem; background: var(--color-primary, #2D6A4F); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; transition: opacity 0.2s;">
          {{ section.settings.view_all_label | default: 'View All Products' }} &rarr;
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Featured Products",
  "tag": "section",
  "class": "section-featured-products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trending Essentials"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Subheading",
      "default": "Carefully selected, practical everyday items engineered for durability and reliable utility."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 16,
      "step": 2,
      "default": 8,
      "label": "Products to Show"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Desktop Columns"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Ratio",
      "options": [
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (3:4)" }
      ],
      "default": "square"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show Brand / Vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show Quick Add",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' Button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "'View All' Button Label",
      "default": "Explore Complete Collection"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Featured Products",
      "settings": {
        "heading": "Trending Essentials"
      }
    }
  ]
}
{% endschema %}
