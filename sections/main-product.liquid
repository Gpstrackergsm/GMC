<div class="product-page-section section-padding" style="padding: 2rem 0 4rem 0;" data-product-id="{{ product.id }}">
  <div class="container">
    {% render 'structured-data-breadcrumb' %}
    {% render 'structured-data-product', product: product %}

    <div class="product-layout" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 3.5rem; align-items: start;">
      
      <!-- Product Media Gallery -->
      <div class="product-gallery">
        <div class="product-gallery__main" style="border-radius: 12px; overflow: hidden; background: #FFFFFF; border: 1px solid var(--color-border, #E8E8E0); margin-bottom: 1rem; position: relative;">
          {%- if product.featured_media != blank -%}
            <img
              id="ProductMainImage-{{ section.id }}"
              src="{{ product.featured_media | image_url: width: 1200 }}"
              alt="{{ product.featured_media.alt | default: product.title | escape }}"
              width="1200"
              height="{{ 1200 | divided_by: product.featured_media.aspect_ratio | round }}"
              loading="eager"
              style="width: 100%; height: auto; display: block; object-fit: contain; aspect-ratio: 1;"
            >
          {%- else -%}
            <div style="aspect-ratio: 1; display: flex; align-items: center; justify-content: center; background: #F0F0EB; color: #888;">
              {{ product.title }}
            </div>
          {%- endif -%}

          {%- if product.compare_at_price > product.price -%}
            <span class="badge badge--sale" style="position: absolute; top: 1rem; left: 1rem; background: var(--color-accent, #D4A853); color: #1A1A1A; font-weight: 700; font-size: 0.8rem; padding: 0.35rem 0.75rem; border-radius: 4px; text-transform: uppercase;">
              Sale
            </span>
          {%- endif -%}
        </div>

        {%- if product.media.size > 1 -%}
          <div class="product-gallery__thumbnails" style="display: flex; gap: 0.75rem; overflow-x: auto; padding-bottom: 0.5rem;">
            {%- for media in product.media -%}
              <button
                type="button"
                class="thumbnail-btn {% if forloop.first %}is-active{% endif %}"
                data-media-id="{{ media.id }}"
                data-image-src="{{ media | image_url: width: 1200 }}"
                data-image-alt="{{ media.alt | default: product.title | escape }}"
                style="flex: 0 0 72px; width: 72px; height: 72px; border-radius: 6px; border: 2px solid {% if forloop.first %}var(--color-primary, #2D6A4F){% else %}var(--color-border, #E8E8E0){% endif %}; padding: 2px; background: #fff; cursor: pointer; overflow: hidden;"
                aria-label="View product image {{ forloop.index }}"
              >
                <img
                  src="{{ media | image_url: width: 150, height: 150, crop: 'center' }}"
                  alt="{{ media.alt | default: product.title | escape }}"
                  width="150"
                  height="150"
                  loading="lazy"
                  style="width: 100%; height: 100%; object-fit: cover; border-radius: 4px;"
                >
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Product Form & Details -->
      <div class="product-details">
        {%- if section.settings.show_vendor and product.vendor != blank -%}
          <div class="product-vendor" style="text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1.5px; color: #666; margin-bottom: 0.5rem; font-weight: 600;">
            {{ product.vendor }}
          </div>
        {%- endif -%}

        <h1 class="product-title" style="font-family: var(--font-heading-family, serif); font-size: 2.15rem; line-height: 1.25; color: var(--color-text, #1A1A1A); margin-bottom: 1rem;">
          {{ product.title }}
        </h1>

        <!-- SKU & Availability -->
        <div class="product-meta" style="display: flex; gap: 1.5rem; align-items: center; margin-bottom: 1.25rem; font-size: 0.875rem;">
          {%- if section.settings.show_sku and product.selected_or_first_available_variant.sku != blank -%}
            <span class="product-sku" style="color: #666;">
              SKU: <strong id="ProductSku-{{ section.id }}">{{ product.selected_or_first_available_variant.sku }}</strong>
            </span>
          {%- endif -%}

          <span class="product-availability" style="font-weight: 600; color: {% if product.available %}var(--color-success, #27AE60){% else %}var(--color-error, #C0392B){% endif %};">
            {%- if product.available -%}
              &bull; In Stock & Ready to Ship
            {%- else -%}
              &bull; Currently Out of Stock
            {%- endif -%}
          </span>
        </div>

        <!-- Price -->
        <div class="product-price-wrapper" style="margin-bottom: 1.75rem;">
          {% render 'price', product: product, use_variant: true, price_class: 'price--large' %}
        </div>

        {%- form 'product', product, id: 'ProductForm', class: 'product-form' -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

          <!-- Variant Picker -->
          {%- unless product.has_only_default_variant -%}
            <div class="product-variants" style="margin-bottom: 1.5rem;">
              {% render 'variant-picker', product: product %}
            </div>
          {%- endunless -%}

          <!-- Quantity and Add to Cart -->
          <div class="product-atc-group" style="display: flex; gap: 1rem; align-items: center; margin-bottom: 1.75rem; flex-wrap: wrap;">
            {%- if section.settings.show_quantity_selector -%}
              <div class="product-quantity">
                {% render 'quantity-input', product: product %}
              </div>
            {%- endif -%}

            <button
              type="submit"
              name="add"
              class="btn btn--primary btn--atc"
              {% unless product.available %}disabled{% endunless %}
              style="flex: 1 1 220px; padding: 1rem 2rem; background: var(--color-primary, #2D6A4F); color: #FFFFFF; font-size: 1.05rem; font-weight: 700; border: none; border-radius: 6px; cursor: {% if product.available %}pointer{% else %}not-allowed{% endif %}; transition: opacity 0.2s;"
            >
              <span class="atc-text">
                {%- if product.available -%}
                  {{ 'products.product.add_to_cart' | default: 'Add to Cart' }}
                {%- else -%}
                  {{ 'products.product.sold_out' | default: 'Sold Out' }}
                {%- endif -%}
              </span>
            </button>
          </div>
        {%- endform -%}

        <!-- Trust Highlights -->
        <div class="product-trust-signals" style="background: #F8F9F8; border: 1px solid var(--color-border, #E8E8E0); border-radius: 8px; padding: 1.25rem; margin-bottom: 2rem;">
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; font-size: 0.85rem;">
            <div style="display: flex; align-items: center; gap: 0.5rem;">
              <span style="color: var(--color-primary, #2D6A4F); font-size: 1.1rem;">&#10003;</span>
              <span><strong>Fast Dispatch:</strong> 1-2 business days</span>
            </div>
            <div style="display: flex; align-items: center; gap: 0.5rem;">
              <span style="color: var(--color-primary, #2D6A4F); font-size: 1.1rem;">&#10003;</span>
              <span><strong>Hassle-Free:</strong> 30-day return window</span>
            </div>
            <div style="display: flex; align-items: center; gap: 0.5rem;">
              <span style="color: var(--color-primary, #2D6A4F); font-size: 1.1rem;">&#10003;</span>
              <span><strong>Verified Spec:</strong> Authentic manufacturer data</span>
            </div>
            <div style="display: flex; align-items: center; gap: 0.5rem;">
              <span style="color: var(--color-primary, #2D6A4F); font-size: 1.1rem;">&#10003;</span>
              <span><strong>Encrypted:</strong> 256-bit secure checkout</span>
            </div>
          </div>
        </div>

        <!-- Description Accordion / Content -->
        <div class="product-description-wrapper">
          <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.75rem; color: var(--color-text, #1A1A1A);">
            Product Description
          </h2>
          <div class="rte product-description" style="font-size: 1rem; line-height: 1.7; color: #444; margin-bottom: 2rem;">
            {{ product.description }}
          </div>
        </div>

      </div>

    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const thumbnails = document.querySelectorAll('.thumbnail-btn');
    const mainImg = document.getElementById('ProductMainImage-{{ section.id }}');
    
    thumbnails.forEach(btn => {
      btn.addEventListener('click', function() {
        thumbnails.forEach(b => {
          b.classList.remove('is-active');
          b.style.borderColor = 'var(--color-border, #E8E8E0)';
        });
        this.classList.add('is-active');
        this.style.borderColor = 'var(--color-primary, #2D6A4F)';
        if (mainImg && this.dataset.imageSrc) {
          mainImg.src = this.dataset.imageSrc;
          if (this.dataset.imageAlt) mainImg.alt = this.dataset.imageAlt;
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Product Details",
  "tag": "section",
  "class": "section-main-product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show Brand / Vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sku",
      "label": "Show SKU",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quantity_selector",
      "label": "Show Quantity Selector",
      "default": true
    }
  ]
}
{% endschema %}
