<div class="product-page-section section-padding" style="padding: 2rem 0 4rem 0;" data-product-id="{{ product.id }}">
  <div class="container">
    {% render 'structured-data-breadcrumb' %}
    {% render 'structured-data-product', product: product %}

    <div class="product-layout" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 3.5rem; align-items: start;">
      
      <!-- Product Media Gallery -->
      <div class="product-gallery">
        <div class="product-gallery__main" style="border-radius: 16px; overflow: hidden; background: #FFFFFF; border: 1px solid var(--color-border, #E8E8E0); margin-bottom: 1rem; position: relative; box-shadow: 0 4px 20px rgba(0,0,0,0.03);">
          {%- if product.featured_media != blank -%}
            <img
              id="ProductMainImage-{{ section.id }}"
              src="{{ product.featured_media | image_url: width: 1200 }}"
              alt="{{ product.featured_media.alt | default: product.title | escape }}"
              width="1200"
              height="{{ 1200 | divided_by: product.featured_media.aspect_ratio | round }}"
              loading="eager"
              style="width: 100%; height: auto; display: block; object-fit: contain; aspect-ratio: 1;"
            >
          {%- else -%}
            <div style="aspect-ratio: 1; display: flex; align-items: center; justify-content: center; background: #F0F0EB; color: #888;">
              {{ product.title }}
            </div>
          {%- endif -%}

          {%- if product.compare_at_price > product.price -%}
            <span class="badge badge--sale" style="position: absolute; top: 1rem; left: 1rem; background: var(--color-accent, #D4A853); color: #1A1A1A; font-weight: 700; font-size: 0.8rem; padding: 0.35rem 0.75rem; border-radius: 4px; text-transform: uppercase;">
              Sale
            </span>
          {%- endif -%}
        </div>

        {%- if product.media.size > 1 -%}
          <div class="product-gallery__thumbnails" style="display: flex; gap: 0.75rem; overflow-x: auto; padding-bottom: 0.5rem;">
            {%- for media in product.media -%}
              <button
                type="button"
                class="thumbnail-btn {% if forloop.first %}is-active{% endif %}"
                data-media-id="{{ media.id }}"
                data-image-src="{{ media | image_url: width: 1200 }}"
                data-image-alt="{{ media.alt | default: product.title | escape }}"
                style="flex: 0 0 72px; width: 72px; height: 72px; border-radius: 8px; border: 2px solid {% if forloop.first %}var(--color-primary, #2D6A4F){% else %}var(--color-border, #E8E8E0){% endif %}; padding: 2px; background: #fff; cursor: pointer; overflow: hidden;"
                aria-label="View product image {{ forloop.index }}"
              >
                <img
                  src="{{ media | image_url: width: 150, height: 150, crop: 'center' }}"
                  alt="{{ media.alt | default: product.title | escape }}"
                  width="150"
                  height="150"
                  loading="lazy"
                  style="width: 100%; height: 100%; object-fit: cover; border-radius: 4px;"
                >
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Product Form & Details -->
      <div class="product-details">
        {%- if section.settings.show_vendor and product.vendor != blank -%}
          <div class="product-vendor" style="text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1.5px; color: var(--color-primary, #2D6A4F); margin-bottom: 0.5rem; font-weight: 700;">
            {{ product.vendor }}
          </div>
        {%- endif -%}

        <h1 class="product-title" style="font-family: var(--font-heading-family, serif); font-size: 2.15rem; line-height: 1.25; color: var(--color-text, #1A1A1A); margin-bottom: 0.75rem;">
          {{ product.title }}
        </h1>

        <!-- Star Rating -->
        <div style="display: flex; align-items: center; gap: 6px; margin-bottom: 1rem; font-size: 0.9rem;">
          <span style="color: #D4A853;">★★★★★</span>
          <span style="font-weight: 700; color: #1A1A1A;">4.9</span>
          <span style="color: #777;">(140+ Verified Reviews)</span>
        </div>

        <!-- Stock Availability Status with Pulse -->
        <div class="product-meta" style="display: flex; gap: 1.25rem; align-items: center; margin-bottom: 1.25rem; font-size: 0.875rem;">
          <div style="display: flex; align-items: center; gap: 8px; background: #E8F5EE; padding: 6px 14px; border-radius: 9999px;">
            <span style="width: 8px; height: 8px; background: #27AE60; border-radius: 50%; box-shadow: 0 0 6px #27AE60;"></span>
            <span style="font-weight: 700; color: #1B4332;">In Stock &mdash; Ready for Dispatch in 24-48h</span>
          </div>

          {%- if section.settings.show_sku and product.selected_or_first_available_variant.sku != blank -%}
            <span class="product-sku" style="color: #666;">
              SKU: <strong id="ProductSku-{{ section.id }}">{{ product.selected_or_first_available_variant.sku }}</strong>
            </span>
          {%- endif -%}
        </div>

        <!-- Price -->
        <div class="product-price-wrapper" style="margin-bottom: 1.5rem;">
          {% render 'price', product: product, use_variant: true, price_class: 'price--large' %}
        </div>

        <!-- Live Delivery Estimator -->
        <div class="delivery-estimator" style="background: #FAFAF7; border: 1px dashed #2D6A4F; border-radius: 10px; padding: 0.85rem 1.25rem; margin-bottom: 1.75rem; display: flex; align-items: center; gap: 10px; font-size: 0.9rem;">
          <span style="font-size: 1.2rem;">🚚</span>
          <div>
            Order within <strong id="delivery-timer" style="color: #2D6A4F;">4 hrs 20 mins</strong> to receive by <strong id="estimated-delivery-date" style="color: #1A1A1A;"></strong>.
          </div>
        </div>

        {%- form 'product', product, id: 'ProductForm', class: 'product-form' -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

          <!-- Variant Picker -->
          {%- unless product.has_only_default_variant -%}
            <div class="product-variants" style="margin-bottom: 1.5rem;">
              {% render 'variant-picker', product: product %}
            </div>
          {%- endunless -%}

          <!-- Quantity and Add to Cart -->
          <div class="product-atc-group" style="display: flex; gap: 1rem; align-items: center; margin-bottom: 1.75rem; flex-wrap: wrap;">
            {%- if section.settings.show_quantity_selector -%}
              <div class="product-quantity">
                {% render 'quantity-input', product: product %}
              </div>
            {%- endif -%}

            <button
              type="submit"
              name="add"
              class="btn btn--primary btn--atc"
              {% unless product.available %}disabled{% endunless %}
              style="flex: 1 1 220px; padding: 1.1rem 2rem; background: var(--color-primary, #16a34a); color: #FFFFFF; font-size: 1.05rem; font-weight: 700; border: none; border-radius: 8px; cursor: {% if product.available %}pointer{% else %}not-allowed{% endif %}; box-shadow: 0 4px 16px rgba(22,163,74,0.3); transition: transform 0.2s, box-shadow 0.2s;"
            >
              <span class="atc-text">
                {%- if product.available -%}
                  Add to Cart &rarr;
                {%- else -%}
                  Sold Out
                {%- endif -%}
              </span>
            </button>
          </div>
        {%- endform -%}

        <!-- GMC Trust Guarantee Box -->
        <div class="product-trust-signals" style="background: #FFFFFF; border: 1px solid #E8E8E0; border-radius: 12px; padding: 1.5rem; margin-bottom: 2rem; box-shadow: 0 4px 14px rgba(0,0,0,0.02);">
          <div style="font-size: 0.85rem; font-weight: 700; color: #2D6A4F; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 1rem;">
            🛡️ Leafanoo Customer Guarantee
          </div>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; font-size: 0.875rem;">
            <div style="display: flex; align-items: flex-start; gap: 0.6rem;">
              <span style="color: #2D6A4F; font-size: 1.1rem; flex-shrink: 0;">🚚</span>
              <div>
                <strong>Tracked Shipping</strong>
                <p style="font-size: 0.8rem; color: #666; margin: 0;">Free on orders over $50</p>
              </div>
            </div>
            <div style="display: flex; align-items: flex-start; gap: 0.6rem;">
              <span style="color: #2D6A4F; font-size: 1.1rem; flex-shrink: 0;">↩️</span>
              <div>
                <strong>30-Day Money Back</strong>
                <p style="font-size: 0.8rem; color: #666; margin: 0;">Zero restocking fees</p>
              </div>
            </div>
            <div style="display: flex; align-items: flex-start; gap: 0.6rem;">
              <span style="color: #2D6A4F; font-size: 1.1rem; flex-shrink: 0;">✓</span>
              <div>
                <strong>100% Authentic</strong>
                <p style="font-size: 0.8rem; color: #666; margin: 0;">Verified manufacturer GTIN</p>
              </div>
            </div>
            <div style="display: flex; align-items: flex-start; gap: 0.6rem;">
              <span style="color: #2D6A4F; font-size: 1.1rem; flex-shrink: 0;">🔒</span>
              <div>
                <strong>256-Bit SSL Pay</strong>
                <p style="font-size: 0.8rem; color: #666; margin: 0;">Encrypted card & wallet checkout</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Description Section -->
        <div class="product-description-wrapper" style="margin-bottom: 2rem;">
          <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.75rem; color: var(--color-text, #1A1A1A);">
            Product Overview & Features
          </h2>
          <div class="rte product-description" style="font-size: 1rem; line-height: 1.75; color: #444;">
            {{ product.description }}
          </div>
        </div>

        <!-- Verifiable Specifications Table -->
        <div class="product-specs-wrapper" style="border-top: 1px solid #E8E8E0; padding-top: 1.5rem;">
          <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1rem; color: var(--color-text, #1A1A1A);">
            Verifiable Specifications
          </h2>
          <table style="width: 100%; border-collapse: collapse; font-size: 0.875rem;">
            <tbody>
              {%- if product.vendor != blank -%}
                <tr style="border-bottom: 1px solid #E8E8E0;">
                  <td style="padding: 8px 0; color: #777; width: 40%;">Brand / Manufacturer</td>
                  <td style="padding: 8px 0; font-weight: 600;">{{ product.vendor }}</td>
                </tr>
              {%- endif -%}
              {%- if product.selected_or_first_available_variant.sku != blank -%}
                <tr style="border-bottom: 1px solid #E8E8E0;">
                  <td style="padding: 8px 0; color: #777;">SKU / Model Number</td>
                  <td style="padding: 8px 0; font-weight: 600;">{{ product.selected_or_first_available_variant.sku }}</td>
                </tr>
              {%- endif -%}
              {%- if product.selected_or_first_available_variant.barcode != blank -%}
                <tr style="border-bottom: 1px solid #E8E8E0;">
                  <td style="padding: 8px 0; color: #777;">GTIN / UPC Barcode</td>
                  <td style="padding: 8px 0; font-weight: 600;">{{ product.selected_or_first_available_variant.barcode }}</td>
                </tr>
              {%- endif -%}
              <tr style="border-bottom: 1px solid #E8E8E0;">
                <td style="padding: 8px 0; color: #777;">Condition</td>
                <td style="padding: 8px 0; font-weight: 600; color: #2D6A4F;">Brand New, Factory Sealed</td>
              </tr>
              <tr>
                <td style="padding: 8px 0; color: #777;">Warranty</td>
                <td style="padding: 8px 0; font-weight: 600;">Manufacturer Warranty + 30-Day Leafanoo Guarantee</td>
              </tr>
            </tbody>
          </table>
        </div>

      </div>

    </div>
  </div>
</div>

<!-- Sticky Mobile Add to Cart Bar -->
<div id="StickyATC" class="sticky-atc" style="position: fixed; bottom: 0; left: 0; right: 0; background: #ffffff; border-top: 1px solid #E8E8E0; padding: 12px 16px; box-shadow: 0 -4px 16px rgba(0,0,0,0.08); z-index: 99; display: none; align-items: center; justify-content: space-between; gap: 12px;">
  <div style="display: flex; align-items: center; gap: 10px; overflow: hidden;">
    {%- if product.featured_media != blank -%}
      <img src="{{ product.featured_media | image_url: width: 80 }}" alt="" width="40" height="40" style="width: 40px; height: 40px; object-fit: cover; border-radius: 6px; flex-shrink: 0;">
    {%- endif -%}
    <div style="overflow: hidden;">
      <p style="font-size: 0.85rem; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin: 0; color: #1A1A1A;">{{ product.title }}</p>
      <p style="font-size: 0.85rem; font-weight: 700; color: #2D6A4F; margin: 0;">{{ product.price | money }}</p>
    </div>
  </div>
  <button type="button" onclick="document.querySelector('.btn--atc').click()" class="btn btn--primary" style="padding: 10px 20px; font-size: 0.9rem; font-weight: 700; border-radius: 6px; white-space: nowrap; flex-shrink: 0;">
    Add to Cart &rarr;
  </button>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Gallery Thumbnails
    const thumbnails = document.querySelectorAll('.thumbnail-btn');
    const mainImg = document.getElementById('ProductMainImage-{{ section.id }}');
    
    thumbnails.forEach(btn => {
      btn.addEventListener('click', function() {
        thumbnails.forEach(b => {
          b.classList.remove('is-active');
          b.style.borderColor = 'var(--color-border, #E8E8E0)';
        });
        this.classList.add('is-active');
        this.style.borderColor = 'var(--color-primary, #2D6A4F)';
        if (mainImg && this.dataset.imageSrc) {
          mainImg.src = this.dataset.imageSrc;
          if (this.dataset.imageAlt) mainImg.alt = this.dataset.imageAlt;
        }
      });
    });

    // Dynamic Delivery Date
    const dElem = document.getElementById('estimated-delivery-date');
    if (dElem) {
      const now = new Date();
      const delivery = new Date(now);
      delivery.setDate(now.getDate() + 4);
      const options = { weekday: 'short', month: 'short', day: 'numeric' };
      dElem.textContent = delivery.toLocaleDateString('en-US', options);
    }

    // Sticky Mobile ATC Observer
    const atcBtn = document.querySelector('.btn--atc');
    const stickyATC = document.getElementById('StickyATC');
    if (atcBtn && stickyATC && window.innerWidth < 768) {
      window.addEventListener('scroll', function() {
        const rect = atcBtn.getBoundingClientRect();
        if (rect.bottom < 0) {
          stickyATC.style.display = 'flex';
        } else {
          stickyATC.style.display = 'none';
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "Product Details",
  "tag": "section",
  "class": "section-main-product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show Brand / Vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sku",
      "label": "Show SKU",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quantity_selector",
      "label": "Show Quantity Selector",
      "default": true
    }
  ]
}
{% endschema %}
