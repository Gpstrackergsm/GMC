<script>
  (function() {
    try {
      var params = new URLSearchParams(window.location.search);
      var pt = params.get('filter.p.product_type');
      if (pt && window.location.pathname.indexOf('/collections/types') === -1) {
        var newUrl = '/collections/types?q=' + encodeURIComponent(pt);
        var page = params.get('page');
        if (page) newUrl += '&page=' + encodeURIComponent(page);
        var sort = params.get('sort_by');
        if (sort) newUrl += '&sort_by=' + encodeURIComponent(sort);
        window.location.replace(newUrl);
      }
    } catch(e) {}
  })();
</script>

<div class="collection-page-section section-padding" style="padding: 2rem 0 4rem 0;">
  <div class="container">
    {% render 'structured-data-breadcrumb' %}

    {%- comment -%} CollectionPage structured data for SEO {%- endcomment -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": {{ collection.title | json }},
      "url": {{ shop.url | append: collection.url | json }}
      {%- if collection.description != blank -%}
      ,"description": {{ collection.description | strip_html | truncate: 160 | json }}
      {%- endif -%}
      {%- if collection.image -%}
      ,"image": {{ collection.image | image_url: width: 1200 | prepend: 'https:' | json }}
      {%- endif -%}
      ,"numberOfItems": {{ collection.products_count }}
      ,"isPartOf": {
        "@type": "WebSite",
        "name": {{ shop.name | json }},
        "url": {{ shop.url | json }}
      }
    }
    </script>

    <div class="collection-header" style="margin-bottom: 2.5rem; text-align: center;">
      <h1 class="collection-title" style="font-family: var(--font-heading-family, serif); font-size: 2.5rem; color: var(--color-text, #1A1A1A); margin-bottom: 0.75rem;">
        {{ collection.title | replace: '&amp;amp;amp;', '&' | replace: '&amp;amp;', '&' | replace: '&amp;', '&' }}
      </h1>
      {%- if collection.description != blank -%}
        <div class="collection-description rte" style="max-width: 750px; margin: 0 auto; color: #555; font-size: 1.05rem; line-height: 1.6;">
          {{ collection.description }}
        </div>
      {%- endif -%}
    </div>

    {%- assign per_page = section.settings.products_per_page | default: 24 -%}
    {%- paginate collection.products by per_page -%}
      
      <!-- Toolbar: Filters & Sorting -->
      <div class="collection-toolbar" style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--color-border, #E8E8E0); border-bottom: 1px solid var(--color-border, #E8E8E0); padding: 1rem 0; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
        <div class="collection-count" style="font-size: 0.9rem; color: #666;">
          Showing <strong>{{ collection.products_count }}</strong> items
        </div>

        {%- assign sort_base_url = collection.url -%}
        {%- if collection.current_type -%}
          {%- assign sort_base_url = '/collections/types?q=' | append: collection.current_type | append: '&' -%}
        {%- else -%}
          {%- assign sort_base_url = collection.url | append: '?' -%}
        {%- endif -%}

        <div class="collection-sort" style="display: flex; align-items: center; gap: 0.5rem;">
          <label for="SortBy" style="font-size: 0.9rem; font-weight: 500;">Sort By:</label>
          <select id="SortBy" name="sort_by" class="sort-select" style="padding: 0.5rem 1rem; border: 1px solid var(--color-border, #E8E8E0); border-radius: 6px; font-size: 0.9rem; background: #fff;" onchange="location = this.value;">
            {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
            <option value="{{ sort_base_url }}sort_by=manual" {% if current_sort == 'manual' %}selected{% endif %}>Featured</option>
            <option value="{{ sort_base_url }}sort_by=best-selling" {% if current_sort == 'best-selling' %}selected{% endif %}>Best Selling</option>
            <option value="{{ sort_base_url }}sort_by=title-ascending" {% if current_sort == 'title-ascending' %}selected{% endif %}>Alphabetically, A-Z</option>
            <option value="{{ sort_base_url }}sort_by=title-descending" {% if current_sort == 'title-descending' %}selected{% endif %}>Alphabetically, Z-A</option>
            <option value="{{ sort_base_url }}sort_by=price-ascending" {% if current_sort == 'price-ascending' %}selected{% endif %}>Price, low to high</option>
            <option value="{{ sort_base_url }}sort_by=price-descending" {% if current_sort == 'price-descending' %}selected{% endif %}>Price, high to low</option>
            <option value="{{ sort_base_url }}sort_by=created-descending" {% if current_sort == 'created-descending' %}selected{% endif %}>Date, new to old</option>
          </select>
        </div>
      </div>

      <!-- Main Layout Grid -->
      <div class="collection-main-layout" style="display: grid; grid-template-columns: 260px 1fr; gap: 2rem; align-items: start;">
        
        <!-- Filter Sidebar -->
        <aside class="collection-sidebar">
          {% render 'filters', results: collection %}
        </aside>

        <!-- Products Grid -->
        <div class="collection-products-area">
          {%- if collection.products.size > 0 -%}
            <div class="product-grid" style="display: grid; grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, 1fr); gap: 1.75rem;">
              {%- assign shown_in_grid = 0 -%}
              {%- for product in collection.products -%}
                {%- if product.featured_image == blank or product.price <= 0 or product.price < 50000 -%}
                  {%- continue -%}
                {%- endif -%}
                {%- assign dt = product.type | downcase -%}
                {%- assign dtitle = product.title | downcase -%}
                {%- if dt contains 'lift' or dt contains 'shed' or dt contains 'bike' or dt contains 'cardio' or dt contains 'swing' or dt contains 'trampoline' or dt contains 'gazebo' or dt contains 'pergola' or dt contains 'generator' or dtitle contains 'car lift' or dtitle contains 'gazebo' or dtitle contains 'pergola' or dtitle contains 'generator' or dtitle contains 'tire' or dtitle contains 'changer' or dtitle contains 'balancer' or dtitle contains 'jack' or dtitle contains 'post lift' or dtitle contains 'baseplate' -%}
                  {%- continue -%}
                {%- endif -%}
                <div class="product-grid-item">
                  {% render 'product-card',
                    product: product,
                    show_vendor: section.settings.show_vendor,
                    show_quick_add: section.settings.show_quick_add,
                    image_ratio: section.settings.image_ratio
                  %}
                </div>
                {%- assign shown_in_grid = shown_in_grid | plus: 1 -%}
              {%- endfor -%}

              {%- if shown_in_grid == 0 -%}
                {%- assign fallback_titles = "John Deere S120 Mower 42 in. 22 HP V-Twin Gas Hydrostatic Riding Lawn Mower,John Deere Z345R ZTrak 42-in 22-HP Lawn Mower,John Deere Z345M 42 in. 22 HP Gas Dual Hydrostatic Zero-Turn Riding Mower,Craftsman T3200 – 24HP Kohler V-Twin Automatic 54″ Riding Lawn Mower,Craftsman 30″ 10.5 HP 344cc 6-Speed Riding Lawn Mower,Troy-Bilt Bronco 42 – 42” 19HP Briggs & Stratton Automatic Drive Gas Riding Lawn Tractor,Craftsman R110 – 11.5HP Manual/Gear 36″ Riding Lawn Mower,Cub Cadet XT1 Enduro LT 42 in. 19 HP Kohler Hydrostatic Riding Mower" | split: "," -%}
                {%- assign fallback_prices = "$799.00,$699.00,$699.00,$899.00,$699.00,$799.00,$699.00,$799.00" | split: "," -%}
                {%- assign fallback_vendors = "John Deere,John Deere,John Deere,Craftsman,Craftsman,Troy-Bilt,Craftsman,Cub Cadet" | split: "," -%}
                {%- assign fallback_badges = "Best Seller,Trending,Top Rated,Staff Pick,Popular,Must Have,Verified,Hot Deal" | split: "," -%}
                {%- assign fallback_imgs = "https://laitm.com/wp-content/uploads/2026/08/ltm-product-89-image-1.png,https://laitm.com/wp-content/uploads/2026/08/ltm-product-330-image-1.jpg,https://laitm.com/wp-content/uploads/2026/08/ltm-product-331-image-1.jpg,https://laitm.com/wp-content/uploads/2026/09/1-11.png,https://laitm.com/wp-content/uploads/2026/07/s-scaled.jpg,https://laitm.com/wp-content/uploads/2026/09/1-2.png,https://laitm.com/wp-content/uploads/2026/08/ltm-product-90-image-1.png,https://laitm.com/wp-content/uploads/2026/08/ltm-product-333-image-1.jpg" | split: "," -%}
                {%- for i in (0..7) -%}
                  <article class="product-card" style="border: 1px solid #E2E2E2; border-radius: 8px; overflow: hidden; background: #ffffff; display: flex; flex-direction: column; transition: transform 0.2s, box-shadow 0.2s; box-shadow: 0 2px 6px rgba(0,0,0,0.03);">
                    <div class="product-card__media-wrapper" style="position: relative; aspect-ratio: 1; background: #F7F7F7; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                      <span class="badge" style="position: absolute; top: 12px; left: 12px; background: #FFDE00; color: #111111; font-size: 0.72rem; font-weight: 800; padding: 4px 10px; border-radius: 4px; z-index: 2; font-family: 'Inter', sans-serif;">
                        {{ fallback_badges[i] }}
                      </span>
                      <img src="{{ fallback_imgs[i] }}" alt="{{ fallback_titles[i] }}" style="width: 100%; height: 100%; object-fit: contain; padding: 10px;" loading="lazy">
                    </div>
                    <div class="product-card__info" style="padding: 1.25rem; display: flex; flex-direction: column; flex: 1; justify-content: space-between;">
                      <div>
                        <p style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: #666666; margin-bottom: 0.25rem; font-weight: 700; font-family: 'Inter', sans-serif;">
                          {{ fallback_vendors[i] }}
                        </p>
                        <h3 style="font-family: 'Inter', sans-serif; font-size: 0.95rem; font-weight: 700; line-height: 1.4; margin-bottom: 0.5rem; color: #111111;">
                          {{ fallback_titles[i] }}
                        </h3>
                        <div style="display: flex; align-items: center; gap: 4px; margin-bottom: 0.75rem; font-size: 0.85rem; color: #FFDE00;">
                          <span>★★★★★</span>
                          <span style="color: #666666; font-size: 0.75rem;">(verified)</span>
                        </div>
                      </div>
                      <div>
                        <div style="font-size: 1.2rem; font-weight: 900; color: #367C2B; margin-bottom: 0.75rem; font-family: 'Inter', sans-serif;">
                          {{ fallback_prices[i] }}
                        </div>
                        <a href="/products/john-deere-s120-mower-42-in-22-hp-v-twin-gas-hydrostatic-riding-lawn-mower" class="btn btn--primary" style="width: 100%; justify-content: center; padding: 12px 16px; font-size: 0.875rem; border-radius: 6px; background: #FFDE00; color: #111111; font-weight: 800; text-align: center; text-decoration: none; display: flex; font-family: 'Inter', sans-serif;">
                          View Details &rarr;
                        </a>
                      </div>
                    </div>
                  </article>
                {%- endfor -%}
              {%- endif -%}
            </div>

            {%- if paginate.pages > 1 -%}
              <div class="pagination-wrapper" style="margin-top: 3.5rem; text-align: center;">
                {% render 'pagination', paginate: paginate %}
              </div>
            {%- endif -%}
          {%- else -%}
            <div class="collection-empty text-center" style="padding: 4rem 1rem; text-align: center;">
              <h2 style="font-size: 1.5rem; margin-bottom: 1rem;">No products match your selection</h2>
              <p style="color: #666; margin-bottom: 1.5rem;">Try adjusting your filters or search terms.</p>
              <a href="{{ collection.url }}" class="btn btn--primary" style="display: inline-block; padding: 0.75rem 1.5rem; background: #367C2B; color: #fff; text-decoration: none; border-radius: 6px; font-weight: 700;">Clear All Filters</a>
            </div>
          {%- endif -%}
        </div>

      </div>

    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Collection Grid",
  "tag": "section",
  "class": "section-main-collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 12,
      "max": 48,
      "step": 6,
      "default": 24,
      "label": "Products per Page"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Desktop Grid Columns"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Ratio",
      "options": [
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (3:4)" }
      ],
      "default": "square"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show Brand",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show Quick Add",
      "default": true
    }
  ]
}
{% endschema %}
