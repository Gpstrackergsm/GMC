<div class="image-with-text section-padding" style="padding: {{ section.settings.padding_top | default: 64 }}px 0 {{ section.settings.padding_bottom | default: 64 }}px 0; background-color: #FAFAF7;">
  <div class="container">
    <div class="image-with-text__grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 3.5rem; align-items: center; {% if section.settings.layout == 'image_second' %}direction: rtl;{% endif %}">
      
      <div class="image-with-text__media" style="direction: ltr;">
        {%- if section.settings.image != blank -%}
          <div style="border-radius: 16px; overflow: hidden; box-shadow: 0 12px 36px rgba(0,0,0,0.08);">
            <img
              src="{{ section.settings.image | image_url: width: 800 }}"
              alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
              loading="lazy"
              width="800"
              height="{{ 800 | divided_by: section.settings.image.aspect_ratio | round }}"
              style="width: 100%; height: auto; display: block; object-fit: cover;"
            >
          </div>
        {%- else -%}
          <!-- Rich Quality Sourcing Card -->
          <div style="background: linear-gradient(135deg, #143828 0%, #0d2319 100%); border-radius: 16px; padding: 2.5rem; color: #ffffff; box-shadow: 0 16px 40px rgba(20,56,40,0.25); position: relative; overflow: hidden;">
            <div style="position: absolute; top: -20px; right: -20px; width: 140px; height: 140px; background: rgba(82,183,136,0.15); border-radius: 50%; filter: blur(30px);"></div>
            <span style="display: inline-block; background: rgba(255,255,255,0.15); backdrop-filter: blur(8px); padding: 4px 12px; border-radius: 9999px; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; margin-bottom: 1.5rem; color: #52B788;">
              Leafanoo Standards
            </span>
            <h3 style="font-family: var(--font-heading-family, serif); font-size: 1.5rem; color: #ffffff; margin-bottom: 1.5rem; line-height: 1.3;">
              The 4 Pillars of Every Leafanoo Product
            </h3>
            <div style="display: flex; flex-direction: column; gap: 1rem;">
              <div style="display: flex; align-items: flex-start; gap: 12px;">
                <span style="background: #52B788; color: #0d2319; font-weight: 800; width: 22px; height: 22px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; flex-shrink: 0;">✓</span>
                <div>
                  <strong style="display: block; font-size: 0.95rem; color: #ffffff;">Verified Authentic GTIN/UPC</strong>
                  <span style="font-size: 0.825rem; color: rgba(255,255,255,0.8);">All items mapped to authentic manufacturer barcodes and specs.</span>
                </div>
              </div>
              <div style="display: flex; align-items: flex-start; gap: 12px;">
                <span style="background: #52B788; color: #0d2319; font-weight: 800; width: 22px; height: 22px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; flex-shrink: 0;">✓</span>
                <div>
                  <strong style="display: block; font-size: 0.95rem; color: #ffffff;">Rigorous Utility Testing</strong>
                  <span style="font-size: 0.825rem; color: rgba(255,255,255,0.8);">Curated for real-world functionality, durability, and daily use.</span>
                </div>
              </div>
              <div style="display: flex; align-items: flex-start; gap: 12px;">
                <span style="background: #52B788; color: #0d2319; font-weight: 800; width: 22px; height: 22px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; flex-shrink: 0;">✓</span>
                <div>
                  <strong style="display: block; font-size: 0.95rem; color: #ffffff;">Direct Carrier Dispatch</strong>
                  <span style="font-size: 0.825rem; color: rgba(255,255,255,0.8);">Fast shipping with end-to-end tracking provided upon dispatch.</span>
                </div>
              </div>
              <div style="display: flex; align-items: flex-start; gap: 12px;">
                <span style="background: #52B788; color: #0d2319; font-weight: 800; width: 22px; height: 22px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; flex-shrink: 0;">✓</span>
                <div>
                  <strong style="display: block; font-size: 0.95rem; color: #ffffff;">30-Day Satisfaction Window</strong>
                  <span style="font-size: 0.825rem; color: rgba(255,255,255,0.8);">Hassle-free returns and quick support resolution.</span>
                </div>
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>

      <div class="image-with-text__content" style="direction: ltr;">
        {%- if section.settings.caption != blank -%}
          <span class="caption" style="text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1.5px; font-weight: 700; color: var(--color-primary, #2D6A4F); margin-bottom: 0.75rem; display: block;">
            {{ section.settings.caption }}
          </span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="heading" style="font-family: var(--font-heading-family, serif); font-size: clamp(2rem, 3.5vw, 2.75rem); line-height: 1.2; margin-bottom: 1.25rem; color: var(--color-text, #1A1A1A);">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="rte" style="font-size: 1.05rem; line-height: 1.7; color: #4A4A4A; margin-bottom: 2rem;">
            {{ section.settings.text }}
          </div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '/pages/about' }}" class="btn btn--primary btn--lg" style="display: inline-flex; align-items: center; gap: 8px; padding: 14px 32px; background: #2D6A4F; color: #ffffff; text-decoration: none; border-radius: 8px; font-weight: 600; box-shadow: 0 4px 16px rgba(45,106,79,0.3);">
            {{ section.settings.button_label }}
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 10h10M10 5l5 5-5 5"/></svg>
          </a>
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image with Text",
  "tag": "section",
  "class": "section-image-with-text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image Desktop Placement",
      "options": [
        { "value": "image_first", "label": "Image First (Left)" },
        { "value": "image_second", "label": "Image Second (Right)" }
      ],
      "default": "image_first"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption Tag",
      "default": "Our Sourcing Promise"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Thoughtful Products for Everyday Living"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>At Leafanoo, every item in our catalog is reviewed for durable manufacturing, verifiable specifications, and genuine consumer utility. We partner directly with vetted suppliers to ensure transparent pricing and reliable fulfillment.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Learn More About Our Standards"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Image with Text"
    }
  ]
}
{% endschema %}
