<style>
  .laitm-footer {
    --lf-green: #367C2B;
    --lf-green-hover: #4A9E3A;
    --lf-yellow: #FFDE00;
    --lf-bg: #111111;
    --lf-text: #cccccc;
    --lf-line: rgba(255,255,255,.12);
    --lf-soft: rgba(255,255,255,.05);
    background: radial-gradient(900px 420px at 10% 0%, rgba(54,124,43,.25), transparent 65%), #111111;
    color: var(--lf-text);
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 14px;
    line-height: 1.75;
    position: relative;
    border-top: 3px solid #FFDE00;
    margin-top: 0;
  }
  .laitm-footer * { box-sizing: border-box; }
  .laitm-footer-inner {
    padding: 64px 24px 44px;
    display: grid;
    grid-template-columns: 1.7fr 1fr 1fr 1.25fr;
    gap: 48px 40px;
  }
  .laitm-footer-logo {
    display: block;
    margin-bottom: 20px;
    text-decoration: none;
  }
  .laitm-footer-intro {
    font-family: "Open Sans", sans-serif;
    margin: 0 0 24px;
    font-size: 13.5px;
    line-height: 1.85;
    color: #a3a3a3;
  }
  .laitm-footer-intro strong { color: #ffffff; }
  .laitm-footer-divider {
    border: none;
    border-top: 1px solid var(--lf-line);
    margin: 0 0 20px;
  }
  .laitm-footer-contact {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin: 0 0 12px;
    font-size: 13.5px;
    color: #a3a3a3;
  }
  .laitm-footer-contact strong { color: #ffffff; }
  .laitm-footer-contact a {
    color: #d4d4d4;
    text-decoration: none;
    transition: color 0.18s;
  }
  .laitm-footer-contact a:hover { color: #FFDE00; }
  .laitm-ico {
    flex: 0 0 auto;
    width: 17px;
    height: 17px;
    margin-top: 3px;
    stroke: #FFDE00;
    stroke-width: 2;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .laitm-footer h3 {
    position: relative;
    font-size: 12.5px;
    font-weight: 800;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0 0 24px;
    padding-bottom: 12px;
  }
  .laitm-footer h3::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 28px;
    height: 2.5px;
    border-radius: 2px;
    background: #FFDE00;
  }
  .laitm-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .laitm-footer ul li {
    margin-bottom: 11px;
    font-size: 13.5px;
  }
  .laitm-footer ul li a {
    color: var(--lf-text);
    text-decoration: none;
    transition: color 0.18s, padding-left 0.18s;
    display: inline-block;
  }
  .laitm-footer ul li a:hover {
    color: #ffffff;
    padding-left: 6px;
  }
  .laitm-hours-block {
    margin-top: 28px;
    max-width: 360px;
    background: var(--lf-soft);
    border: 1px solid var(--lf-line);
    border-radius: 12px;
    padding: 16px 18px 8px;
  }
  .laitm-hours-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: var(--lf-green);
    margin: 0 0 10px;
  }
  .laitm-hours-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 9px 0;
    border-bottom: 1px solid var(--lf-line);
    font-size: 13px;
    margin: 0;
  }
  .laitm-hours-row:last-child { border-bottom: none; }
  .laitm-hours-row span:first-child { color: #ffffff; font-weight: 500; }
  .laitm-closed { color: #f87171; font-weight: 600; }
  .laitm-footer-bottom {
    border-top: 1px solid var(--lf-line);
  }
  .laitm-footer-bottom-inner {
    padding: 20px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 13px;
    color: #888888;
  }

  @media (max-width: 1024px) {
    .laitm-footer-inner { grid-template-columns: 1fr 1fr; gap: 40px 32px; }
  }
  @media (max-width: 600px) {
    .laitm-footer-inner { grid-template-columns: 1fr; padding: 40px 20px 24px; gap: 32px; }
    .laitm-hours-block { max-width: 100%; }
    .laitm-footer-bottom-inner { flex-direction: column; text-align: center; }
  }
</style>

