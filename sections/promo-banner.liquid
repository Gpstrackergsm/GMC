<section class="promo-banner-section section-padding" style="padding: 48px 0; background-color: #FAFAF7;">
  <div class="container">
    <div class="promo-banner" style="background: linear-gradient(135deg, #1A3A2A 0%, #0F2319 100%); border-radius: 20px; padding: clamp(2rem, 5vw, 3.5rem); color: #ffffff; position: relative; overflow: hidden; box-shadow: 0 16px 48px rgba(15,35,25,0.25);">
      
      <!-- Ambient Glow Accents -->
      <div style="position: absolute; top: -60px; right: -60px; width: 280px; height: 280px; background: radial-gradient(circle, rgba(82,183,136,0.3) 0%, transparent 70%); border-radius: 50%; pointer-events: none;"></div>
      <div style="position: absolute; bottom: -80px; left: 10%; width: 240px; height: 240px; background: radial-gradient(circle, rgba(212,168,83,0.2) 0%, transparent 70%); border-radius: 50%; pointer-events: none;"></div>

      <div style="position: relative; z-index: 2; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2.5rem; align-items: center;">
        <div>
          <span style="display: inline-flex; align-items: center; gap: 6px; background: rgba(255,255,255,0.15); backdrop-filter: blur(8px); padding: 5px 14px; border-radius: 9999px; font-size: 0.8rem; font-weight: 700; color: #52B788; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 1rem;">
            🔥 Limited Time Catalog Highlights
          </span>
          <h2 style="font-family: var(--font-heading-family, serif); font-size: clamp(1.8rem, 3.5vw, 2.5rem); font-weight: 800; color: #ffffff; line-height: 1.2; margin-bottom: 1rem;">
            {{ section.settings.heading | default: 'Upgrade Your Daily Routine with Verified Essentials' }}
          </h2>
          <p style="font-size: 1.05rem; line-height: 1.6; color: rgba(255,255,255,0.85); margin-bottom: 1.75rem; max-width: 500px;">
            {{ section.settings.text | default: 'Explore 1,000 top-trending physical products across Smart Tech, Kitchen, Ergonomics, and Wellness at transparent manufacturer prices.' }}
          </p>
          <div style="display: flex; flex-wrap: wrap; gap: 12px;">
            <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="btn btn--primary" style="padding: 14px 32px; background: #52B788; color: #0d2319; font-weight: 700; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
              {{ section.settings.button_label | default: 'Shop Trending Catalog' }} &rarr;
            </a>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
          <div style="background: rgba(255,255,255,0.08); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.12); border-radius: 12px; padding: 1.25rem;">
            <div style="font-size: 1.75rem; margin-bottom: 0.5rem;">📦</div>
            <h3 style="font-size: 1rem; font-weight: 700; color: #ffffff; margin-bottom: 0.25rem;">1,000+ Items</h3>
            <p style="font-size: 0.8rem; color: rgba(255,255,255,0.75); margin: 0;">Ready to ship across 10 categories</p>
          </div>
          <div style="background: rgba(255,255,255,0.08); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.12); border-radius: 12px; padding: 1.25rem;">
            <div style="font-size: 1.75rem; margin-bottom: 0.5rem;">🛡️</div>
            <h3 style="font-size: 1rem; font-weight: 700; color: #ffffff; margin-bottom: 0.25rem;">100% Genuine</h3>
            <p style="font-size: 0.8rem; color: rgba(255,255,255,0.75); margin: 0;">Authentic manufacturer GTINs</p>
          </div>
          <div style="background: rgba(255,255,255,0.08); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.12); border-radius: 12px; padding: 1.25rem;">
            <div style="font-size: 1.75rem; margin-bottom: 0.5rem;">⚡</div>
            <h3 style="font-size: 1rem; font-weight: 700; color: #ffffff; margin-bottom: 0.25rem;">Fast Delivery</h3>
            <p style="font-size: 0.8rem; color: rgba(255,255,255,0.75); margin: 0;">Carrier tracked with dispatch alerts</p>
          </div>
          <div style="background: rgba(255,255,255,0.08); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.12); border-radius: 12px; padding: 1.25rem;">
            <div style="font-size: 1.75rem; margin-bottom: 0.5rem;">💳</div>
            <h3 style="font-size: 1rem; font-weight: 700; color: #ffffff; margin-bottom: 0.25rem;">Secure Pay</h3>
            <p style="font-size: 0.8rem; color: rgba(255,255,255,0.75); margin: 0;">256-Bit SSL checkout protection</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promo Banner",
  "tag": "section",
  "class": "section-promo-banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Upgrade Your Daily Routine with Verified Essentials"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Explore 1,000 top-trending physical products across Smart Tech, Kitchen, Ergonomics, and Wellness at transparent manufacturer prices."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Trending Catalog"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Promo Banner"
    }
  ]
}
{% endschema %}
