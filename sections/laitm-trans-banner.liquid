{%- liquid
  assign kicker = section.settings.kicker | default: 'Also in your yard'
  assign heading = section.settings.heading | default: "Garden essentials, sorted. Now let's tackle the lawn."
  assign sub = section.settings.subtext | default: "From shade structures to the mower that keeps everything under it looking sharp — explore ride mowers built for real acreage."
  assign cta_label = section.settings.cta_label | default: 'Shop Ride Mowers'
  assign cta_link = section.settings.cta_link | default: '/collections/types?q=Riding+Lawn+Mowers'
  assign bg_img = section.settings.bg_image_url | default: 'https://laitm.com/wp-content/uploads/2026/07/s-scaled.jpg'
-%}

<section class="laitm-trans-section">
  <div class="laitm-trans-wrap">
    <div class="laitm-trans-bg">
      <img
        src="{{ bg_img }}"
        alt="Ride mowers and lawn equipment"
        loading="lazy"
        fetchpriority="low"
      >
    </div>
    <div class="laitm-trans-wash" aria-hidden="true"></div>
    <div class="laitm-trans-content page-width">
      <div class="laitm-trans-panel">
        {%- if kicker != blank -%}
          <p class="laitm-trans-kicker">{{ kicker }}</p>
        {%- endif -%}
        <h2 class="laitm-trans-title">{{ heading }}</h2>
        <p class="laitm-trans-sub">{{ sub }}</p>
        <a class="laitm-trans-cta" href="{{ cta_link }}">
          {{ cta_label }}
          <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2.4" viewBox="0 0 24 24" width="16" height="16"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .laitm-trans-section {
    position: relative;
    overflow: hidden;
  }
  .laitm-trans-wrap {
    position: relative;
    min-height: 380px;
    display: flex;
    align-items: center;
  }
  .laitm-trans-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .laitm-trans-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .laitm-trans-wash {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      100deg,
      rgba(24, 52, 26, 0.92) 0%,
      rgba(30, 63, 32, 0.78) 48%,
      rgba(30, 63, 32, 0.3) 100%
    );
  }
  .laitm-trans-content {
    position: relative;
    z-index: 2;
    padding: 72px 0;
  }
  .laitm-trans-panel {
    max-width: 540px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-family: "Inter", -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
  .laitm-trans-kicker {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: #FFDE00;
    margin: 0;
  }
  .laitm-trans-title {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 900;
    color: #ffffff;
    line-height: 1.2;
    margin: 0;
    letter-spacing: -0.02em;
  }
  .laitm-trans-title span { color: #FFDE00; }
  .laitm-trans-sub {
    font-family: "Open Sans", sans-serif;
    font-size: 15px;
    color: rgba(255,255,255,.88);
    line-height: 1.65;
    margin: 0;
    max-width: 460px;
  }
  .laitm-trans-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    background: #FFDE00;
    color: #111111;
    font-size: 14px;
    font-weight: 800;
    font-family: "Inter", sans-serif;
    border-radius: 6px;
    text-decoration: none;
    width: fit-content;
    box-shadow: 0 4px 14px rgba(255,222,0,.35);
    transition: background 0.2s, transform 0.2s;
    margin-top: 4px;
  }
  .laitm-trans-cta:hover { background: #E6C800; transform: translateY(-1px); color: #000000; }

  @media (max-width: 640px) {
    .laitm-trans-content { padding: 48px 0; }
    .laitm-trans-panel { max-width: 100%; }
  }
</style>

{% schema %}
{
  "name": "Lawn Transition Banner",
  "tag": "section",
  "class": "section-laitm-trans",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Also in your yard"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Garden essentials, sorted. Now let's tackle the lawn."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "From shade structures to the mower that keeps everything under it looking sharp — explore ride mowers built for real acreage."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Label",
      "default": "Shop Ride Mowers"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link"
    },
    {
      "type": "text",
      "id": "bg_image_url",
      "label": "Background Image URL",
      "default": "https://laitm.com/wp-content/uploads/2026/07/s-scaled.jpg"
    }
  ],
  "presets": [
    {
      "name": "Lawn Transition Banner",
      "settings": {
        "kicker": "Also in your yard",
        "heading": "Garden essentials, sorted. Now let's tackle the lawn.",
        "subtext": "From shade structures to the mower that keeps everything under it looking sharp — explore ride mowers built for real acreage.",
        "cta_label": "Shop Ride Mowers",
        "cta_link": "/collections/types?q=Riding+Lawn+Mowers",
        "bg_image_url": "https://laitm.com/wp-content/uploads/2026/07/s-scaled.jpg"
      }
    }
  ]
}
{% endschema %}
