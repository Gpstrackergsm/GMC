{%- liquid
  assign eyebrow = section.settings.eyebrow | default: 'Customer stories'
  assign heading = section.settings.heading | default: 'What Our Customers Say'
  assign sub = section.settings.subtext | default: "Real feedback from people who've bought from Deere LLC."
-%}

<section class="laitm-testi-section page-width" style="padding: 72px 0;">
  <div class="laitm-testi-wrap">
    <div class="laitm-testi-head">
      <p class="laitm-testi-eyebrow">{{ eyebrow }}</p>
      <h2 class="laitm-testi-title">{{ heading }}</h2>
      <p class="laitm-testi-sub">{{ sub }}</p>
    </div>

    <div class="laitm-testi-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'testimonial' -%}
          {%- assign rating = block.settings.rating | default: 5 -%}
          <div class="laitm-testi-card" {{ block.shopify_attributes }}>
            <div class="laitm-testi-stars" aria-label="{{ rating }} out of 5 stars">
              {%- for i in (1..5) -%}
                <svg fill="{% if i <= rating %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24" width="18" height="18"><path d="M12 2l2.9 6.26L21 9.27l-4.5 4.39L17.8 21 12 17.77 6.2 21l1.3-7.34L3 9.27l6.1-1.01z"/></svg>
              {%- endfor -%}
            </div>
            <p class="laitm-testi-quote">"{{ block.settings.quote }}"</p>
            <div class="laitm-testi-footer">
              <span class="laitm-testi-name">{{ block.settings.author }}</span>
              <span class="laitm-testi-meta">Verified Deere LLC buyer</span>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="laitm-testi-strip" aria-hidden="true">
      <span>⭐ Verified buyers</span>
      <span>·</span>
      <span>Real orders, real reviews</span>
      <span>·</span>
      <span>Shipped & fulfilled by Deere LLC</span>
    </div>
  </div>
</section>

<style>
  .laitm-testi-wrap {
    font-family: "Inter", -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
  .laitm-testi-head {
    text-align: center;
    margin-bottom: 48px;
  }
  .laitm-testi-eyebrow {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: #367C2B;
    margin: 0 0 10px;
  }
  .laitm-testi-title {
    font-size: clamp(1.5rem, 2.8vw, 2.2rem);
    font-weight: 800;
    color: #111111;
    margin: 0 0 12px;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .laitm-testi-sub {
    font-family: "Open Sans", sans-serif;
    font-size: 15px;
    color: #555555;
    max-width: 520px;
    margin: 0 auto;
    line-height: 1.6;
  }
  .laitm-testi-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 40px;
  }
  .laitm-testi-card {
    background: #ffffff;
    border: 1px solid #E2E2E2;
    border-radius: 8px;
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .laitm-testi-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    border-color: #367C2B;
  }
  .laitm-testi-stars {
    display: flex;
    gap: 2px;
    color: #FFDE00;
  }
  .laitm-testi-quote {
    font-size: 15px;
    color: #1c1a16;
    line-height: 1.65;
    margin: 0;
    flex: 1;
    font-style: italic;
  }
  .laitm-testi-footer {
    display: flex;
    flex-direction: column;
    gap: 3px;
    border-top: 1px solid rgba(28,26,22,.06);
    padding-top: 14px;
  }
  .laitm-testi-name {
    font-weight: 700;
    font-size: 14px;
    color: #1c1a16;
  }
  .laitm-testi-meta {
    font-size: 12px;
    color: #57534e;
  }
  .laitm-testi-strip {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    font-size: 13px;
    color: #57534e;
    background: #F7F7F7;
    border: 1px solid #E2E2E2;
    border-radius: 8px;
    padding: 14px 24px;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .laitm-testi-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 540px) {
    .laitm-testi-grid { grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "section-laitm-testimonials",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Customer stories"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Our Customers Say"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Real feedback from people who've bought from Deere LLC."
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Star Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review Quote"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Reviewer Name",
          "default": "J. Martinez"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "quote": "Ordering our John Deere S120 was effortless. Freight delivery driver called 24 hours ahead and lowered it right onto our driveway with the hydraulic liftgate. Started right up!",
            "author": "J. Martinez"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "quote": "The ride mower cut our mowing time in half. Customer support was quick to answer a question about the warranty before I even checked out.",
            "author": "K. Anderson"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "quote": "Crating was heavy-duty and factory sealed. The ZTrak zero-turn handles our 3-acre property effortlessly with zero scalping. Exceptional service and fast delivery.",
            "author": "R. Okafor"
          }
        }
      ]
    }
  ]
}
{% endschema %}
