<div class="trust-bar-section page-width" style="padding: 24px 0 32px;">
  <div class="trust-bar-grid">
    <div class="trust-bar-card">
      <div class="trust-bar-icon-wrap">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="1" y="3" width="15" height="13"></rect>
          <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
          <circle cx="5.5" cy="18.5" r="2.5"></circle>
          <circle cx="18.5" cy="18.5" r="2.5"></circle>
        </svg>
      </div>
      <div class="trust-bar-text">
        <h4 class="trust-bar-heading">Free US & Canada Freight</h4>
        <p class="trust-bar-desc">Complimentary residential liftgate delivery to United States & Canada.</p>
      </div>
    </div>

    <div class="trust-bar-card">
      <div class="trust-bar-icon-wrap" style="color: #367C2B; background: #EEF7EC;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#275e20" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          <polyline points="9 12 11 14 15 10"></polyline>
        </svg>
      </div>
      <div class="trust-bar-text">
        <h4 class="trust-bar-heading" style="color: #275e20; font-weight: 800;">Guaranteed Secure Checkout</h4>
        <p class="trust-bar-desc">Encrypted 256-bit checkout with major credit cards, Shop Pay, PayPal, and Apple Pay.</p>
      </div>
    </div>

    <div class="trust-bar-card">
      <div class="trust-bar-icon-wrap">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
      </div>
      <div class="trust-bar-text">
        <h4 class="trust-bar-heading">Certified Support</h4>
        <p class="trust-bar-desc">Talk directly with equipment specialists. Toll-Free: 1-800-614-2395.</p>
      </div>
    </div>

    <div class="trust-bar-card">
      <div class="trust-bar-icon-wrap">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
      </div>
      <div class="trust-bar-text">
        <h4 class="trust-bar-heading">Factory US Warranty</h4>
        <p class="trust-bar-desc">100% genuine equipment covered by authorized manufacturer warranty protection.</p>
      </div>
    </div>
  </div>
</div>

<style>
  .trust-bar-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .trust-bar-card {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    background: #FFFFFF;
    border: 1px solid #E2E2E2;
    border-radius: 8px;
    padding: 18px 16px;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }
  .trust-bar-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(0,0,0,0.06);
    border-color: #367C2B;
  }
  .trust-bar-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    background: #EEF7EC;
    color: #367C2B;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .trust-bar-heading {
    font-family: "Inter", -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 14.5px;
    font-weight: 700;
    color: #111111;
    margin: 0 0 4px;
    line-height: 1.3;
  }
  .trust-bar-desc {
    font-family: "Open Sans", sans-serif;
    font-size: 12.5px;
    color: #555555;
    margin: 0;
    line-height: 1.45;
  }
  @media (max-width: 991px) {
    .trust-bar-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
  }
  @media (max-width: 575px) {
    .trust-bar-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }
    .trust-bar-card {
      padding: 12px 10px;
      gap: 10px;
      border-radius: 6px;
    }
    .trust-bar-icon-wrap {
      width: 34px;
      height: 34px;
    }
    .trust-bar-icon-wrap svg {
      width: 18px;
      height: 18px;
    }
    .trust-bar-heading {
      font-size: 12.5px;
      margin-bottom: 2px;
    }
    .trust-bar-desc {
      font-size: 11px;
      line-height: 1.35;
    }
  }
</style>

{% schema %}
{
  "name": "Laitm Trust Bar",
  "tag": "section",
  "class": "section-trust-bar",
  "settings": [],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust Item",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon",
          "default": "truck"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Free Shipping"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext",
          "default": "On all orders over $50"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Laitm Trust Bar",
      "blocks": [
        { "type": "trust_item" },
        { "type": "trust_item" },
        { "type": "trust_item" },
        { "type": "trust_item" }
      ]
    }
  ]
}
{% endschema %}
