<div class="trust-bar-section" style="background-color: {{ section.settings.bg_color | default: '#F4F6F4' }}; border-top: 1px solid var(--color-border, #E8E8E0); border-bottom: 1px solid var(--color-border, #E8E8E0); padding: 2.5rem 0;">
  <div class="container">
    <div class="trust-bar-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; align-items: stretch;">
      {%- for block in section.blocks -%}
        <div class="trust-bar-card" {{ block.shopify_attributes }} style="display: flex; align-items: center; gap: 1.25rem; padding: 1.25rem 1.5rem; background: #ffffff; border-radius: 12px; border: 1px solid #E8E8E0; box-shadow: 0 2px 8px rgba(0,0,0,0.02); transition: transform 0.2s, box-shadow 0.2s;">
          <div class="trust-bar-icon-wrap" style="flex-shrink: 0; width: 48px; height: 48px; border-radius: 10px; background: #E8F5EE; color: #2D6A4F; display: flex; align-items: center; justify-content: center;">
            {%- case block.settings.icon -%}
              {%- when 'truck' -%}
                {% render 'icon-truck' %}
              {%- when 'return' -%}
                {% render 'icon-return' %}
              {%- when 'shield' -%}
                {% render 'icon-shield' %}
              {%- when 'lock' -%}
                {% render 'icon-lock' %}
              {%- when 'phone' -%}
                {% render 'icon-phone' %}
              {%- else -%}
                {% render 'icon-check' %}
            {%- endcase -%}
          </div>
          <div class="trust-bar-text">
            <h3 style="font-family: var(--font-body-family, sans-serif); font-size: 1rem; font-weight: 700; margin-bottom: 0.25rem; color: #1A1A1A; line-height: 1.3;">
              {{ block.settings.heading }}
            </h3>
            <p style="font-size: 0.85rem; color: #666; margin: 0; line-height: 1.45;">
              {{ block.settings.text }}
            </p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .trust-bar-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0,0,0,0.06);
    border-color: #2D6A4F;
  }
  .trust-bar-icon-wrap svg {
    width: 24px;
    height: 24px;
  }
</style>

{% schema %}
{
  "name": "Trust Bar",
  "tag": "section",
  "class": "section-trust-bar",
  "max_blocks": 6,
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F4F6F4"
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust Signal",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Shipping Truck" },
            { "value": "return", "label": "Easy Returns" },
            { "value": "shield", "label": "Verified Quality" },
            { "value": "lock", "label": "Secure Checkout" },
            { "value": "phone", "label": "Support" }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Fast Tracked Shipping"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Subtext",
          "default": "Real-time tracking on every carrier order."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Bar",
      "blocks": [
        {
          "type": "trust_item",
          "settings": {
            "icon": "truck",
            "heading": "Fast Tracked Shipping",
            "text": "Direct carrier dispatch with live tracking updates."
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "return",
            "heading": "30-Day Money Back",
            "text": "Straightforward 30-day return window on all items."
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "shield",
            "heading": "100% Verified Specs",
            "text": "Authentic GTIN/UPC & manufacturer MPNs."
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "lock",
            "heading": "256-Bit SSL Checkout",
            "text": "Bank-grade encrypted payments via Visa, Apple Pay & Google Pay."
          }
        }
      ]
    }
  ]
}
{% endschema %}
