<div class="laitm-topbar">
  <div class="laitm-topbar__inner page-width">
    <p class="laitm-topbar__message">
      {{ section.settings.message | default: '🚜 OFFICIAL US DIRECT FREIGHT • FREE RESIDENTIAL LIFTGATE DELIVERY • 100% FACTORY SEALED • TOLL-FREE: 1-800-614-2395' }}
    </p>
  </div>
</div>

<style>
  .laitm-topbar {
    background-color: {{ section.settings.bg_color | default: '#1E3F20' }};
    color: #ffffff;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    position: relative;
    z-index: 101;
    border-bottom: 2px solid #FFDE00;
  }
  .laitm-topbar__inner {
    width: 100%;
    text-align: center;
    padding: 0 16px;
  }
  .laitm-topbar__message {
    font-family: "Inter", -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin: 0;
    color: #ffffff;
    line-height: 40px;
  }
</style>

{% schema %}
{
  "name": "Announcement Bar",
  "class": "section-announcement-bar",
  "settings": [
    {
      "type": "text",
      "id": "message",
      "label": "Announcement text",
      "default": "🚚 FREE RESIDENTIAL LIFTGATE FREIGHT ON ALL RIDING MOWERS | 100% US FACTORY WARRANTY | CALL TOLL-FREE: 1-800-614-2395"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#1E3F20"
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar"
    }
  ]
}
{% endschema %}
