<div class="rich-text section-padding" style="padding: {{ section.settings.padding_top | default: 48 }}px 0 {{ section.settings.padding_bottom | default: 48 }}px 0; background-color: {{ section.settings.bg_color | default: 'transparent' }};">
  <div class="container" style="max-width: 800px; margin: 0 auto; text-align: {{ section.settings.text_alignment | default: 'center' }};">
    {%- if section.settings.subheading != blank -%}
      <span class="subheading" style="text-transform: uppercase; font-size: 0.8rem; letter-spacing: 1.5px; font-weight: 600; color: var(--color-primary, #2D6A4F); margin-bottom: 0.75rem; display: block;">
        {{ section.settings.subheading }}
      </span>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="heading" style="font-family: var(--font-heading-family, serif); font-size: 2.2rem; line-height: 1.3; margin-bottom: 1.25rem; color: var(--color-text, #1A1A1A);">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="rte" style="font-size: 1.1rem; line-height: 1.8; color: #4A4A4A; margin-bottom: 2rem;">
        {{ section.settings.text }}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="btn btn--primary" style="display: inline-block; padding: 0.85rem 2rem; background: var(--color-primary, #2D6A4F); color: #ffffff; text-decoration: none; border-radius: 6px; font-weight: 600;">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Rich Text",
  "tag": "section",
  "class": "section-rich-text",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading / Badge"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Committed to Quality, Utility & Transparency"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We believe in clear product data, honest specifications, and reliable delivery. Every item in our general store has been selected to solve practical everyday needs.</p>"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Rich Text"
    }
  ]
}
{% endschema %}
