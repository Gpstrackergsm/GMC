            <li><a href="/collections/types?q=Robotic+Mowers">🤖 Autonomous &amp; Robotic Smart Mowers</a></li>
          </ul>
        </div>
      </div>

      <!-- Center: Deere Nav Links -->
      <nav class="deere-nav" aria-label="Main Navigation">
        <ul class="deere-nav__list">
          <li><a href="/" class="deere-nav__link {% if request.path == '/' %}is-active{% endif %}">Home</a></li>
          <li><a href="/collections/types?q=Riding+Lawn+Mowers" class="deere-nav__link">Riding Mowers</a></li>
          <li><a href="/collections/types?q=Riding+Lawn+Mowers" class="deere-nav__link">Zero-Turn Mowers</a></li>
          <li><a href="/collections/types?q=Tow-Behind+Mowers" class="deere-nav__link">Attachments</a></li>
          <li><a href="/collections/all" class="deere-nav__link {% if request.path contains '/collections' %}is-active{% endif %}">Shop All</a></li>
          <li><a href="/pages/shipping-policy" class="deere-nav__link">Shipping &amp; Delivery</a></li>
          <li><a href="/pages/contact-us" class="deere-nav__link">Contact Support</a></li>
          <li><a href="/#shopify-section-faq-accordion" class="deere-nav__link">FAQs</a></li>
        </ul>
      </nav>

      <!-- Right: Direct Toll-Free Phone -->
      <div class="deere-header__contact">
        <a href="tel:+18006142395" class="deere-header__phone">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#367C2B" stroke-width="2.4" stroke-linecap="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
