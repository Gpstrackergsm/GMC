<header class="deere-header" role="banner">
  <!-- Top Black Friday Announcement Banner -->
  <div class="black-friday-banner" style="background: #000000; color: #FFFFFF; font-size: 0.85rem; padding: 10px 16px; text-align: center; border-bottom: 2px solid #FFDE00; font-family: 'Inter', -apple-system, sans-serif; font-weight: 700; letter-spacing: 0.02em;">
    <div class="page-width" style="display: flex; align-items: center; justify-content: center; gap: 12px; flex-wrap: wrap;">
      <span style="background: #EB001B; color: #FFFFFF; font-size: 0.72rem; font-weight: 900; padding: 3px 8px; border-radius: 4px; letter-spacing: 0.08em; text-transform: uppercase;">🔥 BLACK FRIDAY DOORBUSTER</span>
      <span>EARLY ACCESS SALE: <strong>UP TO 60% OFF RIDING MOWERS &amp; ZERO-TURNS</strong></span>
      <span style="color: #FFDE00;">•</span>
      <span style="color: #85D472;">🚚 100% Free Liftgate Delivery Included</span>
      <span style="color: #FFDE00;">•</span>
      <span style="color: #FFDE00; font-weight: 800;">LIMITED WAREHOUSE STOCK</span>
    </div>
  </div>

  <!-- UTILITY BAR (John Deere Global Utility Strip) -->
  <div class="deere-header__utility">
    <div class="page-width deere-header__utility-inner">
      <div class="deere-utility-left">
        <span class="deere-utility-item deere-utility-country">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
          United States (English)
        </span>
        <a href="/pages/contact-us" class="deere-utility-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          Find Equipment / Dealer
        </a>
        <a href="/pages/shipping-policy" class="deere-utility-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
          Track Freight Order
        </a>
      </div>

      <div class="deere-utility-right">
        <span class="deere-utility-item deere-highlight-tag">
          <span class="deere-yellow-dot"></span>
          Free US Residential Liftgate Delivery
        </span>
        <a href="tel:+18006142395" class="deere-utility-item deere-utility-phone">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          1-800-614-2395
        </a>
        <a href="/account" class="deere-utility-item">Sign In</a>
      </div>
    </div>
  </div>

  <!-- ROW 1: Logo, Search Bar, User Tools -->
  <div class="deere-header__main">
    <div class="page-width deere-header__main-inner">
      <!-- Mobile Menu Toggle -->
      <button type="button" class="deere-header__mobile-toggle" aria-label="Open navigation menu" onclick="document.getElementById('DeereMobileDrawer').classList.add('is-open');">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>

      <!-- Mower Haven Brand Logo -->
      <a href="{{ routes.root_url }}" class="deere-header__logo" aria-label="Mower Haven Home">
        <span class="deere-logo-wrap">
          <svg class="deere-logo-icon" width="46" height="42" viewBox="0 0 46 42" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="1.5" y="1.5" width="43" height="39" rx="8" fill="#1E3F20" stroke="#FFDE00" stroke-width="2.5"/>
            <!-- Custom Mower Silhouette in Equipment Gold -->
            <path d="M12 28 C12 25.5 14 23.5 16.5 23.5 C19 23.5 21 25.5 21 28 C21 30.5 19 32.5 16.5 32.5 C14 32.5 12 30.5 12 28 Z" fill="#FFDE00"/>
            <circle cx="16.5" cy="28" r="2.2" fill="#1E3F20"/>
            <path d="M29 27 C29 24.8 30.8 23 33 23 C35.2 23 37 24.8 37 27 C37 29.2 35.2 31 33 31 C30.8 31 29 29.2 29 27 Z" fill="#FFDE00"/>
            <circle cx="33" cy="27" r="2" fill="#1E3F20"/>
            <path d="M16 23.5 L19 15 L26 15 L28 19 L34 19 L35 24 L28 24 L27 23.5 L20 23.5 Z" fill="#FFDE00"/>
            <path d="M23 15 L24 11 M22 11 L26 11" stroke="#FFDE00" stroke-width="2" stroke-linecap="round"/>
            <path d="M17 19 L19 19 L19 15" stroke="#FFDE00" stroke-width="2.2" stroke-linecap="round"/>
            <path d="M9 34 L37 34" stroke="#85D472" stroke-width="2" stroke-linecap="round"/>
          </svg>
          <span class="deere-logo-brand">
            <span class="deere-logo-text" style="font-weight: 900; letter-spacing: -0.01em;">MOWER HAVEN</span>
            <span class="deere-logo-sub" style="font-size: 8.5px; letter-spacing: 0.12em; color: #166534; font-weight: 800;">OUTDOOR POWER &amp; TURF</span>
          </span>
        </span>
      </a>

      <!-- Center Equipment Search Bar -->
      <div class="deere-header__search">
        <form action="{{ routes.search_url }}" method="get" class="deere-search-form" role="search">
          <input type="hidden" name="type" value="product">
          <input
            type="search"
            name="q"
            class="deere-search-input"
            placeholder="Search equipment, lawn tractors, zero-turns, parts..."
            value="{{ search.terms | escape }}"
            autocomplete="off"
            required
          >
          <button type="submit" class="deere-search-btn" aria-label="Search equipment">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </button>
        </form>
      </div>

      <!-- Right Action Tools: Account, Wishlist, Cart Drawer -->
      <div class="deere-header__tools">
        <!-- Account -->
        <a href="/account" class="deere-tool-btn deere-tool-account" aria-label="Account" title="My Equipment Account">
          <div class="deere-account-circle">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </div>
        </a>

        <!-- Wishlist / Catalog -->
        <a href="/collections/all" class="deere-tool-btn deere-tool-wishlist" aria-label="Saved Equipment" title="Saved Equipment">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
          <span class="deere-tool-badge">0</span>
        </a>

        <!-- Cart Pill Button with John Deere Yellow Badge -->
        <a href="/cart" class="deere-header-cart" aria-label="Shopping Cart" data-drawer-trigger="cart">
          <div class="deere-cart-inner">
            <div class="deere-cart-icon-wrap">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <path d="M16 10a4 4 0 0 1-8 0"></path>
              </svg>
              <span class="deere-cart-count" data-cart-count>{{ cart.item_count }}</span>
            </div>
            <span class="deere-cart-total" data-cart-total>{{ cart.total_price | money }}</span>
          </div>
        </a>
      </div>
    </div>
  </div>

  <!-- ROW 2: Primary Equipment Categories & Navigation -->
  <div class="deere-header__nav-row">
    <div class="page-width deere-header__nav-inner">
