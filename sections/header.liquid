<style>
  .deere-header {
    background: #ffffff;
    width: 100%;
    position: relative;
    z-index: 100;
    box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    font-family: "Inter", -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  /* Utility Strip */
  .deere-header__utility {
    background: #1E3F20;
    color: #E2E8F0;
    font-size: 11.5px;
    height: 32px;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }
  .deere-header__utility-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    padding: 0 16px;
  }
  .deere-utility-left,
  .deere-utility-right {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .deere-utility-item {
    color: #E2E8F0;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 500;
    transition: color 0.15s;
  }
  .deere-utility-item:hover {
    color: #FFDE00;
  }
  .deere-highlight-tag {
    color: #FFDE00;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .deere-yellow-dot {
    width: 7px;
    height: 7px;
    background: #FFDE00;
    border-radius: 50%;
    display: inline-block;
  }
  .deere-utility-phone {
    font-weight: 700;
    color: #FFFFFF;
  }

  /* Main Header Row */
  .deere-header__main {
    border-bottom: 1px solid #EAEAEA;
    padding: 14px 0;
    background: #FFFFFF;
  }
  .deere-header__main-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
  }
  .deere-header__mobile-toggle {
    display: none;
    background: none;
    border: none;
    color: #111111;
    cursor: pointer;
    padding: 6px;
  }

  /* John Deere Logo */
  .deere-header__logo {
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
  }
  .deere-logo-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .deere-logo-icon {
    flex-shrink: 0;
    filter: drop-shadow(0 2px 4px rgba(54, 124, 43, 0.2));
  }
  .deere-logo-brand {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }
  .deere-logo-text {
    font-family: "Inter", sans-serif;
    font-size: 24px;
    font-weight: 900;
    color: #111111;
    letter-spacing: -0.02em;
  }
  .deere-logo-sub {
    font-family: "Inter", sans-serif;
    font-size: 8.5px;
    font-weight: 800;
    color: #367C2B;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-top: 3px;
  }

  /* Search */
  .deere-header__search {
    flex: 1;
    max-width: 540px;
  }
  .deere-search-form {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }
  .deere-search-input {
    width: 100%;
    height: 44px;
    padding: 0 50px 0 20px;
    background: #F7F7F7;
    border: 1.5px solid #E2E2E2;
    border-radius: 999px;
    font-family: "Open Sans", sans-serif;
    font-size: 14px;
    color: #111111;
    outline: none;
    transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
  }
  .deere-search-input:focus {
    background: #ffffff;
    border-color: #367C2B;
    box-shadow: 0 0 0 3px rgba(54, 124, 43, 0.15);
  }
  .deere-search-btn {
    position: absolute;
    right: 5px;
    top: 50%;
    transform: translateY(-50%);
    width: 34px;
    height: 34px;
    background: #367C2B;
    border: none;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border-radius: 50%;
    transition: background 0.2s;
  }
  .deere-search-btn:hover {
    background: #275e20;
  }

  /* Tools */
  .deere-header__tools {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }
  .deere-tool-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #111111;
    text-decoration: none;
    transition: color 0.2s;
  }
  .deere-account-circle {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #367C2B;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, transform 0.2s;
  }
  .deere-account-circle:hover {
    background: #275e20;
    transform: scale(1.04);
  }
  .deere-tool-wishlist {
    color: #555555;
    padding: 6px;
  }
  .deere-tool-wishlist:hover {
    color: #367C2B;
  }
  .deere-tool-badge {
    position: absolute;
    top: -2px;
    right: -4px;
    background: #FFDE00;
    color: #111111;
    font-size: 11px;
    font-weight: 800;
    min-width: 17px;
    height: 17px;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
  }

  /* Cart Pill Button */
  .deere-header-cart {
    text-decoration: none;
    color: inherit;
    display: flex;
    align-items: center;
  }
  .deere-cart-inner {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #111111;
    color: #ffffff;
    padding: 8px 18px;
    border-radius: 999px;
    transition: background 0.2s, transform 0.2s;
  }
  .deere-cart-inner:hover {
    background: #367C2B;
    transform: translateY(-1px);
  }
  .deere-cart-icon-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }
  .deere-cart-count {
    position: absolute;
    top: -8px;
    right: -10px;
    background: #FFDE00;
    color: #111111;
    font-size: 10.5px;
    font-weight: 900;
    min-width: 17px;
    height: 17px;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
    border: 1.5px solid #111111;
  }
  .deere-cart-total {
    font-family: "Inter", sans-serif;
    font-size: 13.5px;
    font-weight: 700;
    color: #ffffff;
  }

  /* ROW 2: Primary Sub-Nav */
  .deere-header__nav-row {
    background: #FFFFFF;
    border-bottom: 2px solid #E2E2E2;
    height: 48px;
  }
  .deere-header__nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    gap: 20px;
  }

  /* Products & Solutions Dropdown */
  .deere-cats-dropdown-wrap {
    position: relative;
    height: 100%;
    display: flex;
    align-items: flex-end;
  }
  .deere-cats-btn {
    background: #367C2B;
    color: #ffffff;
    border: none;
    height: 44px;
    padding: 0 20px;
    border-radius: 6px 6px 0 0;
    font-family: "Inter", sans-serif;
    font-size: 13.5px;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    transition: background 0.2s;
  }
  .deere-cats-btn:hover {
    background: #275e20;
  }
  .deere-cats-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    width: 290px;
    background: #ffffff;
    border: 1px solid #E2E2E2;
    border-top: 3px solid #FFDE00;
    border-radius: 0 0 8px 8px;
    box-shadow: 0 16px 36px rgba(0,0,0,0.12);
    z-index: 200;
  }
  .deere-cats-dropdown-wrap:hover .deere-cats-menu,
  .deere-cats-dropdown-wrap.is-open .deere-cats-menu {
    display: block;
  }
  .deere-cats-menu ul {
    list-style: none;
    padding: 8px 0;
    margin: 0;
  }
  .deere-cats-menu li a {
    display: block;
    padding: 10px 18px;
    color: #111111;
    text-decoration: none;
    font-size: 13.5px;
    font-weight: 600;
    transition: background 0.15s, color 0.15s;
  }
  .deere-cats-menu li a:hover {
    background: #EEF7EC;
    color: #367C2B;
  }

  /* Center Nav Links */
  .deere-nav {
    flex: 1;
  }
  .deere-nav__list {
    display: flex;
    align-items: center;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .deere-nav__link {
    font-family: "Inter", sans-serif;
    font-size: 13.5px;
    font-weight: 600;
    color: #222222;
    text-decoration: none;
    transition: color 0.2s;
    padding: 6px 0;
    position: relative;
  }
  .deere-nav__link:hover,
  .deere-nav__link.is-active {
    color: #367C2B;
  }
  .deere-nav__link.is-active::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 0;
    right: 0;
    height: 3px;
    background: #367C2B;
    border-radius: 2px;
  }

  /* Right Phone */
  .deere-header__contact {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .deere-header__phone {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #367C2B;
    font-weight: 800;
    font-size: 13px;
    text-decoration: none;
  }

  /* Mobile Drawer */
  .deere-mobile-drawer {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
  }
  .deere-mobile-drawer.is-open {
    display: block;
  }
  .deere-mobile-drawer__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.6);
  }
  .deere-mobile-drawer__panel {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 85%;
    max-width: 330px;
    background: #ffffff;
    padding: 24px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .deere-mobile-drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .deere-mobile-drawer__close {
    background: none;
    border: none;
    font-size: 28px;
    cursor: pointer;
    color: #555555;
  }
  .deere-mobile-search {
    display: flex;
    gap: 8px;
  }
  .deere-mobile-search input {
    flex: 1;
    padding: 10px 14px;
    border: 1px solid #E2E2E2;
    border-radius: 6px;
    font-size: 14px;
  }
  .deere-mobile-search button {
    background: #367C2B;
    color: #fff;
    border: none;
    border-radius: 6px;
    padding: 0 14px;
    font-weight: 700;
  }
  .deere-mobile-nav h4 {
    margin: 16px 0 8px;
    font-size: 11.5px;
    text-transform: uppercase;
    color: #888888;
    letter-spacing: 0.05em;
  }
  .deere-mobile-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .deere-mobile-nav li a {
    display: block;
    padding: 9px 0;
    color: #111111;
    text-decoration: none;
    font-size: 14.5px;
    font-weight: 600;
  }
  .deere-mobile-contact {
    margin-top: auto;
    border-top: 1px solid #E2E2E2;
    padding-top: 16px;
    font-size: 12px;
    color: #666666;
  }

  @media (max-width: 1080px) {
    .deere-header__contact { display: none; }
    .deere-utility-right .deere-highlight-tag { display: none; }
  }
  @media (max-width: 860px) {
    .deere-header__utility { display: none; }
    .deere-header__mobile-toggle { display: block; }
    .deere-header__search { display: none; }
    .deere-tool-wishlist { display: none; }
    .deere-header__nav-row { display: none; }
    .deere-cart-total { display: none; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var btn = document.getElementById('DeereCatsBtn');
    if (btn) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        var wrap = btn.closest('.deere-cats-dropdown-wrap');
        wrap.classList.toggle('is-open');
      });
    }
    document.addEventListener('click', function() {
      var wrap = document.querySelector('.deere-cats-dropdown-wrap.is-open');
      if (wrap) wrap.classList.remove('is-open');
    });
  });
</script>

