{%- comment -%}
  Section: laitm-spotlight.liquid
  Mirrors the laitm-spot-wrap section: featured product with image + copy
{%- endcomment -%}

{%- liquid
  assign spot_product = section.settings.product
  assign spot_img = section.settings.override_image_url
  assign spot_eyebrow = section.settings.eyebrow | default: 'John Deere Flagship Series'
  assign spot_title = section.settings.title_override
  assign spot_desc = section.settings.description_override
  assign spot_price = section.settings.price_override
  assign spot_cta_label = section.settings.cta_label | default: 'Order Now — Free Liftgate'
  assign spot_cta_link = section.settings.cta_link | default: '/products/john-deere-s120-mower-42-in-22-hp-v-twin-gas-hydrostatic-riding-lawn-mower'
  assign spot_secondary_label = section.settings.secondary_label | default: 'Explore All Riding Mowers'
  assign spot_secondary_link = section.settings.secondary_link | default: '/collections/types?q=Riding+Lawn+Mowers'

  if spot_product != blank
    assign spot_title = spot_title | default: spot_product.title
    assign spot_desc = spot_desc | default: spot_product.description
    assign spot_cta_link = spot_cta_link | default: spot_product.url
    assign cv = spot_product.selected_or_first_available_variant
    if spot_price == blank
      assign spot_price = cv.price | money
    endif
    if spot_img == blank and spot_product.featured_image != blank
      assign spot_shopify_img = spot_product.featured_image
    endif
  endif
-%}

<section class="laitm-spot-section page-width" style="padding: 64px 0;">
  <div class="laitm-spot-wrap">
    <div class="laitm-spot-grid">

      <!-- Media -->
      <div class="laitm-spot-media">
        <span class="laitm-spot-featured-tag">
          <svg fill="currentColor" viewBox="0 0 24 24" width="14" height="14"><path d="M12 2l2.9 6.26L21 9.27l-4.5 4.39L17.8 21 12 17.77 6.2 21l1.3-7.34L3 9.27l6.1-1.01z"/></svg>
          Featured product
        </span>
        {%- if spot_img != blank -%}
          <img src="{{ spot_img }}" alt="{{ spot_title | escape }}" loading="lazy" class="laitm-spot-img">
        {%- elsif spot_shopify_img != blank -%}
          <img src="{{ spot_shopify_img | image_url: width: 900 }}" alt="{{ spot_title | escape }}" loading="lazy" class="laitm-spot-img">
        {%- else -%}
          <img src="https://laitm.com/wp-content/uploads/2026/07/collohaan-laitm-scaled.jpg" alt="{{ spot_title | default: 'Featured Product' | escape }}" loading="lazy" class="laitm-spot-img">
        {%- endif -%}
      </div>

      <!-- Copy -->
      <div class="laitm-spot-copy">
        {%- if spot_eyebrow != blank -%}
          <p class="laitm-spot-eyebrow">{{ spot_eyebrow }}</p>
        {%- endif -%}

        <h2 class="laitm-spot-title">{{ spot_title | default: 'Featured Garden Product' }}</h2>

        <p class="laitm-spot-desc">{{ spot_desc | default: 'A premium outdoor product built for durability and everyday use.' }}</p>

        <ul class="laitm-spot-features">
          {%- for block in section.blocks -%}
            {%- if block.type == 'feature' -%}
              <li {{ block.shopify_attributes }}>
                <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4" viewBox="0 0 24 24" width="18" height="18"><path d="M20 6L9 17l-5-5"/></svg>
                {{ block.settings.text }}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>

        <div class="laitm-spot-price-row">
          <span class="laitm-spot-price">{{ spot_price | default: '$1,129.00' }}</span>
        </div>

        <div class="laitm-spot-actions">
          <a class="laitm-spot-cta" href="{{ spot_cta_link }}">
            {{ spot_cta_label }}
            <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2.4" viewBox="0 0 24 24" width="16" height="16"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a class="laitm-spot-cta-secondary" href="{{ spot_secondary_link }}">
            {{ spot_secondary_label }}
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .laitm-spot-wrap {
    --deere-green: #367C2B;
    --deere-green-dark: #275e20;
    --deere-green-tint: #EEF7EC;
    --deere-yellow: #FFDE00;
    --deere-yellow-hover: #E6C800;
    --deere-ink: #111111;
    --deere-ink-soft: #4A4A4A;
    font-family: "Inter", -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: #F7F7F7;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #E2E2E2;
    box-shadow: 0 4px 18px rgba(0,0,0,0.04);
  }
  .laitm-spot-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    min-height: 480px;
  }
  .laitm-spot-media {
    position: relative;
    height: 100%;
    min-height: 480px;
    background: #FFFFFF;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    border-right: 1px solid #E2E2E2;
  }
  .laitm-spot-featured-tag {
    position: absolute;
    top: 20px;
    left: 20px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    font-weight: 800;
    color: #111111;
    background: #FFDE00;
    border: 1px solid rgba(0,0,0,.1);
    border-radius: 4px;
    padding: 5px 12px;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .laitm-spot-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    max-height: 420px;
    transition: transform 0.4s ease;
  }
  .laitm-spot-media:hover .laitm-spot-img {
    transform: scale(1.03);
  }
  .laitm-spot-copy {
    padding: 48px 44px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .laitm-spot-eyebrow {
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .1em;
    color: var(--deere-green);
    margin: 0;
  }
  .laitm-spot-title {
    font-family: "Inter", sans-serif;
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    font-weight: 800;
    color: var(--deere-ink);
    line-height: 1.25;
    margin: 0;
  }
  .laitm-spot-desc {
    font-family: "Open Sans", sans-serif;
    font-size: 15px;
    color: var(--deere-ink-soft);
    line-height: 1.6;
    margin: 0;
  }
  .laitm-spot-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .laitm-spot-features li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 14px;
    color: var(--deere-ink);
    font-weight: 600;
  }
  .laitm-spot-features li svg { color: var(--deere-green); flex-shrink: 0; margin-top: 2px; }
  .laitm-spot-price-row { display: flex; align-items: center; gap: 12px; }
  .laitm-spot-price {
    font-size: 1.75rem;
    font-weight: 900;
    color: var(--deere-green);
    letter-spacing: -.02em;
  }
  .laitm-spot-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; margin-top: 6px; }
  .laitm-spot-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    background: var(--deere-yellow);
    color: #111111;
    font-family: "Inter", sans-serif;
    font-size: 14px;
    font-weight: 800;
    border-radius: 6px;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(255,222,0,.35);
    transition: background 0.2s, transform 0.2s;
  }
  .laitm-spot-cta:hover { background: var(--deere-yellow-hover); transform: translateY(-1px); color: #000000; }
  .laitm-spot-cta-secondary {
    display: inline-flex;
    align-items: center;
    font-size: 14px;
    font-weight: 700;
    color: var(--deere-green);
    background: #FFFFFF;
    border: 2px solid var(--deere-green);
    padding: 12px 22px;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.2s;
  }
  .laitm-spot-cta-secondary:hover {
    background: var(--deere-green);
    color: #FFFFFF;
  }
  }
  .laitm-spot-cta-secondary:hover { text-decoration-color: var(--laitm-green); }

  @media (max-width: 768px) {
    .laitm-spot-grid { grid-template-columns: 1fr; }
    .laitm-spot-media { min-height: 280px; }
    .laitm-spot-img { min-height: 280px; }
    .laitm-spot-copy { padding: 32px 24px; }
  }
</style>

{% schema %}
{
  "name": "Product Spotlight",
  "tag": "section",
  "class": "section-laitm-spotlight",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Featured Product"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label",
      "default": "Garden Essentials"
    },
    {
      "type": "text",
      "id": "title_override",
      "label": "Title Override"
    },
    {
      "type": "textarea",
      "id": "description_override",
      "label": "Description Override"
    },
    {
      "type": "text",
      "id": "override_image_url",
      "label": "Image URL Override"
    },
    {
      "type": "text",
      "id": "price_override",
      "label": "Price Override"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Button Label",
      "default": "Shop this product"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary Link Label",
      "default": "See more like this"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary Link URL"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Bullet",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Feature text",
          "default": "Premium quality feature"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Spotlight",
      "settings": {
        "eyebrow": "John Deere Flagship Series",
        "title_override": "John Deere S120 Mower 42 in. 22 HP V-Twin Gas Hydrostatic Riding Lawn Mower",
        "description_override": "Engineered for long-lasting performance and precision turf management. Features a 22 HP V-Twin engine, 42-inch Edge™ cutting deck, hydrostatic transmission, and free residential liftgate freight delivery.",
        "override_image_url": "https://laitm.com/wp-content/uploads/2026/08/ltm-product-89-image-1.png",
        "price_override": "$799.00",
        "cta_label": "Order Now — Free Liftgate",
        "cta_link": "/products/john-deere-s120-mower-42-in-22-hp-v-twin-gas-hydrostatic-riding-lawn-mower",
        "secondary_label": "Explore All Riding Mowers",
        "secondary_link": "/collections/types?q=Riding+Lawn+Mowers"
      },
      "blocks": [
        { "type": "feature", "settings": { "text": "22 HP V-Twin engine with cast-iron cylinder liners" } },
        { "type": "feature", "settings": { "text": "42-in. Edge™ Cutting System for manicured turf" } },
        { "type": "feature", "settings": { "text": "Includes Free Residential Liftgate Freight Delivery" } }
      ]
    }
  ]
}
{% endschema %}
