<div class="contact-page-section section-padding" style="padding: 3.5rem 0; background-color: #FAFAF7;">
  <div class="container" style="max-width: 1000px; margin: 0 auto;">
    <div style="text-align: center; margin-bottom: 3rem;">
      <span style="display: inline-block; font-size: 0.85rem; font-weight: 700; color: #2D6A4F; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.5rem;">
        We Are Here To Help
      </span>
      <h1 style="font-family: var(--font-heading-family, serif); font-size: clamp(2.2rem, 4vw, 3rem); color: #1A1A1A; margin-bottom: 0.75rem;">
        Contact Leafanoo Customer Care
      </h1>
      <p style="font-size: 1.05rem; color: #666; max-width: 600px; margin: 0 auto;">
        Have questions about an order, tracking, or product specifications? Our dedicated support team responds within 12 hours.
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2.5rem; align-items: start;">
      
      <!-- Contact Information Cards -->
      <div style="display: flex; flex-direction: column; gap: 1.25rem;">
        <div style="background: #ffffff; border: 1px solid #E8E8E0; border-radius: 14px; padding: 1.5rem; display: flex; align-items: flex-start; gap: 1rem;">
          <div style="width: 44px; height: 44px; border-radius: 10px; background: #E8F5EE; color: #2D6A4F; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; flex-shrink: 0;">
            ✉️
          </div>
          <div>
            <h3 style="font-size: 1rem; font-weight: 700; margin-bottom: 0.25rem; color: #1A1A1A;">Email Support</h3>
            <p style="font-size: 0.9rem; color: #666; margin-bottom: 0.25rem;">Direct 24/7 inbox monitoring</p>
            <a href="mailto:support@leafanoo.com" style="color: #2D6A4F; font-weight: 600; text-decoration: none;">support@leafanoo.com</a>
          </div>
        </div>

        <div style="background: #ffffff; border: 1px solid #E8E8E0; border-radius: 14px; padding: 1.5rem; display: flex; align-items: flex-start; gap: 1rem;">
          <div style="width: 44px; height: 44px; border-radius: 10px; background: #E8F5EE; color: #2D6A4F; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; flex-shrink: 0;">
            📞
          </div>
          <div>
            <h3 style="font-size: 1rem; font-weight: 700; margin-bottom: 0.25rem; color: #1A1A1A;">Phone Inquiries</h3>
            <p style="font-size: 0.9rem; color: #666; margin-bottom: 0.25rem;">Mon &ndash; Fri: 9:00 AM &ndash; 6:00 PM EST</p>
            <a href="tel:+13202644135" style="color: #2D6A4F; font-weight: 600; text-decoration: none;">+1 (320) 264-4135</a>
          </div>
        </div>

        <div style="background: #ffffff; border: 1px solid #E8E8E0; border-radius: 14px; padding: 1.5rem; display: flex; align-items: flex-start; gap: 1rem;">
          <div style="width: 44px; height: 44px; border-radius: 10px; background: #E8F5EE; color: #2D6A4F; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; flex-shrink: 0;">
            🏢
          </div>
          <div>
            <h3 style="font-size: 1rem; font-weight: 700; margin-bottom: 0.25rem; color: #1A1A1A;">Business Information</h3>
            <p style="font-size: 0.9rem; color: #666; margin: 0; line-height: 1.5;">
              <strong>Company:</strong> balley<br>
              <strong>Store:</strong> Leafanoo<br>
              <strong>Address:</strong> 694 Maple St, Brooklyn, NY 11203, United States
            </p>
          </div>
        </div>
      </div>

      <!-- Contact Form Card -->
      <div style="background: #ffffff; border: 1px solid #E8E8E0; border-radius: 16px; padding: 2rem; box-shadow: 0 4px 16px rgba(0,0,0,0.03);">
        <h2 style="font-family: var(--font-heading-family, serif); font-size: 1.4rem; font-weight: 700; margin-bottom: 1.25rem; color: #1A1A1A;">
          Send Us a Message
        </h2>
        {% form 'contact', class: 'contact-form' %}
          {% if form.posted_successfully? %}
            <div style="background: #E8F5EE; border: 1px solid #52B788; border-radius: 8px; padding: 1rem; color: #1b4332; margin-bottom: 1rem; font-weight: 600;">
              Thank you for reaching out! We have received your message and will respond within 12 hours.
            </div>
          {% endif %}

          <div style="margin-bottom: 1rem;">
            <label for="ContactFormName" style="display: block; font-size: 0.875rem; font-weight: 600; margin-bottom: 0.4rem;">Your Name</label>
            <input type="text" id="ContactFormName" name="contact[name]" class="form-input" placeholder="e.g. Sarah Jenkins" required>
          </div>

          <div style="margin-bottom: 1rem;">
            <label for="ContactFormEmail" style="display: block; font-size: 0.875rem; font-weight: 600; margin-bottom: 0.4rem;">Email Address</label>
            <input type="email" id="ContactFormEmail" name="contact[email]" class="form-input" placeholder="e.g. sarah@example.com" required>
          </div>

          <div style="margin-bottom: 1rem;">
            <label for="ContactFormOrder" style="display: block; font-size: 0.875rem; font-weight: 600; margin-bottom: 0.4rem;">Order Number (Optional)</label>
            <input type="text" id="ContactFormOrder" name="contact[order_number]" class="form-input" placeholder="e.g. #LEAF-1042">
          </div>

          <div style="margin-bottom: 1.5rem;">
            <label for="ContactFormMessage" style="display: block; font-size: 0.875rem; font-weight: 600; margin-bottom: 0.4rem;">How Can We Help?</label>
            <textarea id="ContactFormMessage" name="contact[body]" rows="4" class="form-input" placeholder="Please describe your question or tracking inquiry..." required></textarea>
          </div>

          <button type="submit" class="btn btn--primary" style="width: 100%; padding: 14px; font-weight: 700; font-size: 1rem; border-radius: 8px;">
            Send Message &rarr;
          </button>
        {% endform %}
      </div>

    </div>
  </div>
</div>