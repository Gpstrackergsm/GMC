<span id="shopify-section-faq-accordion" style="display: block; position: relative; top: -100px; visibility: hidden; pointer-events: none;"></span>
<span id="faq" style="display: block; position: relative; top: -100px; visibility: hidden; pointer-events: none;"></span>
<span id="faqs" style="display: block; position: relative; top: -100px; visibility: hidden; pointer-events: none;"></span>

<div class="faq-section section-padding" style="padding: 3.5rem 0; background-color: {{ section.settings.bg_color | default: '#faf6ee' }};">
  <div class="container" style="max-width: 840px; margin: 0 auto; padding: 0 1.25rem;">
    {%- if section.settings.heading != blank -%}
      <div class="section-header text-center" style="margin-bottom: 2.5rem; text-align: center;">
        <span style="display: inline-block; font-size: 0.8rem; font-weight: 700; color: #16a34a; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.5rem;">
          Help & Support
        </span>
        <h2 style="font-family: var(--font-heading-family, serif); font-size: clamp(1.85rem, 3vw, 2.5rem); font-weight: 700; color: var(--color-text, #1A1A1A); margin: 0;">
          {{ section.settings.heading }}
        </h2>
        {%- if section.settings.subheading != blank -%}
          <p style="color: #666; font-size: 1rem; margin-top: 0.65rem;">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="faq-accordion-list" style="display: flex; flex-direction: column; gap: 0.85rem;">
      {%- for block in section.blocks -%}
        <details class="faq-item" {{ block.shopify_attributes }} style="background: #ffffff; border: 1px solid #E8E8E0; border-radius: 10px; overflow: hidden; padding: 1.25rem 1.5rem; transition: border-color 0.2s, box-shadow 0.2s;">
          <summary style="font-weight: 600; font-size: 1.05rem; cursor: pointer; display: flex; justify-content: space-between; align-items: center; color: #1A1A1A; list-style: none;">
            <span>{{ block.settings.question }}</span>
            <span class="faq-icon" style="color: #16a34a; font-size: 1.5rem; font-weight: 400; line-height: 1; margin-left: 1rem; transition: transform 0.25s ease;">+</span>
          </summary>
          <div class="faq-answer rte" style="margin-top: 1rem; font-size: 0.95rem; line-height: 1.7; color: #4A4A4A; border-top: 1px solid #F0F0EB; padding-top: 0.85rem;">
            {{ block.settings.answer }}
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item[open] {
    border-color: #16a34a !important;
    box-shadow: 0 4px 16px rgba(22, 163, 74, 0.08);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }
</style>

<script>
  (function() {
    function scrollToFaq() {
      var target = document.getElementById('shopify-section-faq-accordion') || document.getElementById('faq');
      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    if (window.location.hash === '#shopify-section-faq-accordion' || window.location.hash === '#faq' || window.location.hash === '#faqs') {
      setTimeout(scrollToFaq, 150);
    }

    document.addEventListener('click', function(e) {
      var link = e.target.closest('a[href*="#shopify-section-faq-accordion"], a[href*="#faq"]');
      if (link && (window.location.pathname === '/' || window.location.pathname === '')) {
        e.preventDefault();
        history.pushState(null, '', '#shopify-section-faq-accordion');
        scrollToFaq();
      }
    });
  })();
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
      {
        "@type": "Question",
        "name": {{ block.settings.question | json }},
        "acceptedAnswer": {
          "@type": "Answer",
          "text": {{ block.settings.answer | strip_html | json }}
        }
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>

{% schema %}
{
  "name": "FAQ Accordion",
  "tag": "section",
  "class": "section-faq",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Everything you need to know about our products, shipping, and returns."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How long does standard shipping take?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Orders are dispatched within 1-2 business days. Standard delivery typically takes 3-7 business days depending on your destination. Tracking is provided as soon as your order is dispatched.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Accordion",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "What is your return policy?",
            "answer": "<p>We offer a 30-day return window for items in their original, unopened condition. Please visit our Returns policy page or contact our team to initiate a return.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Are all products backed by verifiable specifications?",
            "answer": "<p>Yes. Every product in the Leafanoo catalog includes authentic specifications, dimensions, and materials verified directly against manufacturer documentation.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How do I track my order?",
            "answer": "<p>Once your order has shipped, you will receive an email confirmation containing your carrier tracking number and a direct tracking link.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What payment methods are supported?",
            "answer": "<p>We accept all major credit and debit cards (Visa, Mastercard, American Express), PayPal, Apple Pay, and Google Pay through our encrypted 256-bit SSL checkout.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
